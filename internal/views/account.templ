package views

import (
	"fmt"

	"pco-assistant/internal/views/components"
)

// Account is the one persistent page for account/organization identity,
// billing (BillingBody, same markup /billing itself renders - see
// billing.templ), and local-cache maintenance - see layout.templ's
// accountMenuContent doc comment for why this replaced /billing as the
// nav link.
templ Account(personName, organizationName string, data AccountData) {
	@Layout("Account", personName, organizationName) {
		<h1>Account</h1>
		<!--
			Identity and Billing are both "who/what is this account" info, so
			they lay out side by side on a wide viewport (.card-columns,
			card.css) instead of each getting its own full-width stack -
			stacks back to one column on mobile automatically. Identity is a
			plain heading + content div, matching Billing's own shape, rather
			than a components.Card - BillingBody already renders its own
			Card(s) internally (the current-plan card, or the Standard/
			Multi-Campus choice cards), so wrapping it in another outer Card
			would nest a card inside a card; making Identity match that plain
			shape instead keeps the pair visually consistent.
		-->
		<div class="card-columns">
			<div>
				<h2>Identity</h2>
				<p class="muted">Signed in as { personName }.</p>
				<p class="muted">Organization: { organizationName }.</p>
				if data.OrganizationID != "" {
					<p class="muted">Planning Center organization id: { data.OrganizationID }.</p>
				}
			</div>
			<div>
				<h2>Billing</h2>
				@BillingBody(data.Billing)
			</div>
		</div>
		<h2>Getting started</h2>
		<p class="muted">A short walkthrough of what Resonance does and why - worth another look after joining an existing org, or any time as a refresher. The setup checklist itself always lives on the home page.</p>
		<p class="muted">Look for <strong>Help</strong> at the bottom of any page for a quick tour of what's there.</p>
		<h2>Data &amp; Caches</h2>
		@AccountCacheBody(data)
		@AccountInstallBody()
		<h2>Who's signed in</h2>
		@AccountSessionsBody(data)
	}
}

// AccountCacheBody is both the initial-render fragment and the htmx swap
// target (id="account-cache-body") for the two cache-clear actions below.
//
// Both actions are deliberately NOT styled "danger" (see publish_panel.templ
// for what that class is reserved for - a genuinely irreversible action
// like Discard): clearing one of these caches touches nothing in Planning
// Center and no draft set/roster - it only deletes this app's own local
// copy of PCO data, which gets transparently re-collected the next time
// it's needed. Framed here, and in each confirm prompt, as "unmistakably
// not destructive" per the page's actual intent.
templ AccountCacheBody(data AccountData) {
	<div id="account-cache-body">
		<p class="muted">
			These only clear data this app has cached locally from Planning
			Center - they don't touch Planning Center itself, or any draft set
			or roster. Whatever gets cleared here is just removed from local
			storage; it's automatically re-collected from Planning Center the
			next time it's actually needed.
		</p>
		<!-- Same reasoning as Account's Identity/Billing pairing above - both
			 cards are "cached local copy of PCO data," so side by side on a
			 wide viewport (.card-columns, card.css) reads better than a full
			 stack. -->
		<div class="card-columns">
			@components.Card("Song info cache") {
				if data.SongInfoCacheErr != "" {
					<p class="error" role="alert">{ data.SongInfoCacheErr }</p>
				}
				if data.SongInfoCacheMsg != "" {
					<p class="success">{ data.SongInfoCacheMsg }</p>
				}
				<p class="muted">
					Clears every song's cached key, tempo, meter, and length info.
					Not destructive - it's just removing some data we have sitting
					on top so it can be re-collected from PCO automatically, in the
					background, as sets get built.
				</p>
				<form
					hx-post="/account/cache/song-info"
					hx-target="#account-cache-body"
					hx-swap="outerHTML"
					hx-confirm="This only clears this app's local cache of song key/tempo/meter/length info - it does not touch Planning Center or any real scheduling data. Everything gets automatically re-collected from Planning Center the next time it's needed. Continue?"
				>
					<button type="submit">Clear song info cache</button>
				</form>
			}
			@components.Card("Person data cache") {
				if data.PersonDataCacheErr != "" {
					<p class="error" role="alert">{ data.PersonDataCacheErr }</p>
				}
				if data.PersonDataCacheMsg != "" {
					<p class="success">{ data.PersonDataCacheMsg }</p>
				}
				<p class="muted">
					Clears every person's cached blockout and assignment-history
					info used for scheduling warnings on the Team roster. Not
					destructive - it's just removing some data we have sitting on
					top so it can be re-collected from PCO the next time it's
					needed.
				</p>
				<form
					hx-post="/account/cache/person-data"
					hx-target="#account-cache-body"
					hx-swap="outerHTML"
					hx-confirm="This only clears this app's local cache of per-person blockout/assignment-history info - it does not touch Planning Center or any real scheduling data. Everything gets automatically re-collected from Planning Center the next time it's needed. Continue?"
				>
					<button type="submit">Clear person data cache</button>
				</form>
			}
		</div>
	</div>
}

// AccountInstallBody is the persistent, findable "install this app" home
// (see docs/plans/shipped/pwa-install-improvements-plan.md's "Placement
// and trigger" section) - the deliberate settings-page counterpart to
// layout.templ's transient, dismissible installPromptBanner: someone who
// dismissed that banner, or who just wants to install on purpose, always
// has a stable place to come do it, same reasoning as why the cache-clear
// actions above live on this page rather than a transient prompt.
//
// Server-rendered as a static shell - the explanatory text and Card title
// always render, so a JS-disabled visitor still sees something here
// rather than an empty section; the button and iOS instructional copy
// inside start hidden and install-prompt.js (installPromptRefreshUI)
// reveals exactly one of them, or hides the whole #account-install-section
// wrapper entirely when neither install path applies (unsupported
// browser, or already installed - navigator.standalone/display-mode:
// standalone). The "Install this app" heading lives *inside* that same
// wrapper (not above it, in Account) specifically so it hides in lockstep
// with the rest of the section - it used to sit outside and render
// orphaned, on its own, once already installed.
templ AccountInstallBody() {
	<div id="account-install-section">
		<h2>Install this app</h2>
		@components.Card("Add Resonance to your home screen") {
			<p class="muted">
				Installing Resonance puts it in its own window on your home
				screen or dock - a quicker way back in than digging up a browser
				tab, especially handy alongside Planning Center itself.
			</p>
			<button type="button" id="account-install-button" class="button primary" onclick="handleInstallPromptClick('account')" hidden>
				Install app
			</button>
			<p id="account-install-ios-copy" class="muted" hidden>
				@components.IconShare()
				On iPhone or iPad: tap the <strong>Share</strong> icon in Safari, then <strong>"Add to Home Screen."</strong>
			</p>
		}
	</div>
}

// AccountSessionsBody is both the initial-render fragment and the htmx
// swap target (id="account-sessions-body") for the "who's signed in" list
// and its per-row sign-out action - same shape as AccountCacheBody above.
// Each row posts its own sess.SessionID, not PersonID, so signing out one
// of a person's two devices doesn't also end the other (see
// AccountSession's doc comment and AccountController.SignOutSession for
// the bug this fixes).
//
// Not "danger"-styled (see publish_panel.templ for what that class is
// reserved for - a genuinely irreversible action like Discard): signing
// someone out is reversible, they can just sign back in with Planning
// Center if they still have access. Same "not destructive" framing tier
// as AccountCacheBody's two actions, just still worth an hx-confirm since
// it does interrupt someone's live session.
templ AccountSessionsBody(data AccountData) {
	<div id="account-sessions-body">
		if data.SessionsErr != "" {
			<p class="error" role="alert">{ data.SessionsErr }</p>
		}
		if data.SignOutErr != "" {
			<p class="error" role="alert">{ data.SignOutErr }</p>
		}
		if data.SignOutMsg != "" {
			<p class="success">{ data.SignOutMsg }</p>
		}
		@components.Card("Currently signed in") {
			<p class="muted">
				Everyone signed in counts as a billed seat until their session
				either expires on its own (30 days after they last signed in) or
				you sign them out here - useful right away when someone leaves
				staff and you don't want to wait out the 30 days for their seat
				to free up.
			</p>
			if len(data.Sessions) == 0 {
				<p class="muted">Nobody is currently signed in.</p>
			} else {
				@components.SortableTableWrap() {
					<thead>
						<tr>
							<th>Person</th>
							<th>Signed in</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, sess := range data.Sessions {
							<tr>
								<td>{ sess.PersonName }</td>
								<td>{ sess.CreatedAt.Format("Jan 2, 2006 3:04 PM") }</td>
								<td>
									<form
										hx-post={ fmt.Sprintf("/account/sessions/%s/sign-out", sess.SessionID) }
										hx-target="#account-sessions-body"
										hx-swap="outerHTML"
										hx-confirm={ fmt.Sprintf("This immediately ends %s's session on this device - they'll need to sign in with Planning Center again to come back on it. Any other device they're signed in on is unaffected. Continue?", sess.PersonName) }
									>
										<button type="submit">Sign out</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	</div>
}
