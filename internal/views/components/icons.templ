package components

// Small inline SVG icons, stroked/filled with currentColor so they follow
// whatever color the surrounding button/text already has - no separate
// theme handling needed. Kept here as reusable components since they're
// used across several pages (set builder row actions, sortable table
// headers, the theme toggle, admin table delete buttons).

templ IconAdd() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<line x1="12" y1="5" x2="12" y2="19"></line>
		<line x1="5" y1="12" x2="19" y2="12"></line>
	</svg>
}

templ IconRemove() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="3 6 5 6 21 6"></polyline>
		<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
		<path d="M10 11v6"></path>
		<path d="M14 11v6"></path>
		<path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
	</svg>
}

templ IconEdit() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M12 20h9"></path>
		<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
	</svg>
}

// IconCopy marks the "duplicate this song" action (e.g. reprising it as
// the response song).
templ IconCopy() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="9" y="9" width="13" height="13" rx="2"></rect>
		<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
	</svg>
}

// IconDrag is the grip handle used on draggable order-of-service rows.
templ IconDrag() {
	<svg class="icon icon-drag" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
		<circle cx="9" cy="6" r="1.5"></circle>
		<circle cx="15" cy="6" r="1.5"></circle>
		<circle cx="9" cy="12" r="1.5"></circle>
		<circle cx="15" cy="12" r="1.5"></circle>
		<circle cx="9" cy="18" r="1.5"></circle>
		<circle cx="15" cy="18" r="1.5"></circle>
	</svg>
}

templ IconSun() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
	</svg>
}

templ IconMoon() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
	</svg>
}

// IconChevronDown marks the nav's "Setup" dropdown toggle.
templ IconChevronDown() {
	<svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="6 9 12 15 18 9"></polyline>
	</svg>
}

// IconChevronLeft/IconChevronRight mark the Build page's Previous/Next
// plan stepper (build.templ) - a paired prev/next control, distinct from
// IconChevronDown's single dropdown-toggle use.
templ IconChevronLeft() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="15 18 9 12 15 6"></polyline>
	</svg>
}

templ IconChevronRight() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="9 18 15 12 9 6"></polyline>
	</svg>
}

// IconAlertTriangle marks the site-wide early-preview banner (layout.templ).
templ IconAlertTriangle() {
	<svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path>
		<line x1="12" y1="9" x2="12" y2="13"></line>
		<line x1="12" y1="17" x2="12.01" y2="17"></line>
	</svg>
}

// IconX marks a dismiss/close button - the early-preview banner
// (layout.templ) is the first user, but it's generic enough to reuse
// anywhere else a "close this" control needs an icon.
templ IconX() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<line x1="18" y1="6" x2="6" y2="18"></line>
		<line x1="6" y1="6" x2="18" y2="18"></line>
	</svg>
}

// IconMore marks a row-scoped "more actions" menu toggle (the set
// builder's per-song row menu - see openQuickAction in scheduling.js) - a
// vertical 3-dot kebab, same filled-circle style as IconDrag rather than a
// stroked one, so it doesn't read as a drag handle at a glance.
templ IconMore() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
		<circle cx="12" cy="5" r="1.5"></circle>
		<circle cx="12" cy="12" r="1.5"></circle>
		<circle cx="12" cy="19" r="1.5"></circle>
	</svg>
}

// IconTag marks the "tag this song" row-menu action.
templ IconTag() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"></path>
		<line x1="7" y1="7" x2="7.01" y2="7"></line>
	</svg>
}

// IconRelate marks the "relate to another song" row-menu action.
templ IconRelate() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M9 17H7A5 5 0 0 1 7 7h2"></path>
		<path d="M15 7h2a5 5 0 1 1 0 10h-2"></path>
		<line x1="8" y1="12" x2="16" y2="12"></line>
	</svg>
}

// IconReplace marks the "replace this song" row action - two curved
// arrows forming a loop, distinct from IconEdit's pencil (which reads
// almost universally as "edit," not "swap this out for something else").
templ IconReplace() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="23 4 23 10 17 10"></polyline>
		<polyline points="1 20 1 14 7 14"></polyline>
		<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
	</svg>
}

// IconRole marks the "mark a role" row-menu action.
templ IconRole() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="8" r="6"></circle>
		<path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"></path>
	</svg>
}

// IconArchive marks the "archive this song" action.
templ IconArchive() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<polyline points="21 8 21 21 3 21 3 8"></polyline>
		<rect x="1" y="3" width="22" height="5"></rect>
		<line x1="10" y1="12" x2="14" y2="12"></line>
	</svg>
}
