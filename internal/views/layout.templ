package views

import "pco-assistant/internal/views/components"

// designSystemCSSFiles is loaded after tokens.css/base.css (see Head
// below) - components/*.css first (each one backing a specific reusable
// templ component or CSS-only utility group, see that directory's own
// files for which), then the page-specific files that used to all live in
// one app.css (each backing exactly one page/feature, not shared).
// landing.css and run-sheet.css aren't here - they're loaded only by the
// one page each that needs them (landing.templ, run_sheet.templ), not
// every page via Head. Adding a new CSS file for a new component/page
// only needs an entry here, not a second edit anywhere else.
var designSystemCSSFiles = []string{
	// components/ - reusable, each backing a specific templ component or
	// a pure-CSS utility group with no templ component of its own.
	"components/forms.css",
	"components/buttons.css",
	"components/icons.css",
	"components/badge.css",
	"components/avatar.css",
	"components/alert.css",
	"components/import-banner.css",
	"components/table.css",
	"components/list-item.css",
	"components/card.css",
	"components/publish-panel.css",
	"components/status-summary.css",
	"components/collapsible.css",
	"components/disclosure.css",
	"components/quick-action.css",
	"components/build-tabs.css",
	"components/build-detail-card.css",
	"components/search.css",
	// Page-specific - each backing exactly one page/feature.
	"htmx-progress.css",
	"header-nav.css",
	"site-banner.css",
	"build-page.css",
	"builder-rows.css",
	"home.css",
	"sign-in.css",
	"song-contexts.css",
	"song-roles.css",
	"song-tags.css",
	"song-vocal-range.css",
	"style-guide.css",
	"vocal-range-matrix.css",
}

// schedulingJSFiles is loaded after htmx.min.js (see Head below) - the
// former single scheduling.js (2,611 lines) split into one file per
// concern, the same per-concern split designSystemCSSFiles already uses
// for CSS above. Every function/listener across these files is still
// plain global scope (no modules/bundler - see CLAUDE.md's web/static
// bullet), so load order among them doesn't matter functionally; this
// just keeps the original file's own section order for readability. A new
// scheduling*.js file must be added here to actually load, same "adding
// the file alone isn't enough" trap designSystemCSSFiles' own doc comment
// warns about for CSS.
var schedulingJSFiles = []string{
	"scheduling-global.js",
	"scheduling-build.js",
	"scheduling-setup-forms.js",
	"scheduling-song-tags-contexts.js",
	"scheduling-collapsible.js",
	"scheduling-sortable-table.js",
	"scheduling-vocal-range.js",
}

// Head is the <head> every page shares - the authenticated app shell
// (Layout, below) and the public Landing page alike - so cache-busted
// asset links, the favicon/manifest, and font preconnects live in exactly
// one place. Landing adds its own extra stylesheet link after this rather
// than needing a second near-duplicate <head>.
templ Head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - Resonance</title>
		<link rel="manifest" href="/manifest.json"/>
		<!--
			Cache-busted like every other static asset below, unlike before -
			favicons are cached unusually aggressively by browsers, so
			swapping the icon file in place without this could leave a
			visitor's already-cached old icon showing indefinitely.
		-->
		<link rel="icon" href={ "/static/icon-192.png?v=" + AssetVersion }/>
		<link rel="apple-touch-icon" href={ "/static/icon-192.png?v=" + AssetVersion }/>
		<meta name="theme-color" content="#2b7770"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href={ "/static/css/tokens.css?v=" + AssetVersion }/>
		<link rel="stylesheet" href={ "/static/css/base.css?v=" + AssetVersion }/>
		for _, f := range designSystemCSSFiles {
			<link rel="stylesheet" href={ "/static/css/" + f + "?v=" + AssetVersion }/>
		}
		<script src={ "/static/js/htmx.min.js?v=" + AssetVersion }></script>
		for _, f := range schedulingJSFiles {
			<script src={ "/static/js/" + f + "?v=" + AssetVersion }></script>
		}
		<script src={ "/static/js/register-sw.js?v=" + AssetVersion }></script>
		<script src={ "/static/js/install-prompt.js?v=" + AssetVersion }></script>
		{ children... }
	</head>
}

templ Layout(title string, personName string, organizationName string) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(title)
		<body>
			<!--
				Bypass Blocks (2.4.1, Finding 3 -
				docs/plans/shipped/wcag-aa-audit-plan.md) - every page's header
				(brand link, mobile menu toggle, Home/Build/Setup nav, account
				dropdown) sits ahead of <main> in tab order, so without this a
				keyboard user re-tabs through all of it on every single page
				navigation. Visually hidden until focused (.skip-link,
				base.css) - the standard skip-link pattern - and #main-content
				on <main> below is its target.
			-->
			<a href="#main-content" class="skip-link">Skip to content</a>
			<div id="htmx-progress-bar" aria-hidden="true"></div>
			<header class="site">
				<div class="site-primary">
					<a href="/" class="site-brand"><strong>Resonance</strong></a>
					<!--
						Below header.site's own row/column breakpoint, this is the
						only other thing in the visible bar - everything else
						(site-nav, site-actions) collapses behind it (see
						toggleMobileMenu, scheduling-global.js) rather than wrapping into
						several busy rows. Hidden entirely at that breakpoint, where
						site-nav/site-actions are just always visible again.
					-->
					<button
						type="button"
						class="mobile-menu-toggle"
						onclick="toggleMobileMenu(this)"
						aria-haspopup="true"
						aria-expanded="false"
						aria-label="Menu"
					>
						<span class="hamburger-bar"></span>
					</button>
					<nav class="site-nav">
						<a href="/">Home</a>
						<a href="/scheduling/build">Build a Service</a>
						@components.Disclosure("nav-dropdown", "nav-dropdown-toggle", "toggleNavDropdown(this)", "", "", navToggleContent(), navMenuContent())
					</nav>
				</div>
				<div class="site-actions">
					if personName != "" {
						<!--
							One dropdown instead of four loose items (theme toggle,
							Account link, org+person name, logout form) - see
							docs/plans/shipped/help-system-and-nav-consolidation-plan.md
							for why this consolidation happened alongside the new
							footer Help button. Reuses the exact same "nav-dropdown"
							mechanism as the "Setup" dropdown above (toggleNavDropdown,
							positionNavDropdown, closeNavDropdowns, the document-level
							outside-click/Escape handlers - all in scheduling-global.js) rather
							than inventing a second one: every one of those already
							operates on every ".nav-dropdown*" element on the page, not
							a single hardcoded instance, so a second dropdown sharing
							the same classes gets positioning/outside-click-close/mobile
							behavior for free. The two dropdowns never fight over state -
							each tracks its own "open" class independently, scoped by
							.closest(".nav-dropdown") - and clicking one closes the
							other via the same "anything outside .nav-dropdown closes
							every open one" handler that already existed for the single
							Setup dropdown.
						-->
						@components.Disclosure("nav-dropdown", "nav-dropdown-toggle", "toggleNavDropdown(this)", "", "", accountToggleContent(personName), accountMenuContent(organizationName))
					}
				</div>
			</header>
			<div class="site-banner" role="note">
				<div class="site-banner-content">
					@components.IconAlertTriangle()
					<span><strong>Early preview:</strong> this app is still in active development. Data can be wiped or reset without notice - use at your own risk, and don't rely on it as your only copy of anything.</span>
				</div>
				<button type="button" class="site-banner-dismiss" onclick="dismissSiteBanner()" aria-label="Dismiss this notice" title="Dismiss this notice">
					@components.IconX()
				</button>
			</div>
			<main id="main-content">
				@installPromptBanner()
				{ children... }
			</main>
			if personName != "" {
				<footer class="site-footer">
					<a href="/feedback">Feedback</a>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
					<button type="button" class="button" onclick="openPageHelp()">Help</button>
				</footer>
			}
			@genericHelpDialog()
		</body>
	</html>
}

// accountToggleContent/accountMenuContent are the header's account
// Disclosure's toggle-button content and popup contents (see the
// site-actions doc comment above for why this reuses the "Setup" nav
// dropdown's own mechanism rather than a new one). Mirrors
// navToggleContent/navMenuContent's split below in shape, just for a
// different Disclosure instance.
templ accountToggleContent(personName string) {
	{ personName }
	@components.IconChevronDown()
}

// accountMenuContent is the account dropdown's popup: the theme toggle
// (moved here unchanged from its old spot directly in .site-actions), the
// org name (when known), the one persistent path to /account - without
// it, an actively-paying org (home.templ's trial banner only shows while
// OrgStatus isn't "active") has no way back to plan/seat info or the
// Stripe portal short of typing the URL; /account embeds the same billing
// section /billing itself renders (views.BillingBody) alongside identity
// info and the Data & Caches tools - and finally the logout form.
// Feedback used to live in this same row and moved to the new site
// footer instead (see genericHelpDialog's own doc comment and
// docs/plans/shipped/help-system-and-nav-consolidation-plan.md) - it's
// no longer here.
templ accountMenuContent(organizationName string) {
	<button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Switch between light and dark theme" title="Switch between light and dark theme">
		@components.IconSun()
		@components.IconMoon()
	</button>
	if organizationName != "" {
		<span class="account-org">{ organizationName }</span>
	}
	<a href="/account">Account</a>
	<!--
		Switch account - prompt=select_account (AuthorizeURL,
		internal/auth/pco_oauth.go) asks PCO to show its own account
		picker rather than silently re-approving whatever PCO session
		cookie the browser already carries, so this works from an
		already-signed-in state without needing Log out first (see
		docs/plans/shipped/pco-account-switching-plan.md). A plain
		link straight to Start, right next to Log out, rather than
		relying on someone knowing to click "Sign in" while already
		signed in - the exact confusing dead end that plan was written
		to fix.
	-->
	<a href="/auth/pco/start">Switch account</a>
	<form method="post" action="/auth/logout">
		<button type="submit">Log out</button>
	</form>
}

// navToggleContent/navMenuContent are the nav's "Setup" Disclosure's
// toggle-button content and popup contents.
templ navToggleContent() {
	Setup
	@components.IconChevronDown()
}

templ navMenuContent() {
	<a href="/scheduling/song-relationships">Song Relationships</a>
	<a href="/scheduling/song-roles">Song Roles</a>
	<a href="/scheduling/song-contexts">Song Contexts</a>
	<!--
		The former separate "Song Tag Suggestions" link (a standalone
		page) is gone - see
		docs/plans/shipped/song-tags-suggestions-merge-plan.md - its
		suggestions now live in a dismissible panel on this same Song
		Tags page. The badge preserves the old link's "something's
		pending" ambient nudge (middleware.PopulateNavState/
		nav_state.go): an actionable inbox item that's actually empty
		is clutter, not configuration to revisit, and it reappears on
		its own the moment a new song creates a suggestion. No
		existing per-nav-link badge precedent to match (components.
		Badge isn't otherwise used inside navMenuContent), and
		PopulateNavState only ever tracks a pending bool, not a count
		(deliberately unchanged by this merge - see that doc), so this
		is a plain indicator rather than a real "(N)" count.
	-->
	<a href="/scheduling/song-tags">
		Song Tags
		if navSuggestionsPending(ctx) {
			@components.Badge("status-pending", "New")
		}
	</a>
	<a href="/scheduling/song-preferences">Song / Person Preferences</a>
	<a href="/scheduling/person-relationships">Person Relationships</a>
	<a href="/scheduling/position-preferences">Position Preferences</a>
	<a href="/scheduling/vocal-range">Vocal Range</a>
	<a href="/scheduling/song-vocal-range">Song Vocal Range</a>
}

// genericHelpDialog is the Help button's (site-footer, above) last-resort
// fallback - see scheduling-global.js's openPageHelp doc comment for the full
// dispatch order. Rendered unconditionally in Layout itself (not gated on
// personName, unlike the footer's Help button that's the only thing that
// can open it) so it always exists regardless of which page's own
// {children...} rendered - the same "exists on every page, findable by
// id" reasoning as installPromptBanner below, just never auto-shown.
// Opens/closes via openHelpDialog/closeHelpDialog (scheduling-global.js), the
// same minimal stateless pair backing the 8 new setup-page dialogs -
// there's exactly one step here too, so createTourController's
// auto-open/localStorage/query-param machinery (built for the Home/Build
// tours' very different auto-popping requirements) would be overkill for
// this, same reasoning as those 8.
templ genericHelpDialog() {
	<dialog id="generic-help-dialog" class="tour-dialog">
		<div class="tour-step">
			<h2>Need a hand?</h2>
			<p>
				This page doesn't have its own guided tour yet. Your <a href="/account">Account</a> page has billing, cached-data tools, and who's signed in - or send us a note from <a href="/feedback">Feedback</a> when something's confusing or broken.
			</p>
		</div>
		<div class="tour-actions">
			<button type="button" class="button primary" onclick="closeHelpDialog('generic-help-dialog')">Done</button>
		</div>
	</dialog>
}

// installPromptBanner is the dismissible "install this app" nudge (see
// docs/plans/shipped/pwa-install-improvements-plan.md section 3) - shown
// on top of every authenticated page's main content, not a full-width
// site-chrome strip like the early-preview banner above, so it flows
// inside each page's own content width instead of edge to edge.
//
// Reuses .import-banner's "invitation, not an alert" tinted styling
// (components/import-banner.css) rather than components.ImportBanner
// itself: that component's built-in dismiss button only removes the DOM
// node, but this dismissal needs to persist to localStorage too (see
// install-prompt.js's dismissInstallBanner) so the banner doesn't just
// reappear on the very next page load.
//
// The whole banner starts hidden (this is the transient nudge, not the
// findable settings-page home - see account.templ's AccountInstallBody
// for that one) - install-prompt.js only reveals it once both an install
// path is actually available (Chromium beforeinstallprompt fired, or iOS
// Safari not yet standalone) and the day-count/dismissal gate passes, and
// in that same pass picks exactly one of the button/instructional-copy
// pair below to reveal - see that file's installPromptRefreshUI.
templ installPromptBanner() {
	<div id="install-prompt-banner" class="import-banner" hidden>
		<p>
			Install Resonance as an app for quicker access alongside Planning
			Center.
			<button type="button" class="icon-btn" aria-label="Dismiss" title="Dismiss this notice" onclick="dismissInstallBanner()">
				@components.IconX()
			</button>
		</p>
		<button type="button" id="install-banner-button" class="button primary" onclick="handleInstallPromptClick('banner')">
			Install app
		</button>
		<p id="install-banner-ios-copy" class="muted">
			@components.IconShare()
			On iPhone or iPad: tap the <strong>Share</strong> icon in Safari, then <strong>"Add to Home Screen."</strong>
		</p>
	</div>
}
