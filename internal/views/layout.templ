package views

import "pco-assistant/internal/views/components"

// designSystemCSSFiles is loaded after tokens.css/base.css (see Head
// below) - components/*.css first (each one backing a specific reusable
// templ component or CSS-only utility group, see that directory's own
// files for which), then the page-specific files that used to all live in
// one app.css (each backing exactly one page/feature, not shared).
// landing.css and run-sheet.css aren't here - they're loaded only by the
// one page each that needs them (landing.templ, run_sheet.templ), not
// every page via Head. Adding a new CSS file for a new component/page
// only needs an entry here, not a second edit anywhere else.
var designSystemCSSFiles = []string{
	// components/ - reusable, each backing a specific templ component or
	// a pure-CSS utility group with no templ component of its own.
	"components/forms.css",
	"components/buttons.css",
	"components/icons.css",
	"components/badge.css",
	"components/alert.css",
	"components/import-banner.css",
	"components/table.css",
	"components/list-item.css",
	"components/card.css",
	"components/publish-panel.css",
	"components/status-summary.css",
	"components/collapsible.css",
	"components/disclosure.css",
	"components/quick-action.css",
	"components/build-tabs.css",
	"components/build-detail-card.css",
	"components/search.css",
	// Page-specific - each backing exactly one page/feature.
	"htmx-progress.css",
	"header-nav.css",
	"site-banner.css",
	"build-page.css",
	"builder-rows.css",
	"home.css",
	"sign-in.css",
	"style-guide.css",
}

// Head is the <head> every page shares - the authenticated app shell
// (Layout, below) and the public Landing page alike - so cache-busted
// asset links, the favicon/manifest, and font preconnects live in exactly
// one place. Landing adds its own extra stylesheet link after this rather
// than needing a second near-duplicate <head>.
templ Head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - Resonance</title>
		<link rel="manifest" href="/manifest.json"/>
		<!--
			Cache-busted like every other static asset below, unlike before -
			favicons are cached unusually aggressively by browsers, so
			swapping the icon file in place without this could leave a
			visitor's already-cached old icon showing indefinitely.
		-->
		<link rel="icon" href={ "/static/icon-192.png?v=" + AssetVersion }/>
		<link rel="apple-touch-icon" href={ "/static/icon-192.png?v=" + AssetVersion }/>
		<meta name="theme-color" content="#2b7770"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href={ "/static/css/tokens.css?v=" + AssetVersion }/>
		<link rel="stylesheet" href={ "/static/css/base.css?v=" + AssetVersion }/>
		for _, f := range designSystemCSSFiles {
			<link rel="stylesheet" href={ "/static/css/" + f + "?v=" + AssetVersion }/>
		}
		<script src={ "/static/js/htmx.min.js?v=" + AssetVersion }></script>
		<script src={ "/static/js/scheduling.js?v=" + AssetVersion }></script>
		<script src={ "/static/js/register-sw.js?v=" + AssetVersion }></script>
		{ children... }
	</head>
}

templ Layout(title string, personName string, organizationName string) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(title)
		<body>
			<div id="htmx-progress-bar" aria-hidden="true"></div>
			<header class="site">
				<div class="site-primary">
					<a href="/" class="site-brand"><strong>Resonance</strong></a>
					<!--
						Below header.site's own row/column breakpoint, this is the
						only other thing in the visible bar - everything else
						(site-nav, site-actions) collapses behind it (see
						toggleMobileMenu, scheduling.js) rather than wrapping into
						several busy rows. Hidden entirely at that breakpoint, where
						site-nav/site-actions are just always visible again.
					-->
					<button
						type="button"
						class="mobile-menu-toggle"
						onclick="toggleMobileMenu(this)"
						aria-haspopup="true"
						aria-expanded="false"
						aria-label="Menu"
					>
						<span class="hamburger-bar"></span>
					</button>
					<nav class="site-nav">
						<a href="/">Home</a>
						<a href="/scheduling/build">Build a Service</a>
						@components.Disclosure("nav-dropdown", "nav-dropdown-toggle", "toggleNavDropdown(this)", "", "", navToggleContent(), navMenuContent())
					</nav>
				</div>
				<div class="site-actions">
					<button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Switch between light and dark theme" title="Switch between light and dark theme">
						@components.IconSun()
						@components.IconMoon()
					</button>
					if personName != "" {
						<!--
							The one persistent path to /account - without it, an
							actively-paying org (home.templ's trial banner only shows
							while OrgStatus isn't "active") has no way back to plan/
							seat info or the Stripe portal short of typing the URL.
							/account embeds the same billing section /billing itself
							renders (views.BillingBody) alongside identity info and
							the Data & Caches tools - /billing's own routes/page still
							work directly, just aren't linked from here anymore.
						-->
						<a href="/account">Account</a>
						<a href="/feedback">Feedback</a>
						<div class="account">
							if organizationName != "" {
								<span class="account-org">{ organizationName }</span>
							}
							<span class="account-person">{ personName }</span>
						</div>
						<form method="post" action="/auth/logout">
							<button type="submit">Log out</button>
						</form>
					}
				</div>
			</header>
			<div class="site-banner" role="note">
				<div class="site-banner-content">
					@components.IconAlertTriangle()
					<span><strong>Early preview:</strong> this app is still in active development. Data can be wiped or reset without notice - use at your own risk, and don't rely on it as your only copy of anything.</span>
				</div>
				<button type="button" class="site-banner-dismiss" onclick="dismissSiteBanner()" aria-label="Dismiss this notice" title="Dismiss this notice">
					@components.IconX()
				</button>
			</div>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// navToggleContent/navMenuContent are the nav's "Setup" Disclosure's
// toggle-button content and popup contents.
templ navToggleContent() {
	Setup
	@components.IconChevronDown()
}

templ navMenuContent() {
	<a href="/scheduling/song-relationships">Song Relationships</a>
	<a href="/scheduling/song-roles">Song Roles</a>
	<a href="/scheduling/song-tags">Song Tags</a>
	<!--
		Hidden once there's nothing pending there (see
		middleware.PopulateNavState/nav_state.go) - an "actionable
		inbox" item that's actually empty is clutter, not
		configuration to revisit. Reappears on its own the moment
		a new song creates a suggestion.
	-->
	if navSuggestionsPending(ctx) {
		<a href="/scheduling/song-tag-suggestions">Song Tag Suggestions</a>
	}
	<a href="/scheduling/song-preferences">Song / Person Preferences</a>
	<a href="/scheduling/person-relationships">Person Relationships</a>
	<a href="/scheduling/position-preferences">Position Preferences</a>
}
