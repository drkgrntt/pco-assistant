package views

import "fmt"

templ Home(personName, organizationName string, data HomeData) {
	@Layout("Home", personName, organizationName) {
		<h1>Welcome, { personName }</h1>

		if data.OrgStatus != "" && data.OrgStatus != "active" {
			<p class="warning">
				if data.OrgStatus == "trialing" {
					if data.TrialDaysLeft > 0 {
						{ fmt.Sprintf("%d day(s) left in your trial.", data.TrialDaysLeft) }
					} else {
						Your trial has ended.
					}
				} else {
					{ fmt.Sprintf("Billing status: %s.", data.OrgStatus) }
				}
				<a href="/billing">Choose a plan</a>
			</p>
		}

		if len(data.UpcomingPlans) > 0 {
			<h2>Needs attention</h2>
			<p class="muted">The next upcoming plan for each service type.</p>
			<ul class="plan-list">
				for _, plan := range data.UpcomingPlans {
					<li>
						<a href={ templ.URL(plan.TargetURL()) }>
							if plan.Title != "" {
								{ plan.Title }
							} else {
								{ plan.Dates }
							}
						</a>
						<span class="muted">{ plan.ServiceTypeName }</span>
						<span class="badge-label">Songs</span>
						@PlanStatusBadge(plan.SetStatus)
						<span class="badge-label">Team</span>
						@PlanStatusBadge(plan.RosterStatus)
					</li>
				}
			</ul>
		}

		if data.SuggestionCount > 0 {
			<p>
				{ fmt.Sprintf("%d song tag suggestion(s) waiting for review.", data.SuggestionCount) }
				<a href="/scheduling/song-tag-suggestions">Review suggestions</a>
			</p>
		}

		if data.SongInfoTotal > 0 && data.SongInfoCached < data.SongInfoTotal {
			<p>
				{ fmt.Sprintf("%d of %d song(s) have cached key/tempo info.", data.SongInfoCached, data.SongInfoTotal) }
				<a href="/scheduling/song-info">Finish syncing</a>
			</p>
		}

		<h2>Workflows</h2>
		<p class="muted">Where you'll spend most of your time week to week.</p>
		<nav class="quick-links">
			<a class="button primary" href="/scheduling/build">Build a Service</a>
		</nav>

		<h2>Setup</h2>
		<p class="muted">Configure once, then the workflows above put it to use - relationships, roles, and scheduling preferences for songs and people.</p>
		<!--
			Reuses .plan-list's card-row treatment (already used for "Needs
			attention" above) rather than the old quick-links-secondary's
			plain wrapping link row - that had no room for a description
			under each link, only the link text itself.
		-->
		<ul class="plan-list">
			<li>
				<a href="/scheduling/song-relationships">Song relationships</a>
				<span class="muted">Flows well, same theme, or avoid pairing.</span>
			</li>
			<li>
				<a href="/scheduling/song-roles">Song roles</a>
				<span class="muted">Opener, response, or any role you add.</span>
			</li>
			<li>
				<a href="/scheduling/song-tags">Song tags</a>
				<span class="muted">Theme, scripture, and idea tags for search and filtering.</span>
			</li>
			<li>
				<a href="/scheduling/song-tag-suggestions">Song tag suggestions</a>
				<span class="muted">Review songs sharing a title word and tag them together.</span>
			</li>
			<li>
				<a href="/scheduling/song-info">Song info</a>
				<span class="muted">Sync each song's key, tempo, and length from Planning Center.</span>
			</li>
			<li>
				<a href="/scheduling/song-preferences">Song / person preferences</a>
				<span class="muted">Note who's preferred or discouraged for a song.</span>
			</li>
			<li>
				<a href="/scheduling/person-relationships">Person relationships</a>
				<span class="muted">Works well, mentorship, or avoid pairing between people.</span>
			</li>
			<li>
				<a href="/scheduling/position-preferences">Position preferences</a>
				<span class="muted">How often someone wants to serve a position.</span>
			</li>
		</ul>
	}
}
