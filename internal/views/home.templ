package views

import (
	"fmt"

	"pco-assistant/internal/views/components"
)

templ Home(personName, organizationName string, data HomeData) {
	@Layout("Home", personName, organizationName) {
		<h1>Welcome, { personName }</h1>

		if data.OrgStatus != "" && data.OrgStatus != "active" {
			<p class="warning">
				if data.OrgStatus == "trialing" {
					if data.TrialDaysLeft > 0 {
						{ fmt.Sprintf("%d day(s) left in your trial.", data.TrialDaysLeft) }
					} else {
						Your trial has ended.
					}
				} else {
					{ fmt.Sprintf("Billing status: %s.", data.OrgStatus) }
				}
				<a href="/billing">Choose a plan</a>
			</p>
		}

		if len(data.UpcomingPlans) > 0 {
			<h2>Needs attention</h2>
			<p class="muted">The next upcoming plan for each service type.</p>
			<ul class="plan-list">
				for _, plan := range data.UpcomingPlans {
					<li>
						<a href={ templ.URL(plan.TargetURL()) }>
							if plan.Title != "" {
								{ plan.Title }
							} else {
								{ plan.Dates }
							}
						</a>
						<span class="muted">{ plan.ServiceTypeName }</span>
						<span class="badge-label">Songs</span>
						@components.PlanStatusBadge(plan.SetStatus)
						<span class="badge-label">Team</span>
						@components.PlanStatusBadge(plan.RosterStatus)
					</li>
				}
			</ul>
		}

		if data.SuggestionCount > 0 {
			<p>
				{ fmt.Sprintf("%d song tag suggestion(s) waiting for review.", data.SuggestionCount) }
				<a href="/scheduling/song-tag-suggestions">Review suggestions</a>
			</p>
		}

		<h2>Workflows</h2>
		<p class="muted">Where you'll spend most of your time week to week.</p>
		<nav class="quick-links">
			<a class="button primary" href="/scheduling/build">Build a Service</a>
		</nav>

		<h2>Setup</h2>
		<p class="muted">
			{ fmt.Sprintf("%d of %d set up so far.", data.Onboarding.Done, data.Onboarding.Trackable) }
			Configure once, then the workflows above put it to use - each item below feeds a warning or suggestion on the Build page, grouped by which promise it serves (see <a href="/how-it-works">how it works</a>).
		</p>
		<!--
			Checklist form replaced the old flat Setup link list, then a
			since-removed dismissible nudge card, per Derek's "weak sauce"
			feedback - see
			docs/plans/in-progress/onboarding-and-ambient-framing-plan.md's
			Phase 3. Reuses .plan-list's card-row treatment (already used
			for "Needs attention" above); each item's Done state
			(components.Badge) reflects real local data (HomeController.
			buildOnboardingChecklist), not a guess - see
			OnboardingItem.Trackable's doc comment for the one item (Position
			Preferences) that can't be tracked and renders with no badge.
			Grouped by the two docs/ideas.md Vision/positioning promises so
			each item's "why" is legible, not just its "what" - an item that
			genuinely serves both (vocal range) is split across both groups
			by its own person-side/song-side halves rather than picked into
			one arbitrarily, per that plan doc's own reasoning.
		-->
		for _, group := range data.Onboarding.Groups {
			<h3>{ group.Title }</h3>
			<p class="muted">{ group.Intro }</p>
			<ul class="plan-list">
				for _, item := range group.Items {
					<li>
						<a href={ templ.URL(item.Href) }>{ item.Label }</a>
						<span class="muted">{ item.Description }</span>
						if item.Trackable {
							if item.Done {
								@components.Badge("published", "Done")
							} else {
								@components.Badge("status-pending", "Not set up")
							}
						}
					</li>
				}
				<!--
					Song Tag Suggestions isn't a one-time setup item (no
					done/not-done state to track), so it stays outside the
					checklist loop above - a review queue, appended only to
					the service group and only while something's actually
					waiting, same SuggestionCount fact the nudge paragraph
					above already computes, not a second lookup. Mirrors the
					nav dropdown's own version of this (see layout.templ,
					middleware.PopulateNavState).
				-->
				if group.Title == "Protect the service" && data.SuggestionCount > 0 {
					<li>
						<a href="/scheduling/song-tag-suggestions">Song tag suggestions</a>
						<span class="muted">Review songs sharing a title word and tag them together.</span>
					</li>
				}
			</ul>
		}
	}
}
