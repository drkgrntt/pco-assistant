package views

templ Home(personName string) {
	@Layout("Home", personName) {
		<h1>Welcome, { personName }</h1>

		<h2>Workflows</h2>
		<p class="muted">Where you'll spend most of your time week to week.</p>
		<nav class="quick-links">
			<a class="button primary" href="/scheduling/build">Build a Service</a>
		</nav>

		<h2>Setup</h2>
		<p class="muted">Configure once, then the workflows above put it to use - relationships, roles, and scheduling preferences for songs and people.</p>
		<nav class="quick-links quick-links-secondary">
			<a href="/scheduling/song-relationships">Song relationships</a>
			<a href="/scheduling/song-roles">Song roles</a>
			<a href="/scheduling/song-preferences">Song / person preferences</a>
			<a href="/scheduling/person-relationships">Person relationships</a>
			<a href="/scheduling/position-preferences">Position preferences</a>
		</nav>
	}
}
