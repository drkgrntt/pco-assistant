package views

// HowItWorks is the public "/how-it-works" marketing page - the deeper
// pass the homepage (Landing, landing.templ) deliberately doesn't take:
// concrete scenarios rather than a feature list, organized around the two
// promises `docs/ideas.md`'s Vision/positioning section settled on
// ("protect the team" / "protect the service") rather than a flat
// features wall, so this page doesn't need a rewrite every time a new
// setting ships - only when a new promise-level capability does. Same
// chrome as Landing (marketingHeader/marketingFooter, landing.css).
templ HowItWorks() {
	<!DOCTYPE html>
	<html lang="en">
		@Head("How it works - Resonance") {
			<link rel="stylesheet" href={ "/static/css/landing.css?v=" + AssetVersion }/>
		}
		<body class="landing">
			@marketingHeader()
			<main>
				<section class="landing-hero">
					<p class="landing-eyebrow">How it works</p>
					<h1>Two promises, checked automatically.</h1>
					<p class="landing-lede">
						Planning Center is the system of record - it stores what's
						already decided. Every feature here exists to catch something
						before it gets that far, and it all serves one of two things:
						protecting the team, or protecting the service.
					</p>
				</section>
				<section class="landing-studio">
					<div class="landing-studio-side">
						<h3>Planning Center</h3>
						<p class="landing-studio-tag">The live broadcast</p>
						<p>Where the final plan goes out to your whole team - names, times, positions, all locked in and public.</p>
					</div>
					<div class="landing-studio-side landing-studio-side-accent">
						<h3>Resonance</h3>
						<p class="landing-studio-tag">The rehearsal studio</p>
						<p>Where the decision actually gets made - checked against everything Planning Center itself has no way to know, before it ever reaches your team.</p>
					</div>
				</section>
				<section class="landing-features">
					<h2>Protect the service</h2>
					<p class="landing-lede">Repetition fatigue, a broken set flow, a conflict nobody caught - surfaced while you're still drafting, not after the plan's already out.</p>
					<div class="landing-feature-grid">
						<div class="landing-feature-card">
							<h3>Catches the encore nobody meant</h3>
							<p>A heads-up if a song was sung in each of the last two plans - before it quietly becomes three in a row.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Gives a new song room to land</h3>
							<p>A song genuinely new to your church gets tracked automatically and flagged "could use one more sing" until it's actually stuck.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Flags a set that's run long</h3>
							<p>A plan-length warning when the draft runs noticeably longer or shorter than that service type's recent average - before rehearsal finds out the hard way.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Catches a jarring key change</h3>
							<p>Two back-to-back songs a half step apart, nothing between them, get flagged before the band finds out live.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Catches a set that doesn't flow</h3>
							<p>Songs tagged as a bad pairing get flagged if they land back to back; songs that flow well or share a theme get suggested as the next pick - so the set's shape isn't just whatever order they got added in.</p>
						</div>
					</div>
				</section>
				<section class="landing-features">
					<h2>Protect the team</h2>
					<p class="landing-lede">Burnout, stated preferences, relational friction, mentorship pairing - the calls a director already carries in their head, turned into guardrails.</p>
					<div class="landing-feature-grid">
						<div class="landing-feature-card">
							<h3>Surfaces friction before the roster goes out</h3>
							<p>Avoid-pairing relationships between people show up as a warning right while you're filling the roster - not as a surprise on Sunday.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Nudges toward the pairing that helps, not just the easy one</h3>
							<p>Works-well and mentorship relationships surface as suggestions while you build - so a mentor actually gets paired with who they're mentoring instead of whoever's easiest to slot in that week.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Catches a double-booking</h3>
							<p>A cross-team warning when someone's already filling another position or team the same week.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Respects how often someone wants to serve</h3>
							<p>Position preferences write straight back to real Planning Center data, so they're respected by Planning Center's own scheduling tools too - not just here.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Stops a blockout from slipping through</h3>
							<p>If someone's marked themselves unavailable in Planning Center, that shows up as a warning right in the roster picker - not a separate calendar someone has to remember to cross-check before publishing.</p>
						</div>
						<div class="landing-feature-card">
							<h3>Checks against real serving history</h3>
							<p>Serving-frequency warnings checked against what actually happened, not what a director half-remembers.</p>
						</div>
					</div>
				</section>
				<section class="landing-problem">
					<h2>Nothing lives only here</h2>
					<p>
						Publish pushes everything to real Planning Center plan items and
						assignments in one sync - the same data everyone else already
						sees in Planning Center. Discard reverts a draft back to
						whatever's currently live in Planning Center. And if something
						gets added directly in Planning Center after you've started a
						draft, pulling it in doesn't discard any local change you've
						already made. Stop using Resonance any time and there's nothing
						to migrate back - your schedule was never only here.
					</p>
				</section>
				<section class="landing-final-cta">
					<h2>Ready to run through it before it goes live?</h2>
					<a class="button primary landing-cta" href="/auth/pco/start">Sign in with Planning Center</a>
					<p class="landing-reassurance">Uses your existing Planning Center login - no separate account, no credit card.</p>
				</section>
			</main>
			@marketingFooter()
		</body>
	</html>
}
