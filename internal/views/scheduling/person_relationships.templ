package scheduling

import (
	"fmt"
	"strconv"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ PersonRelationships(personName, organizationName string, relationships []scheduling.PersonRelationship, relationshipTypes []scheduling.PersonRelationshipType, personNames map[string]string, typeLabels map[string]string, errMsg string) {
	@views.Layout("Person Relationships", personName, organizationName) {
		@personRelationshipsHelp()
		<h1>Person Relationships</h1>
		<p class="muted">Relate people to each other - "works well with," "mentorship," or "doesn't work well with" - searching your Planning Center people directory.</p>
		<form
			id="person-relationship-form"
			class="inline"
			hx-post="/scheduling/person-relationships"
			hx-target="#person-relationships-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			<input type="hidden" name="id"/>
			@PersonPickerField("Person A", "person_id_a", "a")
			@PersonPickerField("Person B", "person_id_b", "b")
			<label>
				Relationship
				<select name="relationship_type">
					for _, t := range relationshipTypes {
						<option value={ t.Code }>{ t.Label }</option>
					}
				</select>
			</label>
			<label>
				Notes
				<input type="text" name="notes"/>
			</label>
			<button type="submit" class="primary">Add</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@PersonRelationshipsTable(relationships, personNames, typeLabels, errMsg)
	}
}

// PersonRelationshipsTable is both the initial-render fragment and the htmx
// swap target (id="person-relationships-table") - see RelationshipsTable for
// why errMsg lives inside it rather than the page around it. typeLabels
// resolves relationship_type codes to their person_relationship_types label
// (see personRelationshipTypeLabelMap in the scheduling controller) - a
// code removed from that table since the relationship was created falls
// back to showing the raw code.
templ PersonRelationshipsTable(relationships []scheduling.PersonRelationship, personNames map[string]string, typeLabels map[string]string, errMsg string) {
	<div id="person-relationships-table">
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		@components.SortableTableWrap() {
			<thead>
					<tr>
						<th>Person A</th>
						<th>Person B</th>
						<th>Type</th>
						<th>Notes</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, rel := range relationships {
						<tr>
							<td>
								if name, ok := personNames[rel.PersonIDA]; ok {
									{ name }
								} else {
									{ rel.PersonIDA }
								}
							</td>
							<td>
								if name, ok := personNames[rel.PersonIDB]; ok {
									{ name }
								} else {
									{ rel.PersonIDB }
								}
							</td>
							<td>{ displayNameOrID(typeLabels, rel.RelationshipType) }</td>
							<td>{ rel.Notes }</td>
							<td>
								<button
									class="icon-btn"
									aria-label="Edit relationship"
									title="Edit relationship"
									data-edit-form="person-relationship-form"
									data-edit-fields={ editFieldsAttr(map[string]string{
										"id":                strconv.FormatInt(rel.ID, 10),
										"relationship_type": rel.RelationshipType,
										"notes":             rel.Notes,
									}) }
									data-edit-people={ editPeopleAttr(map[string]editPerson{
										"a": {ID: rel.PersonIDA, Name: displayNameOrID(personNames, rel.PersonIDA)},
										"b": {ID: rel.PersonIDB, Name: displayNameOrID(personNames, rel.PersonIDB)},
									}) }
									onclick="editRow(this)"
								>
									@components.IconEdit()
								</button>
								<button
									class="danger icon-btn"
									aria-label="Delete relationship"
									title="Delete relationship"
									hx-delete={ fmt.Sprintf("/scheduling/person-relationships/%d", rel.ID) }
									hx-target="#person-relationships-table"
									hx-swap="outerHTML"
									hx-confirm="Delete this relationship?"
								>
									@components.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(relationships) == 0 {
						<tr>
							<td colspan="5" class="muted">No relationships yet - add one to get a warning before two people who shouldn't be scheduled together end up on the same roster.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}

// personRelationshipsHelp is this page's Help-triggered dialog - see
// songRelationshipsHelp's own doc comment (relationships.templ) for the
// full reasoning shared by every setup-page help dialog (single step, no
// createTourController, .page-help-dialog for openPageHelp's dispatch, and
// the forward-only Next-link chain / setPageHelpForce mechanism). This is
// page 6 of that chain (... Song / Person Preferences -> here -> Position
// Preferences -> ...).
templ personRelationshipsHelp() {
	<dialog id="person-relationships-help" class="tour-dialog page-help-dialog">
		<div class="tour-step">
			<h2>Person Relationships</h2>
			<p>
				Relate people to each other - works well with, mentorship, or
				doesn't work well with. Build uses these to flag two people who
				shouldn't be scheduled together before the roster goes out.
			</p>
		</div>
		<p class="muted tour-footnote">Need this again later? Look for Help at the bottom of any page.</p>
		<div class="tour-actions">
			<a class="button" href="/scheduling/position-preferences" onclick="setPageHelpForce()">Next: Position Preferences →</a>
			<button type="button" class="button primary" onclick="closeHelpDialog('person-relationships-help')">Got it</button>
		</div>
	</dialog>
}
