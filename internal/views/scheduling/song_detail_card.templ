package scheduling

import (
	"fmt"

	"pco-assistant/internal/views/components"
)

// SongDetailCards is every song's own detail card, stacked in the Build
// page's sidebar (see build.templ) right below the publish card - see
// songDetailCard below for what's on one and why it exists at all. Only
// ever one card is actually visible at a time: selectSongRow
// (scheduling.js) shows whichever one matches the row that was just
// clicked and hides the rest, the same "one open slot per song" idiom
// set_builder.templ's own quick-action-row already uses.
//
// hidden mirrors SongPublishPanel's own param - true while the Team tab is
// the one open, since this card group only makes sense next to the Songs
// tab it belongs to. Rendered directly (not through SetBuilderBody) on the
// Build page's initial full-page load - see SongDetailCards vs
// songDetailCardsOOB, which mirrors SongPublishPanel vs songPublishPanelOOB
// for the exact same reason (an hx-swap-oob fragment renders as an inert
// visible duplicate outside of an htmx-processed response), including
// songDetailCardsOOB never setting hidden itself (see that comment).
templ SongDetailCards(data SetBuilderData, hidden bool) {
	@buildDetailGroupShell("build-detail-songs", hidden) {
		for _, row := range data.ServiceOrder {
			if row.IsSong {
				@songDetailCard(data, row.Song)
			}
		}
	}
}

templ songDetailCardsOOB(data SetBuilderData) {
	@buildDetailGroupShellOOB("build-detail-songs", false) {
		for _, row := range data.ServiceOrder {
			if row.IsSong {
				@songDetailCard(data, row.Song)
			}
		}
	}
}

// songDetailCardsLazyOOB is songPublishPanelLazyOOB's detail-card
// equivalent (see its doc comment) - BuildSongsTabLazy's counterpart to
// songDetailCardsOOB, rendered hidden since the Songs tab is the inactive
// one being fetched here, not the open one.
templ songDetailCardsLazyOOB(data SetBuilderData) {
	@buildDetailGroupShellOOB("build-detail-songs", true) {
		for _, row := range data.ServiceOrder {
			if row.IsSong {
				@songDetailCard(data, row.Song)
			}
		}
	}
}

// KeyFormFragment/DescriptionFormFragment/SongNoteFormFragment re-render
// just one form in place - the response for UpdateSetSongKey/
// UpdateSetSongDescription/UpdateSongNote (sets.go), which each act on
// exactly one form's own data and touch nothing else on the page (not the
// order of service, not the card's own title/badges/actions, not any
// other note). Each form's own hx-target="this" swaps only itself, so
// saving one never disturbs the card it lives in, let alone the rest of
// the page - a tighter scope than even re-rendering the whole card would
// be.
//
// KeyFormFragment/DescriptionFormFragment both have more to update than
// just the form itself, since either one can flip an already-published
// song's InfoPending (see SetSongView.InfoPending): the row's own Tags
// column badge (songBadgesOOB) and the sidebar's Discard button/pending
// list (songPublishPanelOOB) both need to reflect that immediately, not
// just after some unrelated action happens to re-render the whole page -
// same "did that actually save?" reasoning as KeyFormFragment's own
// #song-meta-<id> update below. SongNoteFormFragment doesn't need any of
// this: category notes write straight to Planning Center immediately and
// never set InfoPending in the first place.
//
// KeyFormFragment additionally updates the order-of-service row's own
// summary line (set_builder.templ's #song-meta-<id>), which shows this
// song's *effective* key (see renderServiceOrder's own comment on why) -
// DescriptionFormFragment has no equivalent, since Description isn't
// shown anywhere else on the row. It also re-pushes this song's own Tags
// column badges (which now carry its key-transition badge inline, see
// songBadgeSpans/SetSongView.KeyTransitionLabel) *and*, when the row right
// after this one is also a song, that neighbor's badges too: a key edit on
// this song can flip keyTransitionWarnings' verdict on both the pair
// ending here and the pair starting here, but only the first of those two
// lives on this song's own row (the badge is attached to the *second*
// song in each pair - see keyTransitionWarning's doc comment) - without
// this second OOB push, the row right after a key edit stayed stuck
// showing its pre-edit transition badge (or lack of one) until some
// unrelated action happened to re-render the whole page.
templ KeyFormFragment(data SetBuilderData, song SetSongView, errMsg string) {
	@keyForm(data, song, errMsg)
	<div class="muted song-meta" id={ fmt.Sprintf("song-meta-%d", song.ID) } hx-swap-oob="true">{ song.ArrangementInfo }</div>
	@songBadgesOOB(song)
	if next, ok := nextSongRowAfter(data.ServiceOrder, song.ID); ok {
		@songBadgesOOB(next)
	}
	@songPublishPanelOOB(data)
}

templ DescriptionFormFragment(data SetBuilderData, song SetSongView, errMsg string) {
	@descriptionForm(data, song, errMsg)
	@songBadgesOOB(song)
	@songPublishPanelOOB(data)
}

templ SongNoteFormFragment(data SetBuilderData, song SetSongView, note SongNoteView, errMsg string) {
	@songNoteForm(data, song, note, errMsg)
}

// SongArrangementInfoRefreshFragment is RefreshSetSongArrangementInfo's
// (song_arrangement_cache.go) htmx response - a single song's own "Update
// from Planning Center" button forcing a live re-fetch of its cached
// arrangement info, overwriting whatever's currently cached (unlike the
// background queue-on-miss sync, which only fills gaps and never re-fetches
// an already-cached song - see fetchAndCacheArrangementInfo's own doc
// comment for why this one action always re-fetches instead). Deliberately
// not called "Refresh song info"
// (a phrase this page's own Publish panel already uses for the opposite-
// direction action, pushing local key/length/arrangement values out to
// Planning Center - see publish_panel.templ's "Re-sync key, length &
// arrangement" button) - two same-named buttons moving data in opposite
// directions is exactly the kind of thing worth a distinct name for. Mirrors
// KeyFormFragment's own multi-piece update: the card's own arrangement-info
// paragraph is the primary (non-OOB) swap target, since that's what the
// button itself points hx-target at, plus the same OOB pieces
// KeyFormFragment already pushes whenever a song's effective key can
// change - the order-of-service row's #song-meta-<id> summary (which shows
// the *effective* key, arrangement default or override - see
// renderServiceOrder), this song's own Tags-column badges (a refreshed key
// can flip keyTransitionWarnings' verdict against this song's neighbor,
// same as an edited key override would), and that neighbor's own badges.
//
// Also pushes Structure/HasChordChart (song-structure-<id>, song-chord-
// chart-badge-<id>) and the attachments "Files" list (song-attachments-<id>,
// via songAttachmentsList's own oob=true branch) via the same OOB
// mechanism - all three can change on a real refresh (an arrangement's
// structure edited, a chord chart or attachment added/removed, directly in
// Planning Center) same as key/BPM/meter/length can. Each is only ever
// rendered (in songDetailCard, initially) when it has something to show, so
// an OOB update here only actually appears once that element already
// exists in the DOM - a song going from "no structure yet"/"no attachments
// yet" to having one on this same click needs a full page reload to show it
// the first time, same trade-off as everywhere else in this app that only
// re-renders a fragment rather than the whole page. Also refreshes the
// next row's own badges (nextSongRowAfter), same reasoning as
// KeyFormFragment's own doc comment above: a refreshed key can flip
// keyTransitionWarnings' verdict against this song's neighbor too, and
// that badge lives on the neighbor's row, not this one.
templ SongArrangementInfoRefreshFragment(data SetBuilderData, song SetSongView, errMsg string) {
	<p class="muted" id={ fmt.Sprintf("song-arrangement-info-%d", song.ID) }>
		if errMsg != "" {
			<span class="error">{ errMsg }</span>
		} else if song.ArrangementInfo != "" {
			{ song.ArrangementInfo }
		} else {
			No arrangement info cached yet.
		}
	</p>
	<div class="muted song-meta" id={ fmt.Sprintf("song-meta-%d", song.ID) } hx-swap-oob="true">{ song.ArrangementInfo }</div>
	if song.Structure != "" {
		<p class="muted" id={ fmt.Sprintf("song-structure-%d", song.ID) } hx-swap-oob="true"><strong>Structure:</strong> { song.Structure }</p>
	}
	@songAttachmentsList(data, song, true)
	if song.HasChordChart {
		<span id={ fmt.Sprintf("song-chord-chart-badge-%d", song.ID) } hx-swap-oob="true">
			@components.Badge("", "Chord chart")
		</span>
	}
	@songBadgesOOB(song)
	if next, ok := nextSongRowAfter(data.ServiceOrder, song.ID); ok {
		@songBadgesOOB(next)
	}
	@songRefreshStatusOOB(song.ID, errMsg)
}

// songRefreshStatusElementID is the stable HTML id for one song's own
// "Update from Planning Center" confirmation line on its sidebar detail
// card (songDetailCard above) - same purpose as
// personRefreshStatusElementID (roster_builder.templ), for the same
// reason: this button most often finds Planning Center's cached values
// already match, so the primary swap target
// (#song-arrangement-info-<id>) renders identically to before the click
// and the click would otherwise look like a no-op.
func songRefreshStatusElementID(songID int64) string {
	return fmt.Sprintf("song-refresh-status-%d", songID)
}

// songRefreshStatusOOB confirms a "Update from Planning Center" click
// actually ran - "Updated." on success, cleared on failure since the
// primary swap target already surfaces errMsg right where the click
// happened.
templ songRefreshStatusOOB(songID int64, errMsg string) {
	<span id={ songRefreshStatusElementID(songID) } class="muted" hx-swap-oob="true">
		if errMsg == "" {
			Updated.
		}
	</span>
}

// songDetailCard is one song's detail card - hidden until selectSongRow
// (scheduling.js) reveals it, in response to clicking that song's own row
// in the order of service (set_builder.templ). Its content mirrors what
// the row itself already carries (title, arrangement info, badges) plus
// what there wasn't room for at a table row's height (the arrangement's
// own Notes) and every one of the row's own actions, spelled out as
// labeled buttons instead of icons-only - the sidebar has the room a
// table cell doesn't.
//
// The action forms here (duplicate/remove/replace) are the exact same
// hx-post/hx-delete targets and hx-confirm text as the row's own -
// deliberate duplication, same as the Quick add panel already duplicates
// these same tag/relate/role forms generically (see set_builder.templ's
// own comment on that) - simpler than trying to share one set of DOM
// elements between two different places on the page. Tag/Relate/Mark role
// instead jump to (and reveal) the row's own hidden quick-action-row,
// rather than yet another copy of those three forms - see openQuickAction
// (scheduling.js), which already knows how to find that row by id.
templ songDetailCard(data SetBuilderData, song SetSongView) {
	@buildDetailCardShell(fmt.Sprintf("%d", song.ID), song.Title, "closeSongDetail()") {
		<p class="muted" id={ fmt.Sprintf("song-arrangement-info-%d", song.ID) }>
			if song.ArrangementInfo != "" {
				{ song.ArrangementInfo }
			} else {
				No arrangement info cached yet.
			}
		</p>
		if song.Structure != "" {
			<p class="muted" id={ fmt.Sprintf("song-structure-%d", song.ID) }><strong>Structure:</strong> { song.Structure }</p>
		}
		@songAttachmentsList(data, song, false)
		<div class="build-detail-badges">
			for _, role := range song.Roles {
				@components.Badge("", role.Label)
			}
			if song.Published {
				@components.Badge("published", "Published")
			}
			if song.Moved {
				@components.BadgeTitled("status-pending", "Moved", "Moved since it was last published")
			}
			if song.HasChordChart {
				<span id={ fmt.Sprintf("song-chord-chart-badge-%d", song.ID) }>
					@components.Badge("", "Chord chart")
				</span>
			}
		</div>
		<div class="build-detail-notes-group">
			if data.ReadOnly {
				<!--
					No forms for a past plan - see SetBuilderData.ReadOnly.
					Key/note are shown as plain text instead of editable
					fields, same info keyForm/descriptionForm would
					otherwise carry.
				-->
				if song.Key != "" {
					<p><strong>Key (that week):</strong> { song.Key }</p>
				}
				if song.Description != "" {
					<p><strong>Note:</strong> { song.Description }</p>
				}
			} else {
				@keyForm(data, song, "")
				@descriptionForm(data, song, "")
			}
		</div>
		if !data.ReadOnly {
			<div class="build-detail-actions">
				<button
					type="button"
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/duplicate", data.ServiceTypeID, data.PlanID, song.ID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
				>
					@components.IconCopy()
					Duplicate
				</button>
				<button
					type="button"
					class="danger"
					hx-delete={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d", data.ServiceTypeID, data.PlanID, song.ID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
					hx-confirm="Remove this song from the set?"
				>
					@components.IconRemove()
					Remove
				</button>
				if len(data.ReplaceCandidates) > 0 {
					<form
						class="replace-form"
						hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/replace", data.ServiceTypeID, data.PlanID, song.ID) }
						hx-target="#set-builder-body"
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Replace %q with the selected song?", song.Title) }
					>
						<select name="song_id" required>
							<option value="" selected disabled>Replace with...</option>
							for _, cand := range data.ReplaceCandidates {
								<option value={ cand.SongID }>{ cand.Title }</option>
							}
						</select>
						<button type="submit">
							@components.IconReplace()
							Replace
						</button>
					</form>
				}
				<button
					type="button"
					title="Pull this song's key, tempo, meter, and length from Planning Center right now, overwriting whatever's cached here - use this if one of those was just changed directly in Planning Center. This is the opposite direction from Re-sync key, length &amp; arrangement on the Publish panel, which pushes this app's own values out to Planning Center."
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/refresh-arrangement-info", data.ServiceTypeID, data.PlanID, song.ID) }
					hx-target={ fmt.Sprintf("#song-arrangement-info-%d", song.ID) }
					hx-swap="outerHTML"
				>
					Update from Planning Center
				</button>
				<span id={ songRefreshStatusElementID(song.ID) } class="muted"></span>
				<button type="button" data-row-id={ fmt.Sprintf("%d", song.ID) } onclick="openQuickAction(this, 'tag')">
					@components.IconTag()
					Tag this song
				</button>
				<button type="button" data-row-id={ fmt.Sprintf("%d", song.ID) } onclick="openQuickAction(this, 'relate')">
					@components.IconRelate()
					Relate to another song
				</button>
				<button type="button" data-row-id={ fmt.Sprintf("%d", song.ID) } onclick="openQuickAction(this, 'role')">
					@components.IconRole()
					Mark a role
				</button>
			</div>
		}
		<!--
			Song.Notes - one Planning Center ItemNote per note category
			(Audio/Visual, Band, Vocals, etc. - configured per service
			type) already on this song's plan item, plus an empty slot
			for any category that doesn't have one yet. Each saves
			straight to Planning Center immediately (see UpdateSongNote),
			same "ad hoc, not part of the draft/publish cycle" shape as
			the Tag/Relate/Mark role actions above - these are real,
			existing PCO records, not local state to publish later.
			Only populated for a published song (nil otherwise, since
			there's no plan item yet to attach a note to).

			Collapsed by default (collapsibleSection, open=false): these
			are touched far less often than the "This week" key/note
			above, and a service type with several note categories would
			otherwise push a form per category ahead of every song
			card's own actions - see SongNoteFormFragment's own doc
			comment above for the full "why a separate concept from
			key/note" reasoning.
		-->
		if data.ReadOnly {
			for _, note := range song.Notes {
				if note.Content != "" {
					<p><strong>{ note.CategoryName }:</strong> { note.Content }</p>
				}
			}
		} else {
			@collapsibleSection(fmt.Sprintf("song-notes-%d", song.ID), "Category notes (Planning Center)", false) {
				for _, note := range song.Notes {
					@songNoteForm(data, song, note, "")
				}
				if len(song.Notes) == 0 {
					if song.Published {
						<p class="muted">No note categories are configured for this service type yet - add some in Planning Center.</p>
					} else {
						<p class="muted">Publish this song first to add notes here (Audio/Visual, Band, Vocals, etc.).</p>
					}
				}
			}
		}
	}
}

// songAttachmentsList is this song's cached Planning Center Attachments
// (lead sheet/chord chart PDFs, scans, audio - see SetSongView.Attachments)
// as a small "Files" list, one link per attachment - filename as link text,
// each opening in a new tab via OpenSongAttachment
// (song_attachment_cache.go), which live-fetches a fresh URL on the actual
// click rather than linking straight to a cached one (see
// scheduling.SongAttachmentInfo's own doc comment for why). Renders nothing
// at all when there are none, same "just omit it" convention as
// ArrangementInfo's blank-field handling elsewhere on this card - and, like
// Structure/HasChordChart's own OOB refresh (see SongArrangementInfoRefreshFragment
// below), a song going from "no attachments" to "has some" on a live
// refresh needs a full page reload to show the block for the first time,
// since there's no existing DOM element for an OOB swap to land on until
// then.
//
// oob is true only when called from SongArrangementInfoRefreshFragment's
// own "Update from Planning Center" response - the same single templ
// tagged onto both the primary card render and that OOB refresh, so the
// two can never drift out of sync with each other.
templ songAttachmentsList(data SetBuilderData, song SetSongView, oob bool) {
	if len(song.Attachments) > 0 {
		<div
			class="build-detail-attachments muted"
			id={ fmt.Sprintf("song-attachments-%d", song.ID) }
			if oob {
				hx-swap-oob="true"
			}
		>
			<strong>Files:</strong>
			<ul>
				for _, a := range song.Attachments {
					<li>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/attachments/%s", data.ServiceTypeID, data.PlanID, song.ID, a.PCOAttachmentID)) }
							target="_blank"
							rel="noopener noreferrer"
						>
							{ a.Filename }
						</a>
					</li>
				}
			</ul>
		</div>
	}
}

// keyForm is this song's key for this one occurrence (SetSongView.Key) -
// a local draft edit, same shape and same "reaches Planning Center on the
// next Publish or Refresh, not immediately" timing as descriptionForm
// below (see UpdateSetSongKey, resolveKeyID). Editing this never changes
// the song's arrangement or its own default key - only what this one
// occurrence's plan item links to.
//
// A datalist (musicalKeyOptions), not a strict <select>: the 12 chromatic
// keys x major/minor (both sharp and flat spellings for the five
// "black key" notes) cover every normal entry as a click instead of
// typing, but the underlying input stays free text, so nothing outside
// that list is rejected. That matters because Planning Center's own set
// of valid keys isn't a fixed enum this app hardcodes against - it's
// whatever string ends up on Key.StartingKey (see resolveKeyID) - and a
// trailing "m" for a minor key is part of that same string, not a
// separate flag PCO's API can even set (see resolveKeyID's own doc
// comment). A strict dropdown would silently make unusual-but-legitimate
// entries impossible to type at all.
templ keyForm(data SetBuilderData, song SetSongView, errMsg string) {
	<form
		class="build-detail-note-form"
		hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/key", data.ServiceTypeID, data.PlanID, song.ID) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<label>
			Key (this week)
			<input type="text" name="key" value={ song.Key } placeholder="e.g. G, Bb, F#m" list="key-options"/>
		</label>
		@musicalKeyOptions()
		<button type="submit">Save key</button>
		<p class="muted">Saved here - Publish or Refresh song info to send it to Planning Center.</p>
	</form>
}

// musicalKeyOptions is the shared <datalist> of standard keys backing
// keyForm's input (see that doc comment for why a datalist rather than a
// strict <select>). All 12 chromatic notes, sharp and flat spellings both
// for the five that have one, major then the same list again with a
// trailing "m" for minor - see resolveKeyID for why "m" lives in the
// string itself rather than a separate flag.
templ musicalKeyOptions() {
	<datalist id="key-options">
		<option value="C"></option>
		<option value="C#"></option>
		<option value="Db"></option>
		<option value="D"></option>
		<option value="D#"></option>
		<option value="Eb"></option>
		<option value="E"></option>
		<option value="F"></option>
		<option value="F#"></option>
		<option value="Gb"></option>
		<option value="G"></option>
		<option value="G#"></option>
		<option value="Ab"></option>
		<option value="A"></option>
		<option value="A#"></option>
		<option value="Bb"></option>
		<option value="B"></option>
		<option value="Cm"></option>
		<option value="C#m"></option>
		<option value="Dbm"></option>
		<option value="Dm"></option>
		<option value="D#m"></option>
		<option value="Ebm"></option>
		<option value="Em"></option>
		<option value="Fm"></option>
		<option value="F#m"></option>
		<option value="Gbm"></option>
		<option value="Gm"></option>
		<option value="G#m"></option>
		<option value="Abm"></option>
		<option value="Am"></option>
		<option value="A#m"></option>
		<option value="Bbm"></option>
		<option value="Bm"></option>
	</datalist>
}

// descriptionForm is "This week's note" (SetSongView.Description) - a
// local draft edit, same as everything else on this page: it reaches
// Planning Center as this item's Description on the next Publish or
// Refresh song info, not immediately (see UpdateSetSongDescription).
// hx-target="this" swaps only this <form> itself on save (see
// DescriptionFormFragment) - it's the element hx-post is on, so "this"
// is unambiguous. errMsg renders inline (a failed save has nowhere else
// to show up, since nothing outside this form gets touched).
templ descriptionForm(data SetBuilderData, song SetSongView, errMsg string) {
	<form
		class="build-detail-note-form"
		hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/description", data.ServiceTypeID, data.PlanID, song.ID) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<label>
			This week's note
			<textarea name="description" rows="2" placeholder="e.g. cut the bridge this week">{ song.Description }</textarea>
		</label>
		<button type="submit">Save note</button>
		<p class="muted">Saved here - Publish or Refresh song info to send it to Planning Center.</p>
	</form>
}

// songNoteForm is one Planning Center note category's box - see
// SetSongView.Notes' own doc comment for what this is and isn't. Same
// hx-target="this" reasoning as descriptionForm above; note_id is carried
// as a hidden field so UpdateSongNote knows whether to create or update
// (and the response's fresh note_id - "" until a first save creates one -
// is what makes the *next* save on this same form an update instead of a
// second create).
templ songNoteForm(data SetBuilderData, song SetSongView, note SongNoteView, errMsg string) {
	<form
		class="build-detail-note-form"
		hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/items/%s/notes", data.ServiceTypeID, data.PlanID, song.PCOItemID) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="category_id" value={ note.CategoryID }/>
		<input type="hidden" name="note_id" value={ note.NoteID }/>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<label>
			{ note.CategoryName }
			<textarea name="content" rows="2" placeholder={ fmt.Sprintf("Note for %s...", note.CategoryName) }>{ note.Content }</textarea>
		</label>
		<button type="submit">Save</button>
	</form>
}
