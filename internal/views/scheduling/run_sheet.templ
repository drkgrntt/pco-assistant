package scheduling

import (
	"fmt"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
)

// talkingPointsFor filters a song's TransitionNotePrompts down to just the
// talking_point kind - see docs/plans/shipped/transition-notes-plan.md's
// "moment 2" (Run Sheet display): the run sheet is specifically where a
// talking point needs to physically be for it to do any good (carried
// into the service), unlike a debrief, which is only ever useful back on
// the Build page where it was written. Reuses the exact same
// TransitionNotePrompts SetBuilderData already computes (see the
// controller's transitionNotePrompts) - no separate fetch or computation
// of its own, keeping RunSheet's "pure view, no new storage of its own"
// framing (see RunSheetPage's doc comment) as true as it can be for this
// one deliberate exception.
func talkingPointsFor(prompts []TransitionNotePromptView) []TransitionNotePromptView {
	var out []TransitionNotePromptView
	for _, p := range prompts {
		if p.Kind == scheduling.TransitionNoteTalkingPoint {
			out = append(out, p)
		}
	}
	return out
}

// hasAnyNoteContent reports whether at least one of a song's note
// categories actually has something written in it - see
// SetSongView.Notes, which carries one entry per Planning Center note
// category (Audio/Visual, Band, Vocals, etc.) whether or not anyone's
// actually filled it in yet (Content == "" when not). RunSheet uses this
// to skip a song's whole notes block rather than printing a page of empty
// category headers.
func hasAnyNoteContent(notes []SongNoteView) bool {
	for _, n := range notes {
		if n.Content != "" {
			return true
		}
	}
	return false
}

// teamGroupHasAssignments reports whether at least one position in a
// team's group (see groupPositionsByTeam, roster_builder.templ) has
// anyone assigned - RunSheet uses this to skip a whole team heading when
// every one of its positions is unassigned, the same "no gaps" treatment
// it gives individual positions below.
func teamGroupHasAssignments(group teamPositionGroup) bool {
	for _, item := range group.Positions {
		if len(item.Pos.Assigned) > 0 {
			return true
		}
	}
	return false
}

// anyPositionAssigned reports whether any position in the roster has at
// least one person assigned - RunSheet uses this to tell "no positions
// configured" apart from "positions configured, but nobody's on any of
// them yet" once unassigned positions are filtered out of the printed
// roster.
func anyPositionAssigned(positions []PositionGroupView) bool {
	for _, pos := range positions {
		if len(pos.Assigned) > 0 {
			return true
		}
	}
	return false
}

// RunSheet is the single-page, print-first "day-of" run sheet - see
// RunSheetPage (controllers/run_sheet.go) for the feature's framing. Pure
// view over SetBuilderData/RosterBuilderData, the same data
// BuildPlanPage's combined builder already computes for this plan: no new
// storage, no PCO calls of its own.
//
// Deliberately its own <html>/<body>, not wrapped in views.Layout - same
// reasoning as views.Landing (see its doc comment): the app nav, theme
// toggle, and early-preview banner are all dead weight on a page meant to
// be printed and read at a music stand or sound desk, not browsed. Still
// shares views.Head for the same cache-busted assets/favicon, plus this
// page's own stylesheet.
templ RunSheet(setData SetBuilderData, rosterData RosterBuilderData) {
	<!DOCTYPE html>
	<html lang="en">
		@views.Head("Run sheet") {
			<link rel="stylesheet" href={ "/static/css/run-sheet.css?v=" + views.AssetVersion }/>
		}
		<body class="run-sheet">
			<div class="run-sheet-page">
				<header class="run-sheet-header">
					<div>
						<h1>
							if setData.PlanTitle != "" {
								{ setData.PlanTitle }
							} else {
								Run sheet
							}
						</h1>
						if setData.PlanDates != "" {
							<p class="muted">{ setData.PlanDates }</p>
						}
					</div>
					<!--
						Plain window.print() - the browser's own print dialog already
						covers "export to PDF" (every modern browser's print dialog
						offers "Save as PDF" as a destination), so there's no reason to
						pull in a PDF-generation dependency just to duplicate that.
						Hidden when actually printing (see run-sheet.css's @media print)
						since it has nothing to do once print has already started.
					-->
					<button type="button" class="no-print" onclick="window.print()">Print</button>
				</header>
				if setData.ErrMsg != "" {
					<p class="error no-print">{ setData.ErrMsg }</p>
				}
				if rosterData.ErrMsg != "" {
					<p class="error no-print">{ rosterData.ErrMsg }</p>
				}
				<section class="run-sheet-section">
					<h2>Order of service</h2>
					if len(setData.ServiceOrder) == 0 {
						<p class="muted">Nothing built for this plan yet.</p>
					} else {
						<ol class="run-sheet-order">
							for _, row := range setData.ServiceOrder {
								if row.IsSong {
									<li class="run-sheet-item run-sheet-song">
										<div class="run-sheet-song-head">
											<span class="run-sheet-song-title">{ row.Song.Title }</span>
											if row.Song.ArrangementInfo != "" {
												<span class="muted">{ row.Song.ArrangementInfo }</span>
											}
										</div>
										if len(row.Song.Roles) > 0 {
											<div class="run-sheet-badges">
												for _, role := range row.Song.Roles {
													<span class="badge">{ role.Label }</span>
												}
											</div>
										}
										if hasAnyNoteContent(row.Song.Notes) {
											<dl class="run-sheet-notes">
												for _, note := range row.Song.Notes {
													if note.Content != "" {
														<div class="run-sheet-note">
															<dt>{ note.CategoryName }</dt>
															<dd>{ note.Content }</dd>
														</div>
													}
												}
											</dl>
										}
										if points := talkingPointsFor(row.Song.TransitionNotePrompts); len(points) > 0 {
											<dl class="run-sheet-notes run-sheet-talking-points">
												for _, p := range points {
													<div class="run-sheet-note">
														<dt>Talking point</dt>
														<dd>{ p.Message }</dd>
													</div>
												}
											</dl>
										}
									</li>
								} else {
									<!--
										Non-song item (header, media, or a plan item this app
										doesn't manage) - read-only for context, same treatment
										the order-of-service table gives it on the Build page
										itself (see set_builder.templ).
									-->
									<li class="run-sheet-item run-sheet-other">
										<span>{ row.ItemTitle }</span>
										if row.ItemType != "" {
											<span class="muted">{ row.ItemType }</span>
										}
									</li>
								}
							}
						</ol>
					}
				</section>
				<section class="run-sheet-section">
					<h2>Roster</h2>
					if len(rosterData.Positions) == 0 {
						<p class="muted">No positions configured for this plan.</p>
					} else if !anyPositionAssigned(rosterData.Positions) {
						<p class="muted">No one assigned yet.</p>
					} else {
						<!--
							Grouped by team like the roster builder page (see
							groupPositionsByTeam, roster_builder.templ) instead of a flat
							list of "Team / Position" headings - and, unlike the builder,
							unassigned positions are left off entirely: the run sheet is
							meant to show who's actually serving, not the gaps.
						-->
						for _, group := range groupPositionsByTeam(rosterData.Positions) {
							if teamGroupHasAssignments(group) {
								<div class="run-sheet-team-group">
									<h3 class="run-sheet-team-heading">{ group.TeamName }</h3>
									<div class="run-sheet-roster">
										for _, item := range group.Positions {
											{{ pos := item.Pos }}
											if len(pos.Assigned) > 0 {
												<div class="run-sheet-position">
													<h4>{ pos.TeamPositionName }</h4>
													<ul class="run-sheet-assigned">
														for _, a := range pos.Assigned {
															<li>{ a.Name }</li>
														}
													</ul>
													if open := pos.Quantity - len(pos.Assigned); open > 0 {
														<p class="run-sheet-short-handed">{ fmt.Sprintf("%d more needed", open) }</p>
													}
												</div>
											}
										}
									</div>
								</div>
							}
						}
					}
				</section>
			</div>
		</body>
	</html>
}
