package scheduling

import "fmt"

// BuildTab is one tab in buildTabs below - ID both selects the tab
// (matched against activeTab) and derives its aria-controls/onclick
// target ("build-tab-<ID>", "toggleBuildTab('<ID>')").
//
// LazyURL, when non-empty, marks this tab's content as not yet fetched
// (see pco-api-risks.md's mitigation #3) - its button fetches from this
// URL and swaps the result into "#build-tab-<ID>", starting as soon as
// the page itself has rendered (see lazyTabTrigger) rather than that data
// having already been built server-side for this same response. The
// point isn't to avoid the fetch, just to not block the active tab's own
// first paint on it - by the time the user actually looks at this tab, it
// has as much of a head start as the page can give it. Left "" for
// whichever tab is already active, since its content is already in the
// DOM.
type BuildTab struct {
	ID      string
	Label   string
	LazyURL string
}

// lazyTabTrigger is the hx-trigger every lazy tab button fires its fetch
// on. "load" fires immediately once the page itself has rendered - the
// earliest possible head start, since the deferred tab (Team, in
// practice - see pco-api-risks.md's mitigation #3) is usually the more
// expensive one, and a hover/focus-triggered fetch alone often didn't
// have time to finish before the user actually clicked over. mouseenter/
// focus/click stay as fallback triggers, each with its own independent
// "once": if the load-triggered fetch somehow failed (a network hiccup),
// a later hover/focus/click is still a fresh, working attempt rather than
// silently never retrying - not just redundant insurance for the normal
// case, which "load" alone would already cover.
const lazyTabTrigger = "load once, mouseenter once, focus once, click once"

// tabButtonAttrs builds one tab button's full attribute set: the plain
// client-side toggleBuildTab onclick every tab gets, plus - only when
// LazyURL is set - the hx-get/hx-trigger/hx-target/hx-swap that fetches
// its real content once. A plain Go func rather than inline templ
// conditionals since templ can't attach some attributes to an element
// conditionally and others unconditionally within one tag.
func tabButtonAttrs(t BuildTab) templ.Attributes {
	attrs := templ.Attributes{"onclick": fmt.Sprintf("toggleBuildTab('%s')", t.ID)}
	if t.LazyURL != "" {
		attrs["hx-get"] = t.LazyURL
		attrs["hx-trigger"] = lazyTabTrigger
		attrs["hx-target"] = "#build-tab-" + t.ID
		attrs["hx-swap"] = "innerHTML"
	}
	return attrs
}

// buildTabs renders the Build page's tab-button row - factored out so the
// tab/aria-selected/aria-controls/active-class quartet can't drift out of
// sync with each other by hand if a third tab is ever added. activeTab
// must already be normalized to one of the tabs' own IDs (see BuildPlan,
// which maps any unrecognized value to "songs" before calling this) -
// this just does the equality check, it doesn't pick a default itself.
templ buildTabs(tabs []BuildTab, activeTab string) {
	<div class="build-tabs" role="tablist">
		for _, t := range tabs {
			<button type="button" id={ "build-tab-button-" + t.ID } class={ "build-tab", templ.KV("active", t.ID == activeTab) } role="tab" aria-selected={ fmt.Sprintf("%t", t.ID == activeTab) } aria-controls={ "build-tab-" + t.ID } { tabButtonAttrs(t)... }>{ t.Label }</button>
		}
	</div>
}
