package scheduling

import (
	"fmt"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ Build(personName, organizationName string, serviceTypes []pco.ServiceTypeData, selectedServiceTypeID string, initialPlans []PlanRow, page, totalPages int, errMsg string) {
	@views.Layout("Build a Service", personName, organizationName) {
		<h1>Build a Service</h1>
		<p class="muted">Pick a service type, then an upcoming plan, to build its song lineup and fill its team - both on one page.</p>
		<form class="inline" hx-get="/scheduling/build/plans" hx-target="#build-plans" hx-swap="outerHTML">
			<label>
				Service type
				<select name="service_type_id">
					if selectedServiceTypeID == "" {
						<option value="" selected disabled>Choose a service type</option>
					}
					for _, st := range serviceTypes {
						if st.ID == selectedServiceTypeID {
							<option value={ st.ID } selected>{ st.Attributes.Name }</option>
						} else {
							<option value={ st.ID }>{ st.Attributes.Name }</option>
						}
					}
				</select>
			</label>
			<button type="submit" class="primary">Show upcoming plans</button>
		</form>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@BuildPlansList(initialPlans, selectedServiceTypeID, "", page, totalPages, "")
	}
}

// BuildPlansList is the htmx swap target (id="build-plans") for the service
// type picker above - it lists that service type's upcoming plans, each
// linking straight into its combined builder, tagged with its song lineup
// status and its team status independently (see the scheduling
// controller's planStatus/rosterStatus) - a plan can be fully planned on
// one and still todo on the other.
//
// Search and pagination both go through this one <form>'s own hx-get,
// triggered only by a real submit (Enter, the Search button, or a
// pagination button) - never by hx-get on an individual input/button of
// its own. Per-element hx-get inside a form turned out to be unreliable
// here for both the live-search-on-type box and the pagination buttons
// (missing params in practice); routing everything through one native
// form submission sidesteps that entirely, since a submitted form's own
// fields - including whichever submit button was actually clicked, see
// BuildPlansResults' page buttons below - are always included, no
// per-element htmx wiring to get subtly wrong.
templ BuildPlansList(plans []PlanRow, serviceTypeID, search string, page, totalPages int, errMsg string) {
	<div id="build-plans">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		if serviceTypeID != "" {
			<!--
				Deliberately not class="inline" - that class flex-rows its
				children (label+input+button, side by side) once the
				viewport is wide enough, which is right for the multi-field
				setup-page forms it was built for but wrong here: it would
				squeeze #build-plans-results (the list) into a narrow column
				beside the search box instead of stacking full-width below
				it. This form only has a couple of small fields, so plain
				block flow (search row, then the list beneath it) is what
				we want.
			-->
			<form
				hx-get="/scheduling/build/plans/search"
				hx-target="#build-plans-results"
				hx-swap="innerHTML"
			>
				<input type="hidden" name="service_type_id" value={ serviceTypeID }/>
				<div class="search-bar">
					<input
						type="text"
						id="build-plans-search"
						placeholder="Search by plan title or date..."
						autocomplete="off"
						value={ search }
						name="search"
					/>
					<button type="submit">Search</button>
				</div>
				<div id="build-plans-results">
					@BuildPlansResults(plans, serviceTypeID, search, page, totalPages, "")
				</div>
			</form>
		}
	</div>
}

// BuildPlansResults is #build-plans-results' content - the plan list plus
// pagination, re-rendered whenever BuildPlansList's <form> is submitted
// (see its doc comment for why every trigger here is a real submit, not a
// per-element hx-get). The Prev/Next buttons are plain submit buttons
// named "page" - clicking one submits the enclosing form with that
// button's own value included alongside every other field, exactly like
// clicking Search does, just requesting a different page of the same
// search instead of a fresh one.
templ BuildPlansResults(plans []PlanRow, serviceTypeID, search string, page, totalPages int, errMsg string) {
	if errMsg != "" {
		<p class="error">{ errMsg }</p>
	}
	<ul class="plan-list">
		for _, plan := range plans {
			<li>
				<a href={ templ.URL("/scheduling/build/" + serviceTypeID + "/" + plan.ID) }>
					if plan.Title != "" {
						{ plan.Title }
					} else {
						{ plan.Dates }
					}
				</a>
				if plan.Title != "" {
					<span class="muted">{ plan.Dates }</span>
				}
				<span class="badge-label">Songs</span>
				@components.PlanStatusBadge(plan.SetStatus)
				<span class="badge-label">Team</span>
				@components.PlanStatusBadge(plan.RosterStatus)
			</li>
		}
		if len(plans) == 0 {
			<li class="muted">No upcoming plans found.</li>
		}
	</ul>
	if totalPages > 1 {
		<div class="pagination">
			<button
				type="submit"
				name="page"
				value={ fmt.Sprintf("%d", page-1) }
				disabled?={ page <= 1 }
			>&larr; Prev</button>
			<span class="muted">{ fmt.Sprintf("Page %d of %d", page, totalPages) }</span>
			<button
				type="submit"
				name="page"
				value={ fmt.Sprintf("%d", page+1) }
				disabled?={ page >= totalPages }
			>Next &rarr;</button>
		</div>
	}
}

// BuildPlan is one plan's combined builder - the song order of service and
// the team, stacked on one page under a shared heading/back-link, instead
// of two separate pages. Each section (@SetBuilderBody/@RosterBuilderBody)
// is fully self-contained, including its own <h2> and its own htmx swap
// target, so interacting with one never touches the other.
//
// activeTab is "songs" or "team" (see BuildPlanPage's ?tab= query param) -
// rendered server-side so a direct link to ?tab=team lands there with no
// JS flash of the Songs tab first, rather than relying entirely on
// toggleBuildTab (scheduling.js) to sort it out after the page loads.
templ BuildPlan(personName, organizationName string, setData SetBuilderData, rosterData RosterBuilderData, activeTab string) {
	@views.Layout("Build a Service", personName, organizationName) {
		<h1>
			if setData.PlanTitle != "" {
				{ setData.PlanTitle }
			} else if setData.PlanDates != "" {
				{ setData.PlanDates }
			} else {
				Service
			}
		</h1>
		if setData.PlanTitle != "" && setData.PlanDates != "" {
			<p class="muted">{ setData.PlanDates }</p>
		}
		<div class="build-page-nav">
			<a href="/scheduling/build">&larr; Choose a different plan</a>
			<div class="build-page-nav-links">
				<a href={ templ.URL(pcoPlanURL(setData.PlanID)) } target="_blank" rel="noopener">Open in Planning Center ↗</a>
				<a href={ templ.URL(fmt.Sprintf("/scheduling/build/%s/%s/run-sheet", setData.ServiceTypeID, setData.PlanID)) } target="_blank" rel="noopener">Run sheet ↗</a>
			</div>
		</div>
		<!--
			Songs and Team are two independently-interactive builders (each
			with its own htmx swap target, see SetBuilderBody/RosterBuilderBody)
			that used to just stack on one long page. Splitting them into tabs
			cuts what's on screen at once roughly in half without changing
			either builder's markup or behavior at all - switching is a plain
			client-side hidden toggle (toggleBuildTab, scheduling.js), so both
			panels still fully server-render on every page load exactly as
			before.

			The sidebar (.build-glance) is the one thing that isn't just "the
			inactive tab, hidden" - it's a standing glance at whichever tab
			*isn't* open, so switching over just to check "is the roster
			filled yet, and by whom?" while heads-down on songs isn't
			necessary. Each card pairs the same SongStatusSummary/
			RosterStatusSummary chips SetBuilderBody/RosterBuilderBody
			already show at the top of their own tab (so there's no separate
			counting logic to keep in sync) with the actual content -
			SongGlanceList's song order, TeamGlanceList's names per position -
			since the counts alone don't say *what's* in the lineup or *who's*
			on it. Only one of the two cards is ever visible at a time
			(toggleBuildTab shows whichever one belongs to the tab that just
			went hidden).
		-->
		<!--
			normalizedTab mirrors activeTab's own "anything but 'team' means
			Songs" default, just for buildTabs' equality check - every other
			activeTab comparison on this page (hidden?/publish panels below)
			keeps using activeTab directly and is unaffected.
		-->
		{{ normalizedTab := "songs" }}
		if activeTab == "team" {
			{{ normalizedTab = "team" }}
		}
		<div class="build-layout">
			<div class="build-main">
				@buildTabs([]BuildTab{{ID: "songs", Label: "Songs"}, {ID: "team", Label: "Team"}}, normalizedTab)
				<div class="build-tab-panel" id="build-tab-songs" role="tabpanel" hidden?={ activeTab == "team" }>
					@SetBuilderBodyContent(setData)
				</div>
				<div class="build-tab-panel" id="build-tab-team" role="tabpanel" hidden?={ activeTab != "team" }>
					@RosterBuilderBodyContent(rosterData)
				</div>
			</div>
			<!--
				The publish/discard controls live here too, not inline under
				each tab's own table - but only the open tab's, unlike the
				glance cards below (which show the *other* tab). See
				SongPublishPanel/RosterPublishPanel's own doc comments for how
				they stay synced via htmx out-of-band swaps even though the
				forms that trigger those swaps live in the (structurally
				separate) tab panels beside them, not inside these cards.
			-->
			<aside class="build-glance">
				@SongPublishPanel(setData, activeTab == "team")
				@SongDetailCards(setData, activeTab == "team")
				@RosterPublishPanel(rosterData, activeTab != "team")
				@PersonDetailCards(rosterData, activeTab != "team")
				@glanceCardShell("build-glance-team", activeTab == "team") {
					<h3>Team, at a glance</h3>
					@RosterStatusSummary(rosterData)
					@TeamGlanceList(rosterData.Positions)
					<button type="button" onclick="toggleBuildTab('team')">Switch to Team</button>
				}
				@glanceCardShell("build-glance-songs", activeTab != "team") {
					<h3>Songs, at a glance</h3>
					@SongStatusSummary(setData)
					@SongGlanceList(setData.ServiceOrder)
					<button type="button" onclick="toggleBuildTab('songs')">Switch to Songs</button>
				}
			</aside>
		</div>
	}
}
