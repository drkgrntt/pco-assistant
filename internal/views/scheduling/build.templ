package scheduling

import (
	"fmt"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ Build(personName, organizationName string, serviceTypes []pco.ServiceTypeData, selectedServiceTypeID string, initialPlans []PlanRow, page, totalPages int, tab, errMsg string) {
	@views.Layout("Build a Service", personName, organizationName) {
		<h1>Build a Service</h1>
		<p class="muted">Pick a service type, then a plan, to build its song lineup and fill its team - both on one page.</p>
		<form class="inline" hx-get="/scheduling/build/plans" hx-target="#build-plans" hx-swap="outerHTML">
			<label>
				Service type
				<select name="service_type_id">
					if selectedServiceTypeID == "" {
						<option value="" selected disabled>Choose a service type</option>
					}
					for _, st := range serviceTypes {
						if st.ID == selectedServiceTypeID {
							<option value={ st.ID } selected>{ st.Attributes.Name }</option>
						} else {
							<option value={ st.ID }>{ st.Attributes.Name }</option>
						}
					}
				</select>
			</label>
			<button type="submit" class="primary">Show plans</button>
		</form>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@BuildPlansList(initialPlans, selectedServiceTypeID, "", page, totalPages, tab, "")
	}
}

// buildPlansTabBar switches BuildPlansList between its "upcoming" and
// "past" plans (see planTab, build.go) - a full server round trip via
// BuildPlans (not per-element client toggling like buildTabs/toggleBuildTab,
// the Songs/Team tab switcher on a single plan's own builder page),
// since switching tabs means fetching an entirely different set of plans
// from Planning Center, not just showing/hiding something already on the
// page. Deliberately its own two plain buttons rather than
// BuildTab/buildTabs itself - that component is wired for the client-side
// toggle the Songs/Team split uses, not this tab bar's htmx round trip.
// Past plans are the archive this exists for at all (see the past-plans
// issue): sets/rosters are kept in local Postgres indefinitely after
// Publish, so every plan ever drafted here stays browsable, just read-only
// once it's actually happened - see SetBuilderData.ReadOnly.
//
// Styled as its own distinct segmented control (.plan-picker-tabs/
// .plan-picker-tab, components/build-tabs.css) rather than reusing
// .build-tabs/.build-tab, the Songs/Team split's underlined-text style: a
// user reported not noticing this bar existed at all despite it always
// rendering correctly once a service type is picked (confirmed live -
// see issues.md) - two small tabs visually near-identical to that other,
// unrelated tab switcher elsewhere on this same flow read as a lesser
// sibling of it rather than its own primary "which plans am I browsing"
// control. A filled pill for the active side plus an explicit aria-label
// (screen readers don't get the visual weight difference for free) both
// push in the same direction: more obviously its own thing.
templ buildPlansTabBar(serviceTypeID, tab string) {
	<div class="plan-picker-tabs" role="tablist" aria-label="Upcoming or past plans">
		<button
			type="button"
			class={ "plan-picker-tab", templ.KV("active", tab != "past") }
			role="tab"
			aria-selected={ fmt.Sprintf("%t", tab != "past") }
			hx-get={ fmt.Sprintf("/scheduling/build/plans?service_type_id=%s&tab=upcoming", serviceTypeID) }
			hx-target="#build-plans"
			hx-swap="outerHTML"
		>Upcoming plans</button>
		<button
			type="button"
			class={ "plan-picker-tab", templ.KV("active", tab == "past") }
			role="tab"
			aria-selected={ fmt.Sprintf("%t", tab == "past") }
			hx-get={ fmt.Sprintf("/scheduling/build/plans?service_type_id=%s&tab=past", serviceTypeID) }
			hx-target="#build-plans"
			hx-swap="outerHTML"
		>Past plans</button>
	</div>
}

// BuildPlansList is the htmx swap target (id="build-plans") for the service
// type picker above - it lists that service type's plans (upcoming or past,
// see buildPlansTabBar/tab), each linking straight into its combined
// builder, tagged with its song lineup status and its team status
// independently (see the scheduling controller's planStatus/rosterStatus) -
// a plan can be fully planned on one and still todo on the other.
//
// Search and pagination both go through this one <form>'s own hx-get,
// triggered only by a real submit (Enter, the Search button, or a
// pagination button) - never by hx-get on an individual input/button of
// its own. Per-element hx-get inside a form turned out to be unreliable
// here for both the live-search-on-type box and the pagination buttons
// (missing params in practice); routing everything through one native
// form submission sidesteps that entirely, since a submitted form's own
// fields - including whichever submit button was actually clicked, see
// BuildPlansResults' page buttons below - are always included, no
// per-element htmx wiring to get subtly wrong.
templ BuildPlansList(plans []PlanRow, serviceTypeID, search string, page, totalPages int, tab, errMsg string) {
	<div id="build-plans">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		if serviceTypeID != "" {
			@buildPlansTabBar(serviceTypeID, tab)
			<!--
				Deliberately not class="inline" - that class flex-rows its
				children (label+input+button, side by side) once the
				viewport is wide enough, which is right for the multi-field
				setup-page forms it was built for but wrong here: it would
				squeeze #build-plans-results (the list) into a narrow column
				beside the search box instead of stacking full-width below
				it. This form only has a couple of small fields, so plain
				block flow (search row, then the list beneath it) is what
				we want.
			-->
			<form
				hx-get="/scheduling/build/plans/search"
				hx-target="#build-plans-results"
				hx-swap="innerHTML"
			>
				<input type="hidden" name="service_type_id" value={ serviceTypeID }/>
				<!--
					Carries the currently-active tab forward on every Search/
					Prev/Next submit from within this same form - see planTab
					(build.go) and buildPlansTabBar above, which switches tabs
					via its own separate hx-get (outside this form) rather than
					a field inside it, since a tab switch is a clean slate
					(fresh search, page 1), not something this form's own
					submit should ever carry.
				-->
				<input type="hidden" name="tab" value={ tab }/>
				<div class="search-bar">
					<input
						type="text"
						id="build-plans-search"
						placeholder="Search by plan title, date, or note..."
						autocomplete="off"
						value={ search }
						name="search"
					/>
					<button type="submit">Search</button>
				</div>
				<div id="build-plans-results">
					@BuildPlansResults(plans, serviceTypeID, search, page, totalPages, tab, "")
				</div>
			</form>
		}
	</div>
}

// BuildPlansResults is #build-plans-results' content - the plan list plus
// pagination, re-rendered whenever BuildPlansList's <form> is submitted
// (see its doc comment for why every trigger here is a real submit, not a
// per-element hx-get). The Prev/Next buttons are plain submit buttons
// named "page" - clicking one submits the enclosing form with that
// button's own value included alongside every other field, exactly like
// clicking Search does, just requesting a different page of the same
// search instead of a fresh one.
templ BuildPlansResults(plans []PlanRow, serviceTypeID, search string, page, totalPages int, tab, errMsg string) {
	if errMsg != "" {
		<p class="error">{ errMsg }</p>
	}
	<ul class="plan-list">
		for _, plan := range plans {
			<li>
				<a href={ templ.URL("/scheduling/build/" + serviceTypeID + "/" + plan.ID) }>
					if plan.Title != "" {
						{ plan.Title }
					} else {
						{ plan.Dates }
					}
				</a>
				if plan.Title != "" {
					<span class="muted">{ plan.Dates }</span>
				}
				<span class="badge-label">Songs</span>
				@components.PlanStatusBadge(plan.SetStatus)
				<span class="badge-label">Team</span>
				@components.PlanStatusBadge(plan.RosterStatus)
				@planNoteText(plan.Note)
			</li>
		}
		if len(plans) == 0 {
			if tab == "past" {
				<li class="muted">No past plans found.</li>
			} else {
				<li class="muted">No upcoming plans found.</li>
			}
		}
	</ul>
	if totalPages > 1 {
		<div class="pagination">
			<button
				type="submit"
				name="page"
				value={ fmt.Sprintf("%d", page-1) }
				disabled?={ page <= 1 }
			>&larr; Prev</button>
			<span class="muted">{ fmt.Sprintf("Page %d of %d", page, totalPages) }</span>
			<button
				type="submit"
				name="page"
				value={ fmt.Sprintf("%d", page+1) }
				disabled?={ page >= totalPages }
			>Next &rarr;</button>
		</div>
	}
}

// planNoteText is a plan's local at-a-glance note (see plan_notes/
// GetPlanNote) rendered as plain, read-only text - used by the plan-list
// row (BuildPlansResults), where there's no room for a per-row editable
// form (see PlanNoteFormFragment's own doc comment for where that lives
// instead). "" renders nothing at all, since a blank note carries no
// information worth taking up row space for.
templ planNoteText(note string) {
	if note != "" {
		<span class="muted plan-note-text">{ note }</span>
	}
}

// PlanNoteFormFragment is the plan builder page's small editor for this
// plan's purely-local at-a-glance note (see plan_notes/GetPlanNote and
// planNoteSection below) - a plain text input plus a Save button, same
// "explicit save, not save-on-blur" convention as keyForm/descriptionForm
// (song_detail_card.templ). hx-target="this" swaps only this form on save
// (see UpdatePlanNote, build.go), so saving a note never disturbs the rest
// of the page. Unlike Publish/Discard/PCO-sync, saving a note never
// touches Planning Center, so it's never gated by SetBuilderData.ReadOnly
// - this form renders (and stays editable) even on a past plan.
//
// status reports the outcome of the save that produced this render -
// "" (the initial page load, no save has happened yet), "saved" (the
// success case, UpdatePlanNote's happy path), or "error" (UpdatePlanNote's
// upsert failed and reverted the input to whatever was actually saved
// before). Before this, submitting the form gave no feedback at all
// either way - a plain button click with nothing to show it had (or
// hadn't) taken. The "saved" indicator self-dismisses (plan-note-status-
// saved's CSS fade, no JS/timer needed - see build-page.css) since it's
// just a confirmation of what the input already shows; the "error" one
// doesn't, since the user needs to actually notice and retry.
templ PlanNoteFormFragment(serviceTypeID, planID, note, status string) {
	<form class="plan-note-form" hx-post={ fmt.Sprintf("/scheduling/build/plans/%s/%s/note", serviceTypeID, planID) } hx-target="this" hx-swap="outerHTML">
		<input
			type="text"
			id="build-plan-note"
			name="note"
			value={ note }
			placeholder="Add a note (e.g. the one with the guest speaker)..."
			class="plan-note-input"
			autocomplete="off"
			aria-label="Note"
		/>
		<button type="submit" class="icon-btn" aria-label="Save note" title="Save note">
			@components.IconEdit()
		</button>
		if status == "saved" {
			<span class="plan-note-status plan-note-status-saved" role="status">Saved</span>
		}
		if status == "error" {
			<span class="plan-note-status plan-note-status-error" role="alert">Couldn't save - try again</span>
		}
	</form>
}

// planNoteSection is the plan builder page's one spot for this plan's
// local at-a-glance note (see plan_notes/GetPlanNote) - moved here, once,
// from the plan-list row it used to render in (see PlanNoteFormFragment's
// prior doc comment in git history) since there's exactly one note per
// plan, not one per row-in-a-list-of-many or one per Songs/Team tab. Placed
// below build-page-nav, after the title/dates/quick-links, rather than
// competing with them for the very top of the page - and collapsed by
// default (via collapsibleSection, same primitive songDetailCard's own
// "Category notes" uses) since most weeks there's nothing here at all;
// open=true only when a note already exists, so it's still visible on load
// rather than hidden behind a click.
//
// Unlike this page's other mutating actions (Publish/Discard/PCO-sync,
// gated by SetBuilderData.ReadOnly - see BuildPlan), this note stays
// editable on a past plan too: UpsertPlanNote is purely local storage,
// never touches PCO, and labeling a plan after the fact ("oh, that was
// the guest speaker week") is exactly what makes the note useful for
// finding that plan again later in the picker list - no reason to lock
// it just because the service already happened.
templ planNoteSection(serviceTypeID, planID, note string) {
	@collapsibleSection("plan-note-section", "Note", note != "") {
		@PlanNoteFormFragment(serviceTypeID, planID, note, "")
	}
}

// BuildPlan is one plan's combined builder - the song order of service and
// the team, stacked on one page under a shared heading/back-link, instead
// of two separate pages. Each section (@SetBuilderBody/@RosterBuilderBody)
// is fully self-contained, including its own <h2> and its own htmx swap
// target, so interacting with one never touches the other.
//
// activeTab is "songs" or "team" (see BuildPlanPage's ?tab= query param) -
// rendered server-side so a direct link to ?tab=team lands there with no
// JS flash of the Songs tab first, rather than relying entirely on
// toggleBuildTab (scheduling.js) to sort it out after the page loads.
//
// note is this plan's local at-a-glance note (see plan_notes/GetPlanNote),
// fetched once by BuildPlanPage regardless of activeTab and rendered by
// planNoteSection above - a separate parameter rather than a field on
// SetBuilderData/RosterBuilderData since it's one value per plan, not
// per-tab data either struct otherwise holds.
//
// Only activeTab's own data is actually built by BuildPlanPage - see
// pco-api-risks.md's mitigation #3. The *other* tab's SetBuilderData/
// RosterBuilderData argument here is a zero value except for
// ServiceTypeID/PlanID (BuildPlanPage copies those across regardless of
// which tab built for real, so this header and tabPanelLazyAttrs' fetch
// URLs always have something to point at). Every place below that reads from
// the inactive tab's data is guarded by an `if activeTab == ...` check
// mirroring which one is real - the zero value is never actually
// rendered, only ever sitting there inert until the lazy fetch below
// replaces it.
templ BuildPlan(personName, organizationName string, setData SetBuilderData, rosterData RosterBuilderData, activeTab, note string) {
	@views.Layout("Build a Service", personName, organizationName) {
		<div class="build-page-title-row">
			<div>
				<h1>
					if setData.PlanTitle != "" {
						{ setData.PlanTitle }
					} else if setData.PlanDates != "" {
						{ setData.PlanDates }
					} else {
						Service
					}
				</h1>
				if setData.PlanTitle != "" && setData.PlanDates != "" {
					<p class="muted">{ setData.PlanDates }</p>
				}
			</div>
			if setData.PrevPlanID != "" || setData.NextPlanID != "" {
				<div class="plan-stepper" role="group" aria-label="Adjacent plans">
					if setData.PrevPlanID != "" {
						<a class="plan-stepper-btn" href={ templ.URL(adjacentPlanURL(setData.ServiceTypeID, setData.PrevPlanID, activeTab)) } aria-label="Previous plan" title="Previous plan">
							@components.IconChevronLeft()
						</a>
					} else {
						<span class="plan-stepper-btn plan-stepper-btn-disabled" aria-hidden="true">
							@components.IconChevronLeft()
						</span>
					}
					if setData.NextPlanID != "" {
						<a class="plan-stepper-btn" href={ templ.URL(adjacentPlanURL(setData.ServiceTypeID, setData.NextPlanID, activeTab)) } aria-label="Next plan" title="Next plan">
							@components.IconChevronRight()
						</a>
					} else {
						<span class="plan-stepper-btn plan-stepper-btn-disabled" aria-hidden="true">
							@components.IconChevronRight()
						</span>
					}
				</div>
			}
		</div>
		if setData.ReadOnly {
			<p>@components.BadgeTitled("status-pending", "Past plan - read only", "This plan has already happened - shown for reference, no Publish/Discard/PCO-sync actions available")</p>
		}
		<div class="build-page-nav">
			<div class="build-page-nav-primary">
				<a href={ templ.URL(fmt.Sprintf("/scheduling/build?service_type_id=%s", setData.ServiceTypeID)) }>&larr; Choose a different plan</a>
			</div>
			<div class="build-page-nav-links">
				<a href={ templ.URL(pcoPlanURL(setData.PlanID)) } target="_blank" rel="noopener">Open in Planning Center ↗</a>
				<a href={ templ.URL(fmt.Sprintf("/scheduling/build/%s/%s/run-sheet", setData.ServiceTypeID, setData.PlanID)) } target="_blank" rel="noopener">Run sheet ↗</a>
			</div>
		</div>
		@planNoteSection(setData.ServiceTypeID, setData.PlanID, note)
		<!--
			Songs and Team are two independently-interactive builders (each
			with its own htmx swap target, see SetBuilderBody/RosterBuilderBody)
			that used to just stack on one long page. Splitting them into tabs
			cuts what's on screen at once roughly in half - switching is a
			plain client-side hidden toggle (toggleBuildTab, scheduling.js).

			Only the active tab's builder actually server-rendered above (see
			pco-api-risks.md's mitigation #3) - the inactive one shows a
			loading placeholder here instead, and fetches its real content
			starting as soon as this page itself has rendered (a "load"
			hx-trigger, not gated on the user hovering/clicking its tab button
			first - see tabPanelLazyAttrs/lazyTabTrigger below), so it's got as
			much of a head start as possible by the time the user actually
			looks at it. hx-get/hx-trigger live on the tab panel itself, not
			the tab button - see tabPanelLazyAttrs' own doc comment for why
			that's not just a style choice (a real bug: scheduling.js's
			app-wide htmx-request feedback disables whatever element a
			request is attached to, and it can't tell this "load" from a real
			click - putting it on the button left the button unclickable for
			as long as the background fetch was still running). Its own tab
			panel and its sidebar glance card below both fill in together
			once that fetch resolves (SetBuilderBodyLazy/RosterBuilderBodyLazy,
			set_builder.templ/roster_builder.templ).

			That fetch can still be in flight when the user switches tabs by
			hand (the whole reason it's deferred at all is that it's usually
			the slower tab) - its own out-of-band fragments only know
			whether this tab was still inactive when the *request* went out,
			so landing after a manual switch would otherwise stamp that
			stale hidden state right back over whatever toggleBuildTab just
			set. scheduling.js's syncBuildTabVisibility/currentBuildTab
			closes that race by re-deriving every tab-scoped element's
			hidden state from whichever tab is actually aria-selected right
			now, after every htmx swap settles - not just after a click - so
			hidden state stays correct regardless of which of the two
			(click vs. background fetch) finishes last.

			The sidebar (.build-glance) is the one thing that isn't just "the
			inactive tab, hidden" - it's a standing glance at whichever tab
			*isn't* open, so switching over just to check "is the roster
			filled yet, and by whom?" while heads-down on songs isn't
			necessary. Each card pairs the same SongStatusSummary/
			RosterStatusSummary chips SetBuilderBody/RosterBuilderBody
			already show at the top of their own tab (so there's no separate
			counting logic to keep in sync) with the actual content -
			SongGlanceList's song order, TeamGlanceList's names per position -
			since the counts alone don't say *what's* in the lineup or *who's*
			on it. Only one of the two cards is ever visible at a time
			(toggleBuildTab shows whichever one belongs to the tab that just
			went hidden) - and since it's the *other* tab's data it always
			needs, it carries the same loading-placeholder treatment as that
			tab's own main panel until the lazy fetch above fills it in too.
		-->
		<!--
			normalizedTab mirrors activeTab's own "anything but 'team' means
			Songs" default, just for buildTabs' equality check - every other
			activeTab comparison on this page (hidden?/publish panels below)
			keeps using activeTab directly and is unaffected.
		-->
		{{ normalizedTab := "songs" }}
		if activeTab == "team" {
			{{ normalizedTab = "team" }}
		}
		<div class="build-layout">
			<div class="build-main">
				@buildTabs([]BuildTab{{ID: "songs", Label: "Songs"}, {ID: "team", Label: "Team"}}, normalizedTab)
				<div class="build-tab-panel" id="build-tab-songs" role="tabpanel" hidden?={ activeTab == "team" } { tabPanelLazyAttrs(lazyTabURL(activeTab != "team", setData.ServiceTypeID, setData.PlanID, "songs"))... }>
					if activeTab == "team" {
						@buildTabLoadingSkeleton()
					} else {
						@SetBuilderBodyContent(setData)
					}
				</div>
				<div class="build-tab-panel" id="build-tab-team" role="tabpanel" hidden?={ activeTab != "team" } { tabPanelLazyAttrs(lazyTabURL(activeTab == "team", rosterData.ServiceTypeID, rosterData.PlanID, "team"))... }>
					if activeTab != "team" {
						@buildTabLoadingSkeleton()
					} else {
						@RosterBuilderBodyContent(rosterData)
					}
				</div>
			</div>
			<!--
				The publish/discard controls live here too, not inline under
				each tab's own table - but only the open tab's, unlike the
				glance cards below (which show the *other* tab). See
				SongPublishPanel/RosterPublishPanel's own doc comments for how
				they stay synced via htmx out-of-band swaps even though the
				forms that trigger those swaps live in the (structurally
				separate) tab panels beside them, not inside these cards.
			-->
			<aside class="build-glance">
				@SongPublishPanel(setData, activeTab == "team")
				@SongDetailCards(setData, activeTab == "team")
				@RosterPublishPanel(rosterData, activeTab != "team")
				@PersonDetailCards(rosterData, activeTab != "team")
				@glanceCardShell("build-glance-team", activeTab == "team") {
					if activeTab == "team" {
						@rosterGlanceContent(rosterData)
					} else {
						<h3>Team, at a glance</h3>
						@buildTabLoadingSkeleton()
					}
				}
				@glanceCardShell("build-glance-songs", activeTab != "team") {
					if activeTab != "team" {
						@songGlanceContent(setData)
					} else {
						<h3>Songs, at a glance</h3>
						@buildTabLoadingSkeleton()
					}
				}
			</aside>
		</div>
	}
}

// buildTabLoadingSkeleton is the placeholder shown in a tab panel or
// glance card whose data hasn't been fetched yet - see BuildPlan's own
// comment on the lazy-load flow above.
templ buildTabLoadingSkeleton() {
	<p class="muted">Loading…</p>
}

// lazyTabURL returns the URL a deferred tab's panel should lazy-fetch
// from, or "" (no fetch) when eager is true - eager means this tab's data
// was already built server-side (it's the active tab), so there's nothing
// to fetch. Small wrapper around fmt.Sprintf so BuildPlan's panel divs
// stay readable with two of these side by side.
func lazyTabURL(eager bool, serviceTypeID, planID, tab string) string {
	if eager {
		return ""
	}
	return fmt.Sprintf("/scheduling/build/%s/%s/%s-tab", serviceTypeID, planID, tab)
}

// tabPanelLazyAttrs returns the hx-get/hx-trigger/hx-swap a deferred tab's
// panel div needs to fetch its own real content, or nil when lazyURL == ""
// (this tab is already active/eager). Deliberately attached to the panel
// div, not the tab button, even though the button is what tabButtonAttrs
// keeps ownership of onclick for: scheduling.js's app-wide htmx-request
// feedback (see its own doc comment) disables whatever element
// event.detail.elt points at for the duration of any htmx request,
// entirely by matching it against "button, input[type=submit]" - it has
// no way to distinguish a genuine user click from an automatic "load"
// trigger firing on page render. Putting hx-get on the tab button meant
// the very first load-triggered fetch (the whole point of
// lazyTabTrigger's "load" clause) disabled that button for as long as the
// fetch was in flight - unclickable, not even dimmed, for exactly the
// window this deferred fetch exists to cover, since that's usually the
// slower of the two tabs. The panel div is never a <button>, and (at
// fetch time) never contains one either - it's still just
// buildTabLoadingSkeleton's <p> - so scheduling.js's check never matches
// it. No explicit hx-target: the default (the element hx-get lives on) is
// already the right one now that it's on the panel itself, and
// hx-swap="innerHTML" leaves this div's own id/hidden/role attributes -
// which toggleBuildTab/syncBuildTabVisibility still toggle by id,
// independent of this fetch - untouched.
func tabPanelLazyAttrs(lazyURL string) templ.Attributes {
	if lazyURL == "" {
		return nil
	}
	return templ.Attributes{
		"hx-get":     lazyURL,
