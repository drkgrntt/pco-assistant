package scheduling

import (
	"fmt"
	"strconv"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ Preferences(personName, organizationName string, songs []pco.SongData, preferences []scheduling.SongPersonPreference, preferenceTypes []scheduling.SongPreferenceType, songTitles map[string]string, personNames map[string]string, preferenceLabels map[string]string, errMsg string) {
	@views.Layout("Song Preferences", personName, organizationName) {
		<h1>Song / Person Preferences</h1>
		<p class="muted">Note which people are preferred or discouraged for a given song - pick the song from your Planning Center library and search for the person by name.</p>
		<form
			id="preference-form"
			class="inline"
			hx-post="/scheduling/song-preferences"
			hx-target="#preferences-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			<input type="hidden" name="id"/>
			<label>
				Song
				<select name="song_id" required>
					<option value="" selected disabled>Choose a song</option>
					for _, song := range songs {
						<option value={ song.ID }>{ song.Attributes.Title }</option>
					}
				</select>
			</label>
			@PersonPickerField("Person", "person_id", "")
			<label>
				Preference
				<select name="preference">
					for _, t := range preferenceTypes {
						<option value={ t.Code }>{ t.Label }</option>
					}
				</select>
			</label>
			<label>
				Notes
				<input type="text" name="notes"/>
			</label>
			<button type="submit" class="primary">Save</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@PreferencesTable(preferences, songTitles, personNames, preferenceLabels, errMsg)
	}
}

// PreferencesTable is both the initial-render fragment and the htmx swap
// target (id="preferences-table") - see RelationshipsTable for why errMsg
// lives inside it rather than the page around it. songTitles/personNames
// resolve a preference's raw PCO song/person IDs back to display values
// (see songTitleMap/personNameMap in the scheduling controller); an ID
// missing from its map falls back to showing the raw ID. preferenceLabels
// resolves a preference code to its song_preference_types label (see
// songPreferenceTypeLabelMap in the scheduling controller) the same way.
templ PreferencesTable(preferences []scheduling.SongPersonPreference, songTitles map[string]string, personNames map[string]string, preferenceLabels map[string]string, errMsg string) {
	<div id="preferences-table">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@components.SortableTableWrap() {
			<thead>
					<tr>
						<th>Song</th>
						<th>Person</th>
						<th>Preference</th>
						<th>Notes</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, pref := range preferences {
						<tr>
							<td>
								if title, ok := songTitles[pref.SongID]; ok {
									{ title }
								} else {
									{ pref.SongID }
								}
							</td>
							<td>
								if name, ok := personNames[pref.PersonID]; ok {
									{ name }
								} else {
									{ pref.PersonID }
								}
							</td>
							<td>{ displayNameOrID(preferenceLabels, pref.Preference) }</td>
							<td>{ pref.Notes }</td>
							<td>
								<button
									class="icon-btn"
									aria-label="Edit preference"
									title="Edit preference"
									data-edit-form="preference-form"
									data-edit-fields={ editFieldsAttr(map[string]string{
										"id":         strconv.FormatInt(pref.ID, 10),
										"song_id":    pref.SongID,
										"preference": pref.Preference,
										"notes":      pref.Notes,
									}) }
									data-edit-people={ editPeopleAttr(map[string]editPerson{
										"": {ID: pref.PersonID, Name: displayNameOrID(personNames, pref.PersonID)},
									}) }
									onclick="editRow(this)"
								>
									@components.IconEdit()
								</button>
								<button
									class="danger icon-btn"
									aria-label="Delete preference"
									title="Delete preference"
									hx-delete={ fmt.Sprintf("/scheduling/song-preferences/%d", pref.ID) }
									hx-target="#preferences-table"
									hx-swap="outerHTML"
									hx-confirm="Delete this preference?"
								>
									@components.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(preferences) == 0 {
						<tr>
							<td colspan="5" class="muted">No preferences set yet - note who's preferred or discouraged for a song so Build can suggest the right fit instead of a blank slate.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}
