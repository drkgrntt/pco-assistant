package scheduling

import (
	"fmt"
	"strconv"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ Relationships(personName, organizationName string, songs []pco.SongData, relationships []scheduling.SongRelationship, relationshipTypes []scheduling.SongRelationshipType, songTitles map[string]string, typeLabels map[string]string, errMsg string) {
	@views.Layout("Song Relationships", personName, organizationName) {
		@songRelationshipsHelp()
		<h1>Song Relationships</h1>
		<p class="muted">Relate songs to each other - e.g. "flows well lyrically" or "same theme" - picking from your Planning Center song library.</p>
		<form
			id="relationship-form"
			class="inline"
			hx-post="/scheduling/song-relationships"
			hx-target="#relationships-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			<input type="hidden" name="id"/>
			<label>
				Song A
				<select name="song_id_a" required>
					<option value="" selected disabled>Choose a song</option>
					for _, song := range songs {
						<option value={ song.ID }>{ song.Attributes.Title }</option>
					}
				</select>
			</label>
			<label>
				Song B
				<select name="song_id_b" required>
					<option value="" selected disabled>Choose a song</option>
					for _, song := range songs {
						<option value={ song.ID }>{ song.Attributes.Title }</option>
					}
				</select>
			</label>
			<label>
				Relationship
				<select name="relationship_type">
					for _, t := range relationshipTypes {
						<option value={ t.Code }>{ t.Label }</option>
					}
				</select>
			</label>
			<label>
				Notes
				<input type="text" name="notes"/>
			</label>
			<button type="submit" class="primary">Add</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@RelationshipsTable(relationships, songTitles, typeLabels, errMsg)
	}
}

// RelationshipsTable is both the initial-render fragment and the htmx swap
// target (id="relationships-table", matched by the form/delete buttons'
// hx-target above) - errMsg surfaces inline here so it shows up the same
// way whether this is a full page load or a partial swap. songTitles
// resolves a relationship's raw PCO song IDs back to display titles (see
// songTitleMap in the scheduling controller); an ID missing from the map
// (song deleted/hidden in PCO since the relationship was created) falls
// back to showing the raw ID. typeLabels resolves relationship_type codes
// to their song_relationship_types label the same way (see
// songRelationshipTypeLabelMap in the scheduling controller) - a code
// removed from that table since the relationship was created falls back to
// showing the raw code.
templ RelationshipsTable(relationships []scheduling.SongRelationship, songTitles map[string]string, typeLabels map[string]string, errMsg string) {
	<div id="relationships-table">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@components.SortableTableWrap() {
			<thead>
					<tr>
						<th>Song A</th>
						<th>Song B</th>
						<th>Type</th>
						<th>Notes</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, rel := range relationships {
						<tr>
							<td>
								if title, ok := songTitles[rel.SongIDA]; ok {
									{ title }
								} else {
									{ rel.SongIDA }
								}
							</td>
							<td>
								if title, ok := songTitles[rel.SongIDB]; ok {
									{ title }
								} else {
									{ rel.SongIDB }
								}
							</td>
							<td>{ displayNameOrID(typeLabels, rel.RelationshipType) }</td>
							<td>{ rel.Notes }</td>
							<td>
								<button
									class="icon-btn"
									aria-label="Edit relationship"
									title="Edit relationship"
									data-edit-form="relationship-form"
									data-edit-fields={ editFieldsAttr(map[string]string{
										"id":                strconv.FormatInt(rel.ID, 10),
										"song_id_a":         rel.SongIDA,
										"song_id_b":         rel.SongIDB,
										"relationship_type": rel.RelationshipType,
										"notes":             rel.Notes,
									}) }
									onclick="editRow(this)"
								>
									@components.IconEdit()
								</button>
								<button
									class="danger icon-btn"
									aria-label="Delete relationship"
									title="Delete relationship"
									hx-delete={ fmt.Sprintf("/scheduling/song-relationships/%d", rel.ID) }
									hx-target="#relationships-table"
									hx-swap="outerHTML"
									hx-confirm="Delete this relationship?"
								>
									@components.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(relationships) == 0 {
						<tr>
							<td colspan="5" class="muted">No relationships yet - add one to catch a bad pairing before it lands back to back, or get a flows-well suggestion while building a set.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}

// songRelationshipsHelp is this page's Help-triggered dialog (see
// scheduling-global.js's openPageHelp for the dispatch order that finds it, and
// docs/plans/in-progress/help-system-and-nav-consolidation-plan.md for why
// setup pages get one at all - a genuinely different mechanism from the
// Home/Build tours' auto-popping ones, so the "overbearing" objection that
// ruled out a per-page tour in the original onboarding plan doesn't apply
// here). One .tour-step, no dots or Back - a single step never needs
// in-dialog step navigation - so this is opened/closed via openHelpDialog/
// closeHelpDialog (scheduling-global.js) directly rather than
// createTourController, which exists specifically for the auto-open/
// dismissal-tracking machinery a Help-triggered, single-step dialog has no
// use for. .page-help-dialog is the class openPageHelp() looks for on a
// page with no tour of its own; reuses .tour-dialog for the same visual
// shell as the Home/Build tours, just with one step and (here) two buttons.
// The heading matches this page's own <h1> exactly, so the dialog clearly
// maps back to the page it opened from. Carries the same .tour-footnote
// line the Home/Build tours use ("Need this again later? Look for Help at
// the bottom of any page.") - closing this dialog and coming back to it
// (via the footer's Help button, openPageHelp) is exactly the point, not
// something to lose track of: read it, click out, go do something on this
// page, reopen it to pick back up.
//
// This one also carries an optional "Next: <page> ->" link, the first of a
// forward-only chain through all 8 setup-page dialogs that lets someone
// click through them in sequence like a full guided tour if they want,
// while "Got it" still just dismisses and stays put - opt-in only, nothing
// auto-advances. The chain order mirrors home.go's buildOnboardingChecklist
// exactly (Song Relationships -> Song Roles -> Song Tags -> Song Vocal
// Range -> Song/Person Preferences -> Person Relationships -> Position
// Preferences -> Vocal Range), the same grouping/order already used for the
// Home page's setup checklist - not a separately-invented sequence. One
// direction only (Derek's explicit call): each page's Next points at the
// following one, none has a Back: page 1 (here) gets a Next to page 2,
// pages 2-7 each get a Next to the following page, page 8 (Vocal Range, the
// person one) ends the chain with no Next at all, same as before this
// addition. The Home tour's own last step ("Get started", onboardingTour,
// home.templ) got the same "Next: Song Relationships ->" link right after
// this shipped, making it this chain's de facto step 0 - same mechanism,
// no changes needed here.
//
// The mechanism is a full page navigation, not an htmx swap or in-dialog
// step, so "click Next, land on the next page with its own Help dialog
// already open" needs a value that survives the navigation:
// setPageHelpForce() (scheduling-global.js) sets a one-shot sessionStorage flag
// from the Next link's onclick (no preventDefault - the plain <a href>
// navigation proceeds exactly as it would without the onclick at all), and
// a DOMContentLoaded listener on the destination page checks that flag
// once, clears it immediately, and calls openPageHelp() if it was set.
// Generalizes the same one-shot-handoff idea buildTourController's
// now-removed "buildTourForce"/forceBuildTourReplay one-off used for the
// Account page's old Build-tour replay link (see build.templ's buildTour
// doc comment) - that Build-specific copy is gone now that this shared
// version covers the same need.
templ songRelationshipsHelp() {
	<dialog id="song-relationships-help" class="tour-dialog page-help-dialog">
		<div class="tour-step">
			<h2>Song Relationships</h2>
			<p>
				Relate songs that flow well together, or that shouldn't land back
				to back. Build uses these to suggest what plays well next, and to
				flag a bad pairing before it lands back to back.
			</p>
		</div>
		<p class="muted tour-footnote">Need this again later? Look for Help at the bottom of any page.</p>
		<div class="tour-actions">
			<a class="button" href="/scheduling/song-roles" onclick="setPageHelpForce()">Next: Song Roles →</a>
			<button type="button" class="button primary" onclick="closeHelpDialog('song-relationships-help')">Got it</button>
		</div>
	</dialog>
}
