package scheduling

import (
	"fmt"
	"strings"
)

// statusChip is one pill in a builder's status-summary row - the first
// thing shown in both SetBuilderBody and RosterBuilderBody, so a viewer
// knows whether this plan actually needs their attention before scrolling
// through everything below. Shared between the two tabs so both use the
// exact same pill treatment. warn reuses the same --pending/--pending-
// subtle tinting .badge.status-pending already uses elsewhere on this
// page, so "something here needs attention" reads consistently rather
// than introducing a new color.
templ statusChip(label string, warn bool) {
	if warn {
		<span class="status-chip warn">{ label }</span>
	} else {
		<span class="status-chip">{ label }</span>
	}
}

// SongStatusSummary is the Songs tab's status-summary row - broken out of
// SetBuilderBody (which still renders it first, unchanged) so the Build
// page's "at a glance" sidebar can render the exact same chips a second
// time while the Team tab is the one actually open, instead of hand-
// duplicating the logic that decides which chips show.
templ SongStatusSummary(data SetBuilderData) {
	<div class="status-summary">
		@statusChip(fmt.Sprintf("Songs: %d", len(data.SetSongs)), false)
		if data.UnpublishedCount > 0 {
			@statusChip(fmt.Sprintf("Unpublished: %d", data.UnpublishedCount), true)
		}
		if data.PendingDeleteCount > 0 {
			@statusChip(fmt.Sprintf("Pending removal: %d", data.PendingDeleteCount), true)
		}
		if data.ReorderPending {
			@statusChip("Order changed", true)
		}
		if warnCount := len(data.ExistingConflicts) + len(data.RepeatWarnings) + len(data.PlanWarnings); warnCount > 0 {
			@statusChip(fmt.Sprintf("Warnings: %d", warnCount), true)
		}
	</div>
}

// RosterStatusSummary is the Team tab's status-summary row - see
// SongStatusSummary, which this mirrors for RosterBuilderBody.
templ RosterStatusSummary(data RosterBuilderData) {
	<div class="status-summary">
		@statusChip(fmt.Sprintf("Filled: %d/%d", len(data.Positions)-data.OpenPositionCount, len(data.Positions)), data.OpenPositionCount > 0)
		if data.UnpublishedCount > 0 {
			@statusChip(fmt.Sprintf("Unpublished: %d", data.UnpublishedCount), true)
		}
		if data.PendingDeleteCount > 0 {
			@statusChip(fmt.Sprintf("Pending removal: %d", data.PendingDeleteCount), true)
		}
		if len(data.ExistingConflicts) > 0 {
			@statusChip(fmt.Sprintf("Warnings: %d", len(data.ExistingConflicts)), true)
		}
	</div>
}

// assignedNames pulls out just the names from a position's assignments -
// TeamGlanceList's one non-trivial piece, so the comma-joined "who" a
// position shows can go through the same strings.Join(..., ", ") idiom
// CandidateSongView.ConflictTitles already uses elsewhere on this page,
// rather than hand-building the join inline.
func assignedNames(assigned []AssignmentView) []string {
	names := make([]string, len(assigned))
	for i, a := range assigned {
		names[i] = a.Name
	}
	return names
}

// songRowCount is how many of order's rows are actually songs (as opposed
// to headers/foreign PCO items) - SongGlanceList's empty-state check, since
// an order full of nothing but non-song items would otherwise render an
// empty <ol> with no explanation.
func songRowCount(order []ServiceOrderRow) int {
	n := 0
	for _, row := range order {
		if row.IsSong {
			n++
		}
	}
	return n
}

// SongGlanceList is the Songs glance card's content (see build.templ) -
// the set's actual song order, not just its counts, so checking "what's
// the lineup again?" from the Team tab doesn't require switching over.
// Deliberately built from ServiceOrder, not SetSongs: SetSong.Position is
// only a total order among the set's own songs, established by whatever
// order they were spliced in - it says nothing about where their anchor
// items actually fall relative to each other (see the comment on it in
// sets.go), so it can disagree with the order actually shown in the Songs
// tab's own table. ServiceOrder is that same merged, interleaved order the
// table itself renders from, with the non-song rows skipped here.
templ SongGlanceList(order []ServiceOrderRow) {
	<ol class="build-glance-list">
		for _, row := range order {
			if row.IsSong {
				<li>{ row.Song.Title }</li>
			}
		}
		if songRowCount(order) == 0 {
			<li class="muted">No songs yet.</li>
		}
	</ol>
}

// TeamGlanceList is the Team glance card's content (see build.templ) - one
// line per position, naming who's actually filling it (or "Open" when
// nobody is yet), the roster equivalent of SongGlanceList.
templ TeamGlanceList(positions []PositionGroupView) {
	<ul class="build-glance-list">
		for _, pos := range positions {
			<li>
				<span>{ pos.TeamPositionName }</span>
				if len(pos.Assigned) > 0 {
					<span class="muted">{ strings.Join(assignedNames(pos.Assigned), ", ") }</span>
				} else {
					<span class="muted">Open</span>
				}
			</li>
		}
		if len(positions) == 0 {
			<li class="muted">No positions yet.</li>
		}
	</ul>
}

// glanceCardShell/glanceCardShellOOB are the build-glance-card wrapper
// build.templ's initial render and the OOB refreshes below share - mirrors
// publishCardShell/publishCardShellOOB (publish_panel.templ), but inverted:
// a glance card is hidden while its *own* tab is the one open (it shows a
// standing look at the *other* tab - see build.templ's own comment), so
// unlike the publish shell's OOB variant (always visible), this one is
// always hidden - see songGlanceOOB's doc comment for why that's always
// the correct value, not a state-restoration problem.
templ glanceCardShell(id string, hidden bool) {
	<div class="build-glance-card" id={ id } hidden?={ hidden }>
		{ children... }
	</div>
}

templ glanceCardShellOOB(id string) {
	<div class="build-glance-card" id={ id } hidden hx-swap-oob="true">
		{ children... }
	</div>
}

// songGlanceOOB refreshes the "Songs, at a glance" sidebar card
// (build.templ) after any Songs-tab mutation - bundled into SetBuilderBody
// alongside songPublishPanelOOB/songDetailCardsOOB. Without this, adding/
// removing/reordering/duplicating a song left that card showing whatever
// it looked like at the last full page load until a hard refresh, since no
// Songs-tab response ever touched anything outside #set-builder-body.
//
// Always rendered hidden (glanceCardShellOOB), never conditionally: this
// card only ever shows the *other* tab's summary, so it's only ever
// supposed to be hidden at the exact moment a Songs-tab mutation is what
// triggered this render - the Songs tab has to already be the open one for
// that mutation to have happened at all. Same reasoning
// songPublishPanelOOB uses in reverse (always visible, since its own tab
// is the one that must be open for it to fire).
templ songGlanceOOB(data SetBuilderData) {
	@glanceCardShellOOB("build-glance-songs") {
		<h3>Songs, at a glance</h3>
		@SongStatusSummary(data)
		@SongGlanceList(data.ServiceOrder)
		<button type="button" onclick="toggleBuildTab('songs')">Switch to Songs</button>
	}
}

// rosterGlanceOOB is songGlanceOOB's people equivalent - see its doc
// comment, which this mirrors in full.
templ rosterGlanceOOB(data RosterBuilderData) {
	@glanceCardShellOOB("build-glance-team") {
		<h3>Team, at a glance</h3>
		@RosterStatusSummary(data)
		@TeamGlanceList(data.Positions)
		<button type="button" onclick="toggleBuildTab('team')">Switch to Team</button>
	}
}
