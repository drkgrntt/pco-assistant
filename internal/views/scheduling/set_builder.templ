package scheduling

import (
	"fmt"
	"strconv"
	"strings"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"

	pco "github.com/drkgrntt/go-pco"
)

// SetBuilderBody is both the initial-render fragment and the htmx swap
// target (id="set-builder-body") for every add/remove/move action below -
// the whole thing re-renders each time since adding or removing a song can
// change the current set, the recommendations (based on the last song
// added), and the candidate list's conflict warnings all at once.
templ SetBuilderBody(data SetBuilderData) {
	<div id="set-builder-body">
		if data.ErrMsg != "" {
			<p class="error">{ data.ErrMsg }</p>
		}
		if data.PublishMsg != "" {
			<p class="success">{ data.PublishMsg }</p>
		}
		<div class="status-summary">
			@statusChip(fmt.Sprintf("Songs: %d", len(data.SetSongs)), false)
			if data.UnpublishedCount > 0 {
				@statusChip(fmt.Sprintf("Unpublished: %d", data.UnpublishedCount), true)
			}
			if data.PendingDeleteCount > 0 {
				@statusChip(fmt.Sprintf("Pending removal: %d", data.PendingDeleteCount), true)
			}
			if data.ReorderPending {
				@statusChip("Order changed", true)
			}
			if warnCount := len(data.ExistingConflicts) + len(data.RepeatWarnings); warnCount > 0 {
				@statusChip(fmt.Sprintf("Warnings: %d", warnCount), true)
			}
		</div>
		for _, msg := range data.ExistingConflicts {
			<div class="warning">{ msg }</div>
		}
		for _, msg := range data.RepeatWarnings {
			<div class="warning">{ msg }</div>
		}
		if data.ImportableSongCount > 0 {
			<div class="import-banner">
				<p>
					{ fmt.Sprintf("Looks like this service is already planned in Planning Center - it has %d song(s).", data.ImportableSongCount) }
					Want to import them here so you can reorder, replace, or tag them?
				</p>
				<form
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
				>
					<button type="submit" class="primary">Import from Planning Center</button>
				</form>
			</div>
		}
		<!--
			A one-shot nudge, not a permanent fixture - only ever appears
			right after AddSetSong chains a song after another one (see
			views.SongPairPromptView, AddSetSong in sets.go), and disappears
			again the moment you do anything else, since no other mutation
			sets it. Lets "song A, then I add song B, and by the way these go
			together" get captured right where it happens, instead of
			re-picking both songs from scratch in the Quick add panel below -
			which stays around for relating songs that *aren't* adjacent, or
			after the fact.
		-->
		if data.SongPairPrompt != nil {
			<div class="import-banner">
				<p>
					{ fmt.Sprintf("Added %q right after %q - ", data.SongPairPrompt.NewSongTitle, data.SongPairPrompt.PreviousSongTitle) }
					want to remember how these two relate?
					<button type="button" class="icon-btn" aria-label="Dismiss" title="Dismiss" onclick="this.closest('.import-banner').remove()">
						@views.IconX()
					</button>
				</p>
				<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
					<input type="hidden" name="song_id_a" value={ data.SongPairPrompt.PreviousSongID }/>
					<input type="hidden" name="song_id_b" value={ data.SongPairPrompt.NewSongID }/>
					<label>
						Relationship
						<select name="relationship_type">
							for _, t := range data.RelationshipTypes {
								<option value={ t.Code } selected?={ t.Code == scheduling.RelationshipFlowsWell }>{ t.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="primary">Remember this</button>
				</form>
			</div>
		}
		<h2>Order of service</h2>
		<p class="muted">
			Everything Planning Center already has for this plan, with your songs
			placed where you've put them. Non-song items are shown for context
			only - this tool doesn't manage them. Drag a song's
			<span class="icon-inline">
				@views.IconDrag()
			</span>
			handle to move it anywhere in the order, including onto or past a
			section header.
		</p>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>#</th>
						<th>Item</th>
						<th>Tags</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for i, row := range data.ServiceOrder {
						if row.IsSong {
							<tr
								class="song-row"
								data-token={ fmt.Sprintf("row:%d", row.Song.ID) }
								data-row-id={ fmt.Sprintf("%d", row.Song.ID) }
								data-reposition-url={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/reposition", data.ServiceTypeID, data.PlanID, row.Song.ID) }
							>
								<td>
									<span class="row-number">
										<span class="drag-handle" title="Drag to reorder">
											@views.IconDrag()
										</span>
										{ strconv.Itoa(i + 1) }
									</span>
								</td>
								<td>
									{ row.Song.Title }
									if row.Song.ArrangementInfo != "" {
										<div class="muted">{ row.Song.ArrangementInfo }</div>
									}
								</td>
								<td>
									for _, role := range row.Song.Roles {
										<span class="badge">{ role.Label }</span>
									}
									if row.Song.Published {
										<span class="badge published">Published</span>
									}
									if row.Song.Moved {
										<span class="badge status-pending" title="Moved since it was last published">Moved</span>
									}
								</td>
								<td class="set-song-actions">
									<button
										type="button"
										class="icon-btn"
										aria-label="Duplicate song (e.g. reprise as the response)"
										title="Duplicate song (e.g. reprise as the response)"
										hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/duplicate", data.ServiceTypeID, data.PlanID, row.Song.ID) }
										hx-target="#set-builder-body"
										hx-swap="outerHTML"
									>
										@views.IconCopy()
									</button>
									<button
										type="button"
										class="danger icon-btn"
										aria-label="Remove from set"
										title="Remove from set"
										hx-delete={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d", data.ServiceTypeID, data.PlanID, row.Song.ID) }
										hx-target="#set-builder-body"
										hx-swap="outerHTML"
										hx-confirm="Remove this song from the set?"
									>
										@views.IconRemove()
									</button>
									if len(data.Candidates) > 0 {
										<form
											class="replace-form"
											hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/replace", data.ServiceTypeID, data.PlanID, row.Song.ID) }
											hx-target="#set-builder-body"
											hx-swap="outerHTML"
											hx-confirm={ fmt.Sprintf("Replace %q with the selected song?", row.Song.Title) }
										>
											<select name="song_id" required>
												<option value="" selected disabled>Replace with...</option>
												for _, cand := range data.Candidates {
													<option value={ cand.SongID }>{ cand.Title }</option>
												}
											</select>
											<button type="submit" class="icon-btn" aria-label="Replace song" title="Replace song">
												@views.IconEdit()
											</button>
										</form>
									}
									<!--
										Row-scoped access to the same 3 actions the Quick add
										panel below offers generically - see quick-action-row
										just below and openQuickAction/toggleRowMenu
										(scheduling.js). The song is already this row's, so
										unlike the panel's forms there's no song picker to fill
										in - just the category/relationship/role fields that
										actually vary. The panel itself stays, since it's still
										the only way to tag/relate/role a song that isn't in
										this order of service yet.
									-->
									<div class="row-menu">
										<button
											type="button"
											class="icon-btn row-menu-toggle"
											aria-haspopup="true"
											aria-expanded="false"
											aria-label="More actions for this song"
											title="More actions"
											onclick="toggleRowMenu(this)"
										>
											@views.IconMore()
										</button>
										<div class="row-menu-menu">
											<button type="button" onclick="openQuickAction(this, 'tag')">
												@views.IconTag()
												Tag this song
											</button>
											<button type="button" onclick="openQuickAction(this, 'relate')">
												@views.IconRelate()
												Relate to another song
											</button>
											<button type="button" onclick="openQuickAction(this, 'role')">
												@views.IconRole()
												Mark a role
											</button>
										</div>
									</div>
								</td>
							</tr>
							<tr class="quick-action-row" data-row-id={ fmt.Sprintf("%d", row.Song.ID) } data-action="tag" hidden>
								<td colspan="4">
									<div class="quick-action-panel">
										<p class="quick-action-heading">
											{ fmt.Sprintf("Tag %q", row.Song.Title) }
											<button type="button" class="icon-btn" aria-label="Close" title="Close" onclick="this.closest('tr').hidden = true">
												@views.IconX()
											</button>
										</p>
										<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-tags", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
											<input type="hidden" name="song_id" value={ row.Song.SongID }/>
											<label>
												Category
												<select name="category">
													for _, cat := range data.TagCategories {
														<option value={ cat.Code }>{ cat.Label }</option>
													}
												</select>
											</label>
											<label>
												Value
												<input type="text" name="value" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
											</label>
											<button type="submit" class="primary">Add tag</button>
										</form>
									</div>
								</td>
							</tr>
							<tr class="quick-action-row" data-row-id={ fmt.Sprintf("%d", row.Song.ID) } data-action="relate" hidden>
								<td colspan="4">
									<div class="quick-action-panel">
										<p class="quick-action-heading">
											{ fmt.Sprintf("Relate %q to...", row.Song.Title) }
											<button type="button" class="icon-btn" aria-label="Close" title="Close" onclick="this.closest('tr').hidden = true">
												@views.IconX()
											</button>
										</p>
										<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
											<input type="hidden" name="song_id_a" value={ row.Song.SongID }/>
											<label>
												Song
												<select name="song_id_b" required>
													<option value="" selected disabled>Choose a song</option>
													for _, song := range data.AllSongs {
														if song.ID != row.Song.SongID {
															<option value={ song.ID }>{ song.Attributes.Title }</option>
														}
													}
												</select>
											</label>
											<label>
												Relationship
												<select name="relationship_type">
													for _, t := range data.RelationshipTypes {
														<option value={ t.Code }>{ t.Label }</option>
													}
												</select>
											</label>
											<button type="submit" class="primary">Relate songs</button>
										</form>
									</div>
								</td>
							</tr>
							<tr class="quick-action-row" data-row-id={ fmt.Sprintf("%d", row.Song.ID) } data-action="role" hidden>
								<td colspan="4">
									<div class="quick-action-panel">
										<p class="quick-action-heading">
											{ fmt.Sprintf("Mark a role for %q", row.Song.Title) }
											<button type="button" class="icon-btn" aria-label="Close" title="Close" onclick="this.closest('tr').hidden = true">
												@views.IconX()
											</button>
										</p>
										<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-roles", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
											<input type="hidden" name="song_id" value={ row.Song.SongID }/>
											<label>
												Role
												<select name="role">
													for _, t := range data.RoleTypes {
														<option value={ t.Code }>{ t.Label }</option>
													}
												</select>
											</label>
											<button type="submit" class="primary">Mark role</button>
										</form>
									</div>
								</td>
							</tr>
						} else if row.ItemType == pco.ItemTypeHeader {
							<tr class="section-row" data-token={ "item:" + row.ItemID }>
								<td colspan="4">{ row.ItemTitle }</td>
							</tr>
						} else {
							<tr class="foreign-row" data-token={ "item:" + row.ItemID }>
								<td>{ strconv.Itoa(i + 1) }</td>
								<td>{ row.ItemTitle }</td>
								<td><span class="muted">{ row.ItemType }</span></td>
								<td></td>
							</tr>
						}
					}
					if len(data.ServiceOrder) == 0 {
						<tr>
							<td colspan="4" class="muted">Nothing in this plan yet - add a song below to get started.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(data.SetSongs) > 0 || data.PendingDeleteCount > 0 {
			<div class="publish-panel">
				if data.PendingDeleteCount > 0 {
					<div class="warning">
						{ fmt.Sprintf("%d song(s) removed/replaced here are still live in Planning Center - publishing will delete them there too.", data.PendingDeleteCount) }
					</div>
				}
				if len(data.PendingChanges) > 0 {
					<p><strong>Pending changes</strong> - not yet reflected in Planning Center:</p>
					<ul class="pending-changes">
						for _, change := range data.PendingChanges {
							<li>{ change }</li>
						}
					</ul>
				}
				<div class="publish-actions">
					<form
						hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/publish", data.ServiceTypeID, data.PlanID) }
						hx-target="#set-builder-body"
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Sync this set to Planning Center? %d song(s) added, %d removed, and any already-published songs reordered to match.", data.UnpublishedCount, data.PendingDeleteCount) }
					>
						<button type="submit" class="primary">Publish to Planning Center</button>
					</form>
					if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 || data.ReorderPending {
						<form
							hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
							hx-target="#set-builder-body"
							hx-swap="outerHTML"
							hx-confirm="Discard every change you've made here and rebuild this set from what's currently live in Planning Center? This can't be undone."
						>
							<button type="submit" class="danger">Discard changes</button>
						</form>
					}
				</div>
				<p class="muted">
					Publishing fully syncs this set to the plan: adds new songs, deletes
					ones you removed/replaced here, and reorders everything to match
					the order of service above - including each song's chosen
					position. It never touches or reorders plan items this tool didn't
					create. Discarding does the opposite - it throws away every local
					change and rebuilds this set from what's live in Planning Center
					right now.
				</p>
			</div>
		}
		if len(data.Suggestions) > 0 {
			@collapsibleSection("recommended-next-songs", "Recommended next", true) {
				<p class="muted">Based on the last song in the set.</p>
				<ul class="suggestion-list">
					for _, sug := range data.Suggestions {
						<li>
							<span>{ sug.Title }</span>
							<span class="muted">{ sug.RelationshipLabel }</span>
							<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="song_id" value={ sug.SongID }/>
								<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
									@views.IconAdd()
								</button>
							</form>
						</li>
					}
				</ul>
			}
		}
		if len(data.SongsToReinforce) > 0 {
			@collapsibleSection("songs-to-reinforce", "Could use one more sing", false) {
				<p class="muted">New to the church - a repeat helps it stick.</p>
				<ul class="suggestion-list">
					for _, sug := range data.SongsToReinforce {
						<li>
							<span>{ sug.Title }</span>
							<span class="muted">{ sug.RelationshipLabel }</span>
							<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="song_id" value={ sug.SongID }/>
								<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
									@views.IconAdd()
								</button>
							</form>
						</li>
					}
				</ul>
			}
		}
		<h2>Find songs to add</h2>
		<!--
			Generated straight from data.RoleTypes (song_role_types) rather
			than two hardcoded opener/response buttons - a role added to that
			table (Song Roles setup page or the quick-add panel below, no code
			change needed) is filterable immediately, same "no code change
			needed" philosophy the table already has for storage. filterCandidates
			(scheduling.js) already matches generically against whichever
			data-role was clicked - see CandidateSongView.RolesAttr.
		-->
		<div class="role-filters">
			for _, rt := range data.RoleTypes {
				<button type="button" class="role-filter" data-role={ rt.Code } onclick="toggleRoleFilter(this)">{ rt.Label }</button>
			}
		</div>
		<input
			type="text"
			id="candidate-search"
			placeholder="Search songs or tags..."
			autocomplete="off"
			oninput="filterCandidates()"
		/>
		<!--
			Open by default (see collapsibleSection's open param) - was
			collapsed on the reasoning that the full library is "the busiest
			thing on this page otherwise", but the toggle/swap-memory
			behavior is unaffected either way: collapsing it still works
			exactly as before, and filterCandidates()/toggleRoleFilter()
			(scheduling.js) still force it open the moment a search term or
			role filter is used, for whoever does collapse it.
		-->
		@collapsibleSection("find-songs-candidates", "Browse all songs", true) {
			<ul id="set-candidates" class="candidate-list">
				for _, cand := range data.Candidates {
					<li class="candidate-row" data-title={ cand.Title } data-roles={ cand.RolesAttr } data-tags={ cand.TagsAttr }>
						<span>{ cand.Title }</span>
						if cand.NewSongLabel != "" {
							<span class="badge status-pending" title="New to the church - a repeat helps it stick">{ cand.NewSongLabel }</span>
						}
						if cand.ArrangementInfo != "" {
							<span class="muted">{ cand.ArrangementInfo }</span>
						}
						for _, role := range cand.Roles {
							<span class="badge">{ role.Label }</span>
						}
						for _, tag := range cand.Tags {
							<span class="badge tag-badge" title={ tag.Category }>{ tag.Value }</span>
						}
						if len(cand.ConflictTitles) > 0 {
							<span class="conflict-badge">⚠ avoid pairing with { strings.Join(cand.ConflictTitles, ", ") }</span>
						}
						if cand.RecentlyRepeated {
							<span class="conflict-badge">⚠ sung in each of the last two plans</span>
						}
						<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
							<input type="hidden" name="song_id" value={ cand.SongID }/>
							<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
								@views.IconAdd()
							</button>
						</form>
					</li>
				}
				if len(data.Candidates) == 0 {
					<li class="muted">No more songs to add.</li>
				}
			</ul>
		}
		<!--
			Ad hoc creation of the setup-level entities this page's
			recommendations/badges/warnings are built from (song tags,
			relationships, opener/response roles) - see QuickAddSongTag/
			QuickAddSongRelationship/QuickAddSongRole in sets.go. Same fields,
			same Store methods as the dedicated setup pages
			(song_tags.templ/relationships.templ/song_roles.templ), just
			reachable without leaving this page and posted to a build-scoped
			route so the response re-renders this builder instead of a
			setup-page table. Create-only, same as those setup pages' forms
			minus the edit affordance - see the build-page redesign plan for
			why editing stays their job.

			Every song here also gets these same 3 actions from its own row's
			"more actions" menu (see row-menu/quick-action-row above), already
			scoped to that song - the faster path once a song is already in
			the order of service. This panel stays for the one thing the row
			menu can't do: tag/relate/mark a role on a song that isn't in this
			set yet.
		-->
		@collapsibleSection("quick-add-songs", "Quick add", false) {
			<div class="quick-add-panel">
				<div>
					<h4>Tag a song</h4>
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-tags", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song
							<select name="song_id" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Category
							<select name="category">
								for _, cat := range data.TagCategories {
									<option value={ cat.Code }>{ cat.Label }</option>
								}
							</select>
						</label>
						<label>
							Value
							<input type="text" name="value" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
						</label>
						<button type="submit" class="primary">Add tag</button>
					</form>
				</div>
				<div>
					<h4>Relate two songs</h4>
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song A
							<select name="song_id_a" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Song B
							<select name="song_id_b" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Relationship
							<select name="relationship_type">
								for _, t := range data.RelationshipTypes {
									<option value={ t.Code }>{ t.Label }</option>
								}
							</select>
						</label>
						<button type="submit" class="primary">Relate songs</button>
					</form>
				</div>
				<div>
					<h4>Add a role</h4>
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-roles", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song
							<select name="song_id" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Role
							<select name="role">
								for _, t := range data.RoleTypes {
									<option value={ t.Code }>{ t.Label }</option>
								}
							</select>
						</label>
						<button type="submit" class="primary">Mark role</button>
					</form>
				</div>
			</div>
		}
	</div>
}
