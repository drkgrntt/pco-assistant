package scheduling

import (
	"fmt"
	"sort"
	"strings"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views/components"

	pco "github.com/drkgrntt/go-pco"
)

// SetBuilderBody is the htmx swap target (id="set-builder-body") for every
// add/remove/move action below - the whole thing re-renders each time
// since adding or removing a song can change the current set, the
// recommendations (based on the last song added), and the candidate
// list's conflict warnings all at once. Bundles songPublishPanelOOB/
// songDetailCardsOOB/songGlanceOOB alongside SetBuilderBodyContent so
// every one of those actions also keeps the sidebar's publish card, detail
// cards, and "Songs, at a glance" card in sync (see each one's own doc
// comment) - every htmx handler that used to just render SetBuilderBody
// keeps doing exactly that, unchanged, and gets the sync for free.
// tagFilterGroup is one "Browse by ..." accordion in the candidate panel
// below - see groupedTagFilters for why Theme and Idea render as a single
// group while every other category stays its own.
type tagFilterGroup struct {
	ID     string
	Label  string
	Values []string
}

// groupedTagFilters folds the Theme and Idea tag categories into a single
// "Browse by Theme/Idea" group (values merged, deduped, sorted) - see the
// "Browse by tag" doc comment at its call site for why. Every other
// category (Scripture, plus anything a future migration adds to
// song_tag_categories - see that file's own "no special algorithmic
// meaning" note) still gets its own group, unchanged. Group order follows
// the categories' own sort_order, with the merged group taking Theme's
// slot; Idea's own slot is skipped, unless Theme doesn't exist at all (a
// category was removed), in which case Idea is left standalone rather
// than silently dropped.
func groupedTagFilters(categories []scheduling.SongTagCategory, valuesByCategory map[string][]string) []tagFilterGroup {
	hasTheme := false
	labelFor := make(map[string]string, len(categories))
	for _, cat := range categories {
		labelFor[cat.Code] = cat.Label
		if cat.Code == scheduling.TagCategoryTheme {
			hasTheme = true
		}
	}

	groups := make([]tagFilterGroup, 0, len(categories))
	for _, cat := range categories {
		if cat.Code == scheduling.TagCategoryIdea && hasTheme {
			continue // folded into Theme's group below
		}

		id, label, values := cat.Code, cat.Label, valuesByCategory[cat.Code]
		if cat.Code == scheduling.TagCategoryTheme {
			id = cat.Code + "-" + scheduling.TagCategoryIdea
			values = mergeSortedUnique(values, valuesByCategory[scheduling.TagCategoryIdea])
			if ideaLabel, ok := labelFor[scheduling.TagCategoryIdea]; ok {
				label = label + "/" + ideaLabel
			}
		}

		if len(values) == 0 {
			continue
		}
		groups = append(groups, tagFilterGroup{ID: id, Label: label, Values: values})
	}
	return groups
}

// mergeSortedUnique combines two already-distinct value lists (both are -
// see DistinctSongTagValues) into one deduped, alphabetically sorted list,
// for groupedTagFilters' merged Theme/Idea chip set.
func mergeSortedUnique(a, b []string) []string {
	seen := make(map[string]bool, len(a)+len(b))
	out := make([]string, 0, len(a)+len(b))
	for _, v := range a {
		if !seen[v] {
			seen[v] = true
			out = append(out, v)
		}
	}
	for _, v := range b {
		if !seen[v] {
			seen[v] = true
			out = append(out, v)
		}
	}
	sort.Strings(out)
	return out
}

// SyncCheckBanner is SyncCheck's (sets_publish.go) response the one time
// its poll tick actually finds a difference - two hx-swap-oob="true"
// fragments and nothing else, matching SetBuilderBodyContent's own
// #pco-sync-banner/#pco-sync-fp ids exactly (see that templ's own doc
// comment on the poll wiring). The banner offers the existing MergeSet
// endpoint - the same "Pull in changes" action the manual Merge button
// already runs - rather than any new auto-apply path, per the
// live-sync-reflection plan's banner-not-silent-auto-merge decision.
// Dismissible (see ImportBanner's dismissible param): dismissing removes
// just the inner .import-banner, leaving the #pco-sync-banner wrapper in
// place so a later poll tick can still find it by id.
templ SyncCheckBanner(serviceTypeID, planID, fingerprint string) {
	<div id="pco-sync-banner" hx-swap-oob="true">
		@components.ImportBanner("Planning Center has changes since you opened this page.", true) {
			<form
				hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/merge", serviceTypeID, planID) }
				hx-target="#set-builder-body"
				hx-swap="outerHTML"
			>
				<button type="submit" class="primary">Pull in changes</button>
			</form>
		}
	</div>
	<input type="hidden" id="pco-sync-fp" value={ fingerprint } hx-swap-oob="true"/>
}

templ SetBuilderBody(data SetBuilderData) {
	@SetBuilderBodyContent(data)
	@songPublishPanelOOB(data)
	@songDetailCardsOOB(data)
	@songGlanceOOB(data)
}

// SetBuilderBodyLazy is BuildSongsTabLazy's (build.go) response: the
// Songs tab's real content, the first time it's actually fetched, instead
// of build.templ's initial loading skeleton - see pco-api-risks.md's
// mitigation #3. SetBuilderBodyContent is the primary swap (hx-target
// points at #build-tab-songs, replacing its skeleton); the three OOB
// fragments are the *Lazy variants of SetBuilderBody's own OOB trio,
// since this always fires while Songs is the *inactive* tab (unlike every
// other caller of SetBuilderBody, which always fires while Songs is
// already the open one) - see songPublishPanelLazyOOB's doc comment for
// why that flips their hidden state.
templ SetBuilderBodyLazy(data SetBuilderData) {
	@SetBuilderBodyContent(data)
	@songPublishPanelLazyOOB(data)
	@songDetailCardsLazyOOB(data)
	@songGlanceLazyOOB(data)
}

// nextSongID returns the SongID of the next song in order after index i -
// "next" meaning the next row that IsSong, skipping over any header/
// foreign items in between, not just order[i+1]. Used to default the row
// menu's "Relate to another song" picker to whatever's actually adjacent
// in the order of service, since that's by far the most common pair to
// relate - the same adjacency SongPairPrompt above already captures
// automatically right after an add; this just offers the same default
// when relating from the row menu instead. Returns "" when there's no
// next song (i is the last song in the order).
func nextSongID(order []ServiceOrderRow, i int) string {
	for j := i + 1; j < len(order); j++ {
		if order[j].IsSong {
			return order[j].Song.SongID
		}
	}
	return ""
}

// nextSongRowAfter returns the very next row after songRowID's own row, but
// only when that next row is itself a song (its Song.ID) - unlike
// nextSongID above, this deliberately does NOT skip over header/foreign
// items to find the next song further down: a key-transition badge only
// ever exists between two rows that are truly back-to-back with nothing
// between them (see the controller's keyTransitionWarnings), so a caller
// asking "does editing this song's key need to also refresh its neighbor's
// badge" (KeyFormFragment/SongArrangementInfoRefreshFragment,
// song_detail_card.templ) needs exactly that same adjacency, not the
// next song regardless of what's between. Returns ok=false when songRowID
// isn't found, or its next row isn't a song (nothing to refresh).
func nextSongRowAfter(order []ServiceOrderRow, songRowID int64) (SetSongView, bool) {
	for i, row := range order {
		if row.IsSong && row.Song.ID == songRowID {
			if i+1 < len(order) && order[i+1].IsSong {
				return order[i+1].Song, true
			}
			return SetSongView{}, false
		}
	}
	return SetSongView{}, false
}

// songBadges is the badge cluster in a song row's own Tags column -
// factored out (rather than inlined in the row below) so it can also be
// re-rendered as its own targeted out-of-band fragment (see
// songBadgesOOB) when something that doesn't touch the rest of the row
// still needs this list to reflect a change - saving "This week's note"
// or a key override can flip InfoPending without going through a full
// #set-builder-body re-render (see DescriptionFormFragment/
// KeyFormFragment, song_detail_card.templ).
templ songBadges(song SetSongView) {
	<span id={ fmt.Sprintf("song-badges-%d", song.ID) }>
		@songBadgeSpans(song)
	</span>
}

templ songBadgesOOB(song SetSongView) {
	<span id={ fmt.Sprintf("song-badges-%d", song.ID) } hx-swap-oob="true">
		@songBadgeSpans(song)
	</span>
}

// keyTransitionToggle/keyTransitionMenu are the key-transition Disclosure's
// toggle-button content and popup contents (see songBadgeSpans below) - a
// short, always-visible caption (e.g. "half-step from previous song") that
// expands, on click, to the full explanatory sentence
// (SetSongView.KeyTransitionMessage), plus one more paragraph suggesting
// the actual move that eases the transition
// (SetSongView.KeyTransitionSuggestion, e.g. "Try hitting Ab7 (the V7 of
// Db) right before the change...") - see
// docs/plans/shipped/key-change-tip-plan.md. Kept as a click-to-expand
// Disclosure rather than a hover-only title= tooltip per
// docs/plans/shipped/in-place-set-warnings-plan.md's resolved decision -
// keyboard/screen-reader accessible, matching this app's existing pattern
// for the same tradeoff (see components.Disclosure's own doc comment).
templ keyTransitionToggle(label string) {
	⚠ { label }
}

templ keyTransitionMenu(message string, suggestion string) {
	<p>{ message }</p>
	if suggestion != "" {
		<p>{ suggestion }</p>
	}
}

// songBadgeSpans is the badge cluster in a song row's own Tags column -
// role/published/moved/info-pending badges, plus the same-set avoid-pairing
// conflict, recently-repeated, and key-transition warnings, all rendered
// inline right on this row instead of a separate top-of-page list - see
// docs/plans/shipped/in-place-set-warnings-plan.md. Mirrors
// songCandidateMeta's identical ConflictBadge usage for a not-yet-added
// candidate's ConflictTitles/RecentlyRepeated.
templ songBadgeSpans(song SetSongView) {
	for _, role := range song.Roles {
		@components.Badge("", role.Label)
	}
	if song.Published {
		@components.Badge("published", "Published")
	}
	if song.Moved {
		@components.BadgeTitled("status-pending", "Moved", "Moved since it was last published")
	}
	if song.InfoPending {
		@components.BadgeTitled("status-pending", "Note/key pending", "This week's note or key changed since it was last published - Refresh song info (or Publish) to send it to Planning Center")
	}
	if len(song.ConflictTitles) > 0 {
		@components.ConflictBadge(fmt.Sprintf("avoid pairing with %s", strings.Join(song.ConflictTitles, ", ")))
	}
	if song.RecentlyRepeated {
		@components.ConflictBadge("sung in each of the last two plans")
	}
	if song.KeyTransitionLabel != "" {
		@components.Disclosure(
			"key-transition-badge",
			"conflict-badge key-transition-toggle",
			"toggleKeyTransitionBadge(this)",
			"",
			"",
			keyTransitionToggle(song.KeyTransitionLabel),
			keyTransitionMenu(song.KeyTransitionMessage, song.KeyTransitionSuggestion),
		)
	}
	for _, prompt := range song.TransitionNotePrompts {
		@components.Disclosure(
			"transition-note-badge",
			"badge transition-note-toggle",
			"toggleTransitionNoteBadge(this)",
			"",
			"",
			transitionNoteToggle(prompt.Label),
			transitionNoteMenu(prompt.Message),
		)
	}
}

// transitionNoteToggle/transitionNoteMenu are the transition-note
// resurfacing prompt's Disclosure toggle-button content and popup contents
// (see songBadgeSpans above and SetSongView.TransitionNotePrompts) - same
// click-to-expand shape as keyTransitionToggle/keyTransitionMenu above,
// but deliberately styled as a plain, non-warning .badge pill rather than
// reusing .conflict-badge's look: this is history being handed back to the
// director, not a problem being flagged - see
// docs/plans/shipped/transition-notes-plan.md's Resurfacing trigger
// section.
templ transitionNoteToggle(label string) {
	{ label }
}

templ transitionNoteMenu(message string) {
	<p>{ message }</p>
}

// rowMenuToggle/rowMenuItems are the row-menu Disclosure's toggle-button
// content and popup contents - the same 3 fixed actions (tag/relate/mark
// role) for every song row, jumping to (and revealing) that row's own
// hidden quick-action-row via openQuickAction (scheduling.js), so neither
// needs any per-row data passed in.
templ rowMenuToggle() {
	@components.IconMore()
}

templ rowMenuItems() {
	<button type="button" onclick="openQuickAction(this, 'tag')">
		@components.IconTag()
		Tag this song
	</button>
	<button type="button" onclick="openQuickAction(this, 'relate')">
		@components.IconRelate()
		Relate to another song
	</button>
	<button type="button" onclick="openQuickAction(this, 'role')">
		@components.IconRole()
		Mark a role
	</button>
}

// replaceMenuToggle/replaceMenuItems are the "replace this song" Disclosure's
// toggle-button content and popup contents - collapses what used to be an
// always-visible <select> + submit button (wide enough to occasionally
// push the row-menu toggle onto its own line at narrow widths - see the
// .set-song-actions-wrap comment above) into the same reveal-on-click
// idiom as the row-menu itself, reusing its row-menu/toggleRowMenu
// machinery rather than a bespoke toggle. Needs data/row (unlike
// rowMenuToggle/rowMenuItems above) since the candidate list and the
// confirm/post targets are per-song.
templ replaceMenuToggle() {
	@components.IconReplace()
}

templ replaceMenuItems(data SetBuilderData, row ServiceOrderRow) {
	<form
		class="replace-form"
		hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/replace", data.ServiceTypeID, data.PlanID, row.Song.ID) }
		hx-target="#set-builder-body"
		hx-swap="outerHTML"
		hx-confirm={ fmt.Sprintf("Replace %q with the selected song?", row.Song.Title) }
	>
		<select name="song_id" required>
			<option value="" selected disabled>Replace with...</option>
			for _, cand := range data.ReplaceCandidates {
				<option value={ cand.SongID }>{ cand.Title }</option>
			}
		</select>
		<button type="submit">
			@components.IconReplace()
			Replace
		</button>
	</form>
}

// songCandidateMeta is the badge/meta cluster for one not-yet-added song -
// shared by the candidate list ("Browse all songs") and, since both
// reuse CandidateSongView (see SuggestionView, set_types.go), the
// "Recommended next"/"Could use one more sing" suggestion lists too. Lives
// inside ListItem's own layout (see list-item.css): the title takes the
// li's first line by itself, and everything this renders wraps onto the
// line(s) below it, the same title-then-meta-underneath shape
// set_builder.templ's own .song-meta already uses for a set song's row.
templ songCandidateMeta(cand CandidateSongView) {
	if cand.NewSongLabel != "" {
		@components.BadgeTitled("status-pending", cand.NewSongLabel, "New to the church - a repeat helps it stick")
	}
	if cand.ArrangementInfo != "" {
		<!--
			arrangement-info is a distinguishing class, not just styling -
			list-item.css singles it out to force its own full-width line
			below the title, while every other sibling here (badges, the
			add form) shares the title's own first line instead. See
			list-item.css's comment on that rule for why.
		-->
		<span class="muted arrangement-info">{ cand.ArrangementInfo }</span>
	}
	for _, role := range cand.Roles {
		@components.Badge("", role.Label)
	}
	for _, tag := range cand.Tags {
		@components.BadgeTitled("tag-badge", tag.Value, tag.Category)
	}
	if len(cand.ConflictTitles) > 0 {
		@components.ConflictBadge(fmt.Sprintf("avoid pairing with %s", strings.Join(cand.ConflictTitles, ", ")))
	}
	if cand.RecentlyRepeated {
		@components.ConflictBadge("sung in each of the last two plans")
	}
}

// songBrowseRow is one row of the "Browse all songs" plain title list
// (CandidateSearchResults' query=="" state) - a title button that reveals
// that song's rich metadata/tags in place on click (lazy-fetched via
// BuildCandidateDetails, sets_builder.go), a separate "+" button that adds
// it to the set immediately (the same hx-post/#set-builder-body swap the
// rich search rows' own Add form uses), and the detail container itself,
// empty until the title's first click populates it.
//
// The title button carries both a plain onclick (toggleSongBrowseDetail,
// scheduling.js - purely the CSS open/close, no network) and htmx's own
// hx-get/hx-trigger="click once" (the actual fetch, cached client-side
// after the first open so re-toggling never re-fetches) - both listen to
// the same click independently, same pattern the row-menu/key-transition
// Disclosures already use for their own toggle buttons, just without
// routing through components.Disclosure itself: that component's fixed
// signature has no room for a toggle button that's also an htmx trigger.
// Unlike those two (floating popovers that close their siblings when one
// opens), rows here stay open independently - there's no overlap risk
// since this expands inline within the row rather than floating over
// anything, and comparing two or three songs at once while browsing is
// the actual point.
templ songBrowseRow(serviceTypeID, planID string, song SongOptionView) {
	<li class="song-browse-row">
		<button
			type="button"
			class="song-title-browse-item"
			aria-expanded="false"
			aria-controls={ fmt.Sprintf("song-browse-detail-%s", song.SongID) }
			onclick="toggleSongBrowseDetail(this)"
			hx-get={ fmt.Sprintf("/scheduling/build/%s/%s/candidates/%s/details", serviceTypeID, planID, song.SongID) }
			hx-target={ fmt.Sprintf("#song-browse-detail-%s", song.SongID) }
			hx-swap="innerHTML"
			hx-trigger="click once"
		>{ song.Title }</button>
		<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", serviceTypeID, planID) } hx-target="#set-builder-body" hx-swap="outerHTML">
			<input type="hidden" name="song_id" value={ song.SongID }/>
			<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
				@components.IconAdd()
			</button>
		</form>
		<div class="song-browse-detail" id={ fmt.Sprintf("song-browse-detail-%s", song.SongID) }>
			<span class="muted">Loading...</span>
		</div>
	</li>
}

// CandidateDetails is songBrowseRow's lazy-loaded detail content -
// BuildCandidateDetails' whole response, just the same songCandidateMeta
// badge/meta cluster the rich search rows and suggestion lists already
// show, computed for the one song clicked (see that handler's doc
// comment). errMsg covers the two failure paths there (set lookup failed,
// song not found); HasMeta covers the common case of a song with nothing
// on record yet, so the reveal doesn't just look like nothing happened.
templ CandidateDetails(cand CandidateSongView, errMsg string) {
	if errMsg != "" {
		<p class="error">{ errMsg }</p>
	} else if !cand.HasMeta() {
		<p class="muted">Nothing on record for this song yet.</p>
	} else {
		@songCandidateMeta(cand)
	}
}

// CandidateSearchResults is the "Browse all songs" list's actual content -
// swapped into #set-candidates' innerHTML by the search box/role filters
// (see set_builder.templ's candidate-search input) and by the initial page
// render itself, both going through the exact same component so there's
// only one place this list's empty/prompt/capped states are ever written.
// candidates is already the final, possibly-capped set to render (see
// BuildCandidatesSearch, sets_builder.go) - this component doesn't filter
// or cap anything itself, just decides which of the four states to show:
//
//   - No query and no role filter: a prompt plus browsable, the lightweight
//     title-only "browse titles" list (see BrowsableSongs' own doc comment
//     on SetBuilderData) - the whole point of this being search-driven is
//     that nothing *expensive* gets computed until someone actually
//     searches (see BuildCandidatesSearch/searchCandidates's doc comments),
//     but a plain list of titles is cheap enough to always show, so
//     browsing the library doesn't require typing something first. Clicking
//     a title reveals that one song's rich metadata/tags in place (see
//     songBrowseRow/BuildCandidateDetails) rather than adding it - an
//     earlier version made the click an instant add, but that gave no way
//     to actually look at a song (arrangement info, tags, conflicts) before
//     deciding to add it. Adding is now its own explicit "+" button per
//     row, right next to the title.
//   - A query/filter that matched nothing: says so, rather than looking
//     identical to "haven't searched yet."
//   - Normal results.
//   - Capped results: the same rows, plus a trailing hint that more exist -
//     see BuildCandidatesSearch's candidateSearchLimit.
templ CandidateSearchResults(serviceTypeID, planID string, candidates []CandidateSongView, query, roleFilter string, totalMatches int, capped bool, browsable []SongOptionView, errMsg string) {
	if errMsg != "" {
		<li class="error">{ errMsg }</li>
	}
	if query == "" && roleFilter == "" {
		<li class="muted">
			Type to search your song library, or browse:
			if len(browsable) > 0 {
				<ul class="song-title-browse">
					for _, song := range browsable {
						@songBrowseRow(serviceTypeID, planID, song)
					}
				</ul>
			}
		</li>
	} else if len(candidates) == 0 {
		<li class="muted">No matching songs.</li>
	} else {
		for _, cand := range candidates {
			@components.ListItem("candidate-row", nil, cand.Title) {
				@songCandidateMeta(cand)
				<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", serviceTypeID, planID) } hx-target="#set-builder-body" hx-swap="outerHTML">
					<input type="hidden" name="song_id" value={ cand.SongID }/>
					<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
						@components.IconAdd()
					</button>
				</form>
				<button
					type="button"
					class="icon-btn danger"
					hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/candidates/%s/archive", serviceTypeID, planID, cand.SongID) }
					hx-target="#set-candidates"
					hx-swap="innerHTML"
					hx-include="#candidate-search, #candidate-role-filter"
					hx-confirm={ fmt.Sprintf("Archive %q in Planning Center? It won't be deleted, just hidden - you (or anyone with PCO access) can unhide it there anytime.", cand.Title) }
					aria-label="Archive song"
					title="Archive song"
				>
					@components.IconArchive()
				</button>
			}
		}
		if capped {
			<li class="muted">{ fmt.Sprintf("Showing top %d of %d matches - refine your search.", len(candidates), totalMatches) }</li>
		}
	}
}

// SetBuilderBodyContent is the actual content - split out from
// SetBuilderBody so the Build page's initial full-page render
// (build.templ) can embed just this, without also embedding
// songPublishPanelOOB: that out-of-band fragment only does anything on an
// htmx-processed response, not a plain page load, where it would
// otherwise just render as an inert, visible second copy of the sidebar's
// publish card (and a duplicate id) sitting in the main content instead of
// being relocated anywhere.
templ SetBuilderBodyContent(data SetBuilderData) {
	<div id="set-builder-body">
		<!--
			Poll-while-open live-sync check (option C,
			docs/plans/in-progress/live-sync-reflection-plan.md) - only while
			there's something to publish toward (!data.ReadOnly, mirroring
			every other publish/discard/merge action on this page). #pco-sync-fp
			carries the fingerprint this render's own GetItems call captured
			(see data.PCOSyncFingerprint/pcoItemsFingerprint); the poll element
			below re-fetches it every 30s via hx-vals' js: expression, so it
			always sends whatever value SyncCheck's own OOB response last wrote
			there, not this page load's stale value. #pco-sync-banner is a
			persistent empty wrapper SyncCheck outerHTML-replaces
			(hx-swap-oob="true") when it finds a difference - it has to
			survive being replaced (unlike ImportBanner's dismiss button, which
			only removes the inner .import-banner) so a later poll tick can
			still find it by id to show a fresh banner. hx-swap="none" on the
			poll element itself is deliberate: the only content that should
			ever change from this request arrives as those two OOB fragments,
			never as this element's own body.
		-->
		if !data.ReadOnly {
			<input type="hidden" id="pco-sync-fp" value={ data.PCOSyncFingerprint }/>
			<div id="pco-sync-banner"></div>
			<div
				id="pco-sync-poll"
				hx-get={ fmt.Sprintf("/scheduling/sets/%s/%s/sync-check", data.ServiceTypeID, data.PlanID) }
				hx-trigger="every 30s"
				hx-swap="none"
				hx-vals="js:{fp: document.getElementById('pco-sync-fp').value}"
			></div>
		}
		if data.ErrMsg != "" {
			<p class="error">{ data.ErrMsg }</p>
		}
		if data.PublishMsg != "" {
			<p class="success">{ data.PublishMsg }</p>
		}
		@SongStatusSummary(data)
		if !data.ReadOnly {
			@collapsibleSection("vocal-note-category-section", "Song leader sync setting", false) {
				@VocalNoteCategoryFormFragment(data.ServiceTypeID, data.PlanID, data.VocalNoteCategories, data.VocalNoteCategoryID, "")
			}
		}
		<!--
			ServiceLengthWarning is the one warning check that stays a
			standalone banner rather than moving onto a song's own row (see
			SetSongView.RecentlyRepeated/ConflictTitles/KeyTransitionLabel,
			rendered inline via songBadgeSpans instead) - it's a property of
			the whole plan, not any one song or pair, so there's no row to
			attach it to. See docs/plans/shipped/in-place-set-warnings-plan.md.
			At most one such message at a time, so this is a single
			conditional message, not a list/container.
		-->
		if data.ServiceLengthWarning != "" {
			<div class="warning">{ data.ServiceLengthWarning }</div>
		}
		if data.ReadOnly {
			<p class="muted">This plan has already happened - shown read-only for reference.</p>
		}
		if !data.ReadOnly && data.ImportableSongCount > 0 {
			@components.ImportBanner(fmt.Sprintf("Looks like this service is already planned in Planning Center - it has %d song(s). Want to import them here so you can reorder, replace, or tag them?", data.ImportableSongCount), false) {
				<form
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
				>
					<button type="submit" class="primary">Import from Planning Center</button>
				</form>
			}
		}
		<!--
			A one-shot nudge, not a permanent fixture - only ever appears
			right after AddSetSong chains a song after another one (see
			views.SongPairPromptView, AddSetSong in sets.go), and disappears
			again the moment you do anything else, since no other mutation
			sets it. Lets "song A, then I add song B, and by the way these go
			together" get captured right where it happens, instead of
			re-picking both songs from scratch in the Quick add panel below -
			which stays around for relating songs that *aren't* adjacent, or
			after the fact.
		-->
		if !data.ReadOnly && data.SongPairPrompt != nil {
			@components.ImportBanner(fmt.Sprintf("Added %q right after %q - want to remember how these two relate?", data.SongPairPrompt.NewSongTitle, data.SongPairPrompt.PreviousSongTitle), true) {
				<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
					<input type="hidden" name="song_id_a" value={ data.SongPairPrompt.PreviousSongID }/>
					<input type="hidden" name="song_id_b" value={ data.SongPairPrompt.NewSongID }/>
					<label>
						Relationship
						<select name="relationship_type">
							for _, t := range data.RelationshipTypes {
								<option value={ t.Code } selected?={ t.Code == scheduling.RelationshipFlowsWell }>{ t.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="primary">Remember this</button>
				</form>
			}
		}
		<h2>Order of service</h2>
		<p class="muted">
			Everything Planning Center already has for this plan, with your songs
			placed where you've put them. Non-song items are shown for context
			only - this tool doesn't manage them. Drag a song's
			<span class="icon-inline">
				@components.IconDrag()
			</span>
			handle to move it anywhere in the order, including onto or past a
			section header.
		</p>
		@components.TableWrap() {
			<thead>
					<tr>
						<th></th>
						<th>Item</th>
						<th>Tags</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for i, row := range data.ServiceOrder {
						if row.IsSong {
							<tr
								class="song-row"
								data-token={ fmt.Sprintf("row:%d", row.Song.ID) }
								data-row-id={ fmt.Sprintf("%d", row.Song.ID) }
								data-reposition-url={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/reposition", data.ServiceTypeID, data.PlanID, row.Song.ID) }
								onclick="selectSongRow(this, event)"
							>
								<td>
									if !data.ReadOnly {
										<span class="drag-handle" title="Drag to reorder">
											@components.IconDrag()
										</span>
									}
								</td>
								<td>
									{ row.Song.Title }
									<!--
										Always rendered, even when there's nothing to show -
										a song with no cached arrangement info used to just
										omit this line entirely, making its row shorter than
										a neighbor that has one. Reserving the same line
										height either way (see .song-meta) keeps every row an
										even height regardless of which songs happen to be
										cached.
									-->
									<div class="muted song-meta" id={ fmt.Sprintf("song-meta-%d", row.Song.ID) }>{ row.Song.ArrangementInfo }</div>
								</td>
								<td>
									@songBadges(row.Song)
								</td>
								<!--
									.set-song-actions (the flex row of action
									buttons) lives on an inner div, not this <td>
									directly - display:flex on a <td> itself
									overrides its native display:table-cell,
									which pulls it out of the table's row-height
									sharing entirely (confirmed via DevTools: this
									cell was rendering visibly shorter than its
									siblings in the same row, no matter what
									vertical-align/min-height was set on it -
									neither one does anything once a cell isn't
									actually a table-cell box anymore). Keeping
									the <td> itself unstyled lets it size like
									every other cell in the row; the div just
									carries the flex layout for its own children.
								-->
								<td>
									if !data.ReadOnly {
										<!--
											The dot menu must never wrap onto its own line, even
											when duplicate/remove/replace-form together are too
											wide for the row - and flex-wrap can't be trusted to
											honor that via order/flex-shrink alone, because wrap
											placement is computed from each item's *hypothetical*
											(pre-shrink) width, not its shrunk width, so a wide
											.replace-form can still push the dot menu to a second
											line regardless of order (confirmed live: the previous
											order:1/flex-shrink:0-only fix looked right on paper
											but didn't hold up at narrow widths). Structural fix
											instead: only the duplicate/remove/replace-form cluster
											lives in its own wrapping sub-container
											(.set-song-actions-wrap); the dot menu is a sibling
											outside it, so it's never a participant in that
											sub-container's wrap calculation at all. The outer
											.set-song-actions row itself never wraps.
										-->
										<div class="set-song-actions">
											<div class="set-song-actions-wrap">
												<button
													type="button"
													class="icon-btn"
													aria-label="Duplicate song (e.g. reprise as the response)"
													title="Duplicate song (e.g. reprise as the response)"
													hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d/duplicate", data.ServiceTypeID, data.PlanID, row.Song.ID) }
													hx-target="#set-builder-body"
													hx-swap="outerHTML"
												>
													@components.IconCopy()
												</button>
												<button
													type="button"
													class="danger icon-btn"
													aria-label="Remove from set"
													title="Remove from set"
													hx-delete={ fmt.Sprintf("/scheduling/sets/%s/%s/set-songs/%d", data.ServiceTypeID, data.PlanID, row.Song.ID) }
													hx-target="#set-builder-body"
													hx-swap="outerHTML"
													hx-confirm="Remove this song from the set?"
												>
													@components.IconRemove()
												</button>
												if len(data.ReplaceCandidates) > 0 {
													@components.Disclosure("row-menu", "icon-btn row-menu-toggle", "toggleRowMenu(this)", "Replace this song", "Replace", replaceMenuToggle(), replaceMenuItems(data, row))
												}
											</div>
											<!--
												Row-scoped access to the same 3 actions the Quick add
												panel below offers generically - see quick-action-row
												just below and openQuickAction/toggleRowMenu
												(scheduling.js). The song is already this row's, so
												unlike the panel's forms there's no song picker to fill
												in - just the category/relationship/role fields that
												actually vary. The panel itself stays, since it's still
												the only way to tag/relate/role a song that isn't in
												this order of service yet.
											-->
											@components.Disclosure("row-menu", "icon-btn row-menu-toggle", "toggleRowMenu(this)", "More actions for this song", "More actions", rowMenuToggle(), rowMenuItems())
										</div>
									}
								</td>
							</tr>
							if !data.ReadOnly {
								@quickActionRow(fmt.Sprintf("%d", row.Song.ID), "tag", fmt.Sprintf("Tag %q", row.Song.Title), 4) {
									<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-tags", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
										<input type="hidden" name="song_id" value={ row.Song.SongID }/>
										<label>
											Category
											<select name="category">
												for _, cat := range data.TagCategories {
													<option value={ cat.Code }>{ cat.Label }</option>
												}
											</select>
										</label>
										<label>
											Value
											<input type="text" name="value" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
										</label>
										<button type="submit" class="primary">Add tag</button>
									</form>
								}
								@quickActionRow(fmt.Sprintf("%d", row.Song.ID), "relate", fmt.Sprintf("Relate %q to...", row.Song.Title), 4) {
									<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
										<input type="hidden" name="song_id_a" value={ row.Song.SongID }/>
										<label>
											Song
											<!-- Defaults to the next song in the order (see nextSongID). -->
											<select name="song_id_b" required>
												<option value="" disabled selected?={ nextSongID(data.ServiceOrder, i) == "" }>Choose a song</option>
												for _, song := range data.AllSongs {
													if song.ID != row.Song.SongID {
														<option value={ song.ID } selected?={ song.ID == nextSongID(data.ServiceOrder, i) }>{ song.Attributes.Title }</option>
													}
												}
											</select>
										</label>
										<label>
											Relationship
											<select name="relationship_type">
												for _, t := range data.RelationshipTypes {
													<option value={ t.Code }>{ t.Label }</option>
												}
											</select>
										</label>
										<button type="submit" class="primary">Relate songs</button>
									</form>
								}
								@quickActionRow(fmt.Sprintf("%d", row.Song.ID), "role", fmt.Sprintf("Mark a role for %q", row.Song.Title), 4) {
									<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-roles", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
										<input type="hidden" name="song_id" value={ row.Song.SongID }/>
										<label>
											Role
											<select name="role">
												for _, t := range data.RoleTypes {
													<option value={ t.Code }>{ t.Label }</option>
												}
											</select>
										</label>
										<button type="submit" class="primary">Mark role</button>
									</form>
								}
							}
						} else if row.ItemType == pco.ItemTypeHeader {
							<tr class="section-row" data-token={ "item:" + row.ItemID }>
								<td colspan="4">{ row.ItemTitle }</td>
							</tr>
						} else {
							<tr class="foreign-row" data-token={ "item:" + row.ItemID }>
								<td></td>
								<td>{ row.ItemTitle }</td>
								<td></td>
								<td></td>
							</tr>
						}
					}
					if len(data.ServiceOrder) == 0 {
						<tr>
							<td colspan="4" class="muted">Nothing in this plan yet - add a song below to get started.</td>
						</tr>
					}
				</tbody>
		}
		<!--
			The actual publish/discard controls live in the sidebar now (see
			SongPublishPanel, build.templ) - SetBuilderBody (not this,
			SetBuilderBodyContent) is the one that keeps that card in sync,
			via songPublishPanelOOB, for every htmx response this content is
			part of.
		-->
		if !data.ReadOnly && len(data.Suggestions) > 0 {
			@collapsibleSection("recommended-next-songs", "Recommended next", true) {
				<p class="muted">Based on the last song in the set.</p>
				<ul class="suggestion-list">
					for _, sug := range data.Suggestions {
						@components.ListItem("", nil, sug.Title) {
							<span class="muted">{ sug.RelationshipLabel }</span>
							@songCandidateMeta(sug.CandidateSongView)
							<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="song_id" value={ sug.SongID }/>
								<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
									@components.IconAdd()
								</button>
							</form>
						}
					}
				</ul>
			}
		}
		if !data.ReadOnly && len(data.SongsToReinforce) > 0 {
			@collapsibleSection("songs-to-reinforce", "Could use one more sing", false) {
				<p class="muted">New to the church - a repeat helps it stick.</p>
				<ul class="suggestion-list">
					for _, sug := range data.SongsToReinforce {
						@components.ListItem("", nil, sug.Title) {
							<span class="muted">{ sug.RelationshipLabel }</span>
							@songCandidateMeta(sug.CandidateSongView)
							<form hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/songs", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="song_id" value={ sug.SongID }/>
								<button type="submit" class="icon-btn" aria-label="Add to set" title="Add to set">
									@components.IconAdd()
								</button>
							</form>
						}
					}
				</ul>
			}
		}
		if !data.ReadOnly {
		<h2>Find songs to add</h2>
		<!--
			Generated straight from data.RoleTypes (song_role_types) rather
			than two hardcoded opener/response buttons - a role added to that
			table (Song Roles setup page or the quick-add panel below, no code
			change needed) is filterable immediately. toggleRoleFilter
			(scheduling.js) tracks which one is active in the hidden
			#candidate-role-filter input below, then re-triggers the search
			box's own htmx request - see that input's own comment for why.
		-->
		<div class="role-filters">
			for _, rt := range data.RoleTypes {
				<button type="button" class="role-filter" data-role={ rt.Code } onclick="toggleRoleFilter(this)">{ rt.Label }</button>
			}
		</div>
		<!--
			"Browse by tag" - pure discoverability, not a new filter
			mechanism. candidateMatchesSearch (sets_builder.go) already matches
			typed search text against tag values, not just titles, so typing an
			exact tag value into the search box above already works; the
			problem is nobody can see what tags exist without already knowing
			what to type. Unlike the role filters above (a small fixed list,
			so an always-open button row is fine), tag values are unbounded
			free text - dozens of scripture references, say - so each
			group's chips sit behind their own collapsibleSection, collapsed
			by default. (A single accordion with a category <select> was
			tried instead and reverted - it read as one more control to
			operate rather than a shortcut.) Clicking a chip just types that
			value into #candidate-search and re-triggers the same search
			request (applyTagFilter, scheduling.js); it deliberately doesn't
			set any state of its own the way the role filter's hidden input
			does.

			Categories map 1:1 to a group here except Theme and Idea, merged
			into one "Browse by Theme/Idea" group by groupedTagFilters (at
			Derek's request, 2026-09-05: to someone browsing tags, "theme"
			and "idea" read as the same kind of loose descriptive tag, not
			two things worth separate accordions for).
		-->
		if len(data.TagValuesByCategory) > 0 {
			<div class="tag-filters">
				for _, group := range groupedTagFilters(data.TagCategories, data.TagValuesByCategory) {
					@collapsibleSection(fmt.Sprintf("tag-filter-%s", group.ID), "Browse by "+group.Label, false) {
						<div class="role-filters">
							for _, v := range group.Values {
								<button type="button" class="role-filter" data-value={ v } onclick="applyTagFilter(this)">{ v }</button>
							}
						</div>
					}
				}
			</div>
		}
		<!--
			The search box and role filters both feed one server-driven
			search request (BuildCandidatesSearch) rather than filtering an
			already-rendered list client-side - see that handler's doc
			comment for why (a library of hundreds of songs otherwise means
			hundreds of rich rows computed and rendered on every Build page
			load, whether or not this section is even open). The role filter
			has no form control of its own to carry its value along with the
			search box's own request, so it's mirrored into this hidden
			input (kept in sync by toggleRoleFilter) and pulled in via
			hx-include; "search" is a synthetic event name (see
			htmx.trigger in toggleRoleFilter), not a real DOM search event,
			since this is a plain text input, not type="search".
		-->
		<input type="hidden" id="candidate-role-filter" name="role" value=""/>
		<div class="search-bar">
			<input
				type="text"
				id="candidate-search"
				name="q"
				placeholder="Search songs or tags..."
				autocomplete="off"
				hx-get={ fmt.Sprintf("/scheduling/build/%s/%s/candidates/search", data.ServiceTypeID, data.PlanID) }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#set-candidates"
				hx-swap="innerHTML"
				hx-include="#candidate-role-filter"
				oninput="openCandidatesSection()"
			/>
			<!--
				Clicking a role filter or tag chip fills the search box (or the
				hidden role input) but gives no way back to the plain "browse
				titles" list short of manually erasing what got typed in - not
				obvious, especially once a role filter's own "active" button
				state also needs clearing. clearCandidateSearch (scheduling.js)
				resets both back to "" and re-triggers the same search, landing
				back on CandidateSearchResults' empty-query-and-role state.
			-->
			<button type="button" class="icon-btn" aria-label="Clear search" title="Clear search" onclick="clearCandidateSearch()">
				@components.IconX()
			</button>
		</div>
		<!--
			Open by default (see collapsibleSection's open param) - was
			collapsed on the reasoning that the full library is "the busiest
			thing on this page otherwise", but the toggle/swap-memory
			behavior is unaffected either way: collapsing it still works
			exactly as before, and openCandidatesSection()/toggleRoleFilter()
			(scheduling.js) still force it open the moment a search term or
			role filter is used, for whoever does collapse it.
		-->
		@collapsibleSection("find-songs-candidates", "Browse all songs", true) {
			<ul id="set-candidates" class="candidate-list">
				@CandidateSearchResults(data.ServiceTypeID, data.PlanID, nil, "", "", 0, false, data.BrowsableSongs, "")
			</ul>
		}
		<!--
			Ad hoc creation of the setup-level entities this page's
			recommendations/badges/warnings are built from (song tags,
			relationships, opener/response roles) - see QuickAddSongTag/
			QuickAddSongRelationship/QuickAddSongRole in sets.go. Same fields,
			same Store methods as the dedicated setup pages
			(song_tags.templ/relationships.templ/song_roles.templ), just
			reachable without leaving this page and posted to a build-scoped
			route so the response re-renders this builder instead of a
			setup-page table. Create-only, same as those setup pages' forms
			minus the edit affordance - see the build-page redesign plan for
			why editing stays their job.

			Every song here also gets these same 3 actions from its own row's
			"more actions" menu (see row-menu/quick-action-row above), already
			scoped to that song - the faster path once a song is already in
			the order of service. This panel stays for the one thing the row
			menu can't do: tag/relate/mark a role on a song that isn't in this
			set yet.
		-->
		@collapsibleSection("quick-add-songs", "Quick add", false) {
			<div class="quick-add-panel">
				@quickAddItem("Tag a song") {
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-tags", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song
							<select name="song_id" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Category
							<select name="category">
								for _, cat := range data.TagCategories {
									<option value={ cat.Code }>{ cat.Label }</option>
								}
							</select>
						</label>
						<label>
							Value
							<input type="text" name="value" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
						</label>
						<button type="submit" class="primary">Add tag</button>
					</form>
				}
				@quickAddItem("Relate two songs") {
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song A
							<select name="song_id_a" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Song B
							<select name="song_id_b" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Relationship
							<select name="relationship_type">
								for _, t := range data.RelationshipTypes {
									<option value={ t.Code }>{ t.Label }</option>
								}
							</select>
						</label>
						<button type="submit" class="primary">Relate songs</button>
					</form>
				}
				@quickAddItem("Add a role") {
					<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/song-roles", data.ServiceTypeID, data.PlanID) } hx-target="#set-builder-body" hx-swap="outerHTML">
						<label>
							Song
							<select name="song_id" required>
								<option value="" selected disabled>Choose a song</option>
								for _, song := range data.AllSongs {
									<option value={ song.ID }>{ song.Attributes.Title }</option>
								}
							</select>
						</label>
						<label>
							Role
							<select name="role">
								for _, t := range data.RoleTypes {
									<option value={ t.Code }>{ t.Label }</option>
								}
							</select>
						</label>
						<button type="submit" class="primary">Mark role</button>
					</form>
				}
			</div>
		}
		}
	</div>
}
