package scheduling

import (
	"fmt"
	"sort"
	"strconv"
	"strings"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

// SongTags is the setup page for theme/scripture/idea tags - one persistent
// card per active song (see docs/plans/shipped/song-tags-setup-redesign-plan.md
// for why this replaced the old flat one-row-per-tag table): every song
// shows up front, tagged or not, with its own tags as chips and its own
// small inline "add a tag" form, rather than a single shared form + table
// above the fold. tagsBySong groups the org's tags by song id (see
// songTagsBySong, controllers/scheduling.go) so each card's own lookup is
// a map read, not a query. Unlike the Build page's search-gated "Browse all
// songs" (BuildCandidatesSearch), this list renders every song unconditionally
// - a local-DB read is cheap regardless of library size, no PCO cost concern
// here - with #song-tag-filter below just hiding non-matching cards
// client-side (filterSongTagCards, scheduling-song-tags-contexts.js) for a large library.
templ SongTags(personName, organizationName string, songs []pco.SongData, tagsBySong map[string][]scheduling.SongTag, categories []scheduling.SongTagCategory, categoryLabels map[string]string, panelData SongTagSuggestionsPanelData, errMsg string) {
	@views.Layout("Song Labels", personName, organizationName) {
		@songTagsHelp()
		<h1>Song Labels</h1>
		<p class="muted">Tag songs with themes, scripture references, or ideas, so they're easier to find when planning around a sermon.</p>
		<div class="song-tags-filter">
			<label>
				Filter songs
				<input
					type="text"
					id="song-tag-filter"
					placeholder="Filter by song title or tag..."
					autocomplete="off"
					oninput="filterSongTagCards()"
				/>
			</label>
			@songTagFilterChips(distinctTagValues(tagsBySong))
		</div>
		@SongTagSuggestionsPanel(panelData)
		@songTagBulkAddForm(categories)
		@SongTagsList(songs, tagsBySong, categories, categoryLabels, "", errMsg)
	}
}

// songTagBulkAddForm is this page's "already know the tag, just need it on
// several songs" shortcut - the counterpart to each SongTagCard's own
// per-song inline form, for adding one category/value pair to songs a/b/c/d
// without opening each of their cards individually. Lives outside
// #song-tags-list (like #song-tag-filter above) so an unrelated single-tag
// add/edit/delete elsewhere on the page doesn't wipe a category/value the
// user was mid-typing here - only the per-card checkboxes it collects via
// their own form="song-tag-bulk-form" attribute (SongTagCard) live inside
// that swapped div, and losing an in-progress *selection* to some other
// card's own edit is an acceptable rare edge case, not worth guarding
// against. #song-tag-bulk-count (updateSongTagBulkCount, scheduling-song-tags-contexts.js) is
// kept in sync from each checkbox's own onchange and from #song-tags-list's
// own htmx:afterSwap handler (every checkbox lives inside that div, so a
// swap - including this form's own submit - always resets it to 0).
templ songTagBulkAddForm(categories []scheduling.SongTagCategory) {
	<details class="song-tag-bulk-details">
		<summary class="song-tag-add-toggle">+ Add a tag to multiple songs at once</summary>
		<form
			id="song-tag-bulk-form"
			class="inline song-tag-bulk-form"
			hx-post="/scheduling/song-tags/bulk"
			hx-target="#song-tags-list"
			hx-swap="outerHTML"
		>
			<label>
				Category
				<select name="category">
					for _, cat := range categories {
						<option value={ cat.Code }>{ cat.Label }</option>
					}
				</select>
			</label>
			<label>
				Value
				<input type="text" name="value" list="song-tag-value-options" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
			</label>
			<button type="submit" class="primary">Add tag to selected songs</button>
			<span id="song-tag-bulk-count" class="muted">0 songs selected</span>
		</form>
		<p class="muted song-tag-bulk-hint">Check the songs below, then submit.</p>
	</details>
}

// SongTagSuggestionsPanel is the "already know the tag, just need to find
// which songs share it" counterpart to songTagBulkAddForm above - see
// docs/plans/shipped/song-tags-suggestions-merge-plan.md for why this
// replaced the old standalone /scheduling/song-tag-suggestions page.
// Selecting a suggestion doesn't apply anything itself (no server round
// trip): applySongTagSuggestion (scheduling-song-tags-contexts.js) just
// opens/fills songTagBulkAddForm's own form and checks the matching
// songs' .song-tag-bulk-checkboxes, so review-then-submit still happens
// through that one existing form - see this page's own doc comment on why
// that form lives outside #song-tags-list, the same reason this panel
// does too. Rendered at page load here, and refreshed via
// songTagSuggestionsPanelOOB below on every Create/Bulk/Delete (a tag
// change can shrink or remove a group) - id="song-tag-suggestions-panel"
// is what that OOB swap targets, kept in sync with the same id on both,
// same "must render unconditionally, even empty, so an OOB swap always
// has a matching id to replace into" gotcha songTagFilterChips documents
// above.
templ SongTagSuggestionsPanel(data SongTagSuggestionsPanelData) {
	@collapsibleSection("song-tag-suggestions-panel", "Suggestions", songTagSuggestionsPanelHasPending(data)) {
		@songTagSuggestionsPanelBody(data)
	}
}

// songTagSuggestionsPanelOOB is SongTagSuggestionsPanel's out-of-band
// refresh, included in SongTagsMutationResponse below - a full outerHTML
// replace by id, the same approach songTagFilterChipsOOB takes for the
// filter chips. Hand-duplicates collapsibleSection's own small wrapper
// markup (rather than modifying collapsibleSection to accept an
// hx-swap-oob attribute, which every other caller would have to thread
// through unused) so the id itself can carry hx-swap-oob="true"; the
// actual suggestion content stays in the one shared
// songTagSuggestionsPanelBody so there's nothing to keep in sync between
// this and SongTagSuggestionsPanel beyond that wrapper.
templ songTagSuggestionsPanelOOB(data SongTagSuggestionsPanelData) {
	<div class={ "collapsible", templ.KV("open", songTagSuggestionsPanelHasPending(data)) } id="song-tag-suggestions-panel" hx-swap-oob="true">
		<button type="button" class="collapsible-toggle" onclick="toggleCollapse(this)" aria-expanded={ fmt.Sprintf("%t", songTagSuggestionsPanelHasPending(data)) }>
			<span>Suggestions</span>
			@components.IconChevronDown()
		</button>
		<div class="collapsible-body">
			@songTagSuggestionsPanelBody(data)
		</div>
	</div>
}

func songTagSuggestionsPanelHasPending(data SongTagSuggestionsPanelData) bool {
	return len(data.TitleGroups) > 0 || len(data.ThemeGroups) > 0
}

// songTagSuggestionsPanelBody is the actual suggestions content shared by
// SongTagSuggestionsPanel and its OOB variant above - two sources, same
// row family, mirroring the old standalone page's two sections
// (SongTagSuggestionsList) just rendered as rows instead of cards.
templ songTagSuggestionsPanelBody(data SongTagSuggestionsPanelData) {
	if !songTagSuggestionsPanelHasPending(data) {
		<p class="muted">No suggestions right now.</p>
	}
	if len(data.TitleGroups) > 0 {
		<h4>From song titles</h4>
		<ul class="suggestion-list song-tag-suggestion-list">
			for _, group := range data.TitleGroups {
				@songTagSuggestionRow(group, fmt.Sprintf("%q appears in %d song titles", group.Word, len(group.Songs)))
			}
		</ul>
	}
	if len(data.ThemeGroups) > 0 {
		<h4>From Planning Center themes</h4>
		<ul class="suggestion-list song-tag-suggestion-list">
			for _, group := range data.ThemeGroups {
				@songTagSuggestionRow(group, fmt.Sprintf("%q appears on %d songs", group.Word, len(group.Songs)))
			}
		</ul>
	}
}

// songTagSuggestionRow is one suggestion group's row in the
// suggestion-list/ListItem family (components/list_item.templ) - the
// closest existing precedent is set_builder.templ's "Recommended next
// songs"/"Songs to reinforce" panels (search "recommended-next-songs"
// there): a title span, muted meta, and a trailing action, reused here
// rather than inventing a new row shape. Unlike that panel's rows, this
// one also recaps the not-yet-tagged songs it's about to select
// (suggestionRowSongTitles) - the matching cards can be anywhere in this
// page's own unconditionally-rendered all-songs list, not just the ones
// currently in view, so this recap is the only place that list appears,
// not a redundant second copy of something already on screen. Skipped
// entirely once every song in the group is already tagged (nothing left
// to select) - matches songTagSuggestionGroups' own allTagged-skip
// behavior (internal/scheduling/song_tag_suggestions.go), which already
// keeps a fully-tagged group out of TitleGroups/ThemeGroups in the first
// place; this is a defensive second check, not the primary guarantee.
templ songTagSuggestionRow(group SongTagSuggestionGroup, why string) {
	{{ untagged := untaggedSuggestedSongs(group.Songs) }}
	if len(untagged) > 0 {
		@components.ListItem("", nil, capitalize(group.Word)) {
			<span class="muted">{ why }</span>
			<span class="muted">{ suggestionRowSongTitles(untagged) }</span>
			<button
				type="button"
				onclick="applySongTagSuggestion(this)"
				data-category={ scheduling.TagCategoryTheme }
				data-value={ capitalize(group.Word) }
				data-song-ids={ suggestionRowSongIDs(untagged) }
			>
				Select these songs
			</button>
			<form
				hx-post="/scheduling/song-tags/suggestions/ignore"
				hx-target="#song-tag-suggestions-panel"
				hx-swap="outerHTML"
				hx-confirm={ fmt.Sprintf("Stop suggesting %q? This can't be undone from here.", group.Word) }
			>
				<input type="hidden" name="word" value={ group.Word }/>
				<button type="submit" class="danger">Ignore</button>
			</form>
		}
	}
}

// untaggedSuggestedSongs filters a suggestion group down to the songs that
// aren't already tagged with its word - those are the only ones
// applySongTagSuggestion (scheduling-song-tags-contexts.js) needs to
// select, and the only ones worth recapping (an already-tagged song's own
// card already shows the tag).
func untaggedSuggestedSongs(songs []SuggestedSongView) []SuggestedSongView {
	out := make([]SuggestedSongView, 0, len(songs))
	for _, s := range songs {
		if !s.AlreadyTagged {
			out = append(out, s)
		}
	}
	return out
}

// suggestionRowSongTitles/suggestionRowSongIDs build songTagSuggestionRow's
// comma-joined title recap and its button's data-song-ids attribute
// (comma-split by applySongTagSuggestion) - both driven off the same
// already-filtered untagged slice so they stay in lockstep.
func suggestionRowSongTitles(songs []SuggestedSongView) string {
	titles := make([]string, len(songs))
	for i, s := range songs {
		titles[i] = s.Title
	}
	return strings.Join(titles, ", ")
}

func suggestionRowSongIDs(songs []SuggestedSongView) string {
	ids := make([]string, len(songs))
	for i, s := range songs {
		ids[i] = s.SongID
	}
	return strings.Join(ids, ",")
}

// capitalize turns a suggestion's lowercase word (see songTagSuggestions in
// the controller) into a reasonable starting point for the tag value's
// text input - "king" -> "King". Purely a starting point: the input is
// fully editable, so renaming it to "Kingship" or anything else is just
// typing over this default. Moved here from the former standalone
// song_tag_suggestions.templ - same helper, same reasoning.
func capitalize(word string) string {
	if word == "" {
		return word
	}
	return strings.ToUpper(word[:1]) + word[1:]
}

// songTagsHelp is this page's Help-triggered dialog - see
// songRelationshipsHelp's own doc comment (relationships.templ) for the
// full reasoning shared by every setup-page help dialog (single step, no
// createTourController, .page-help-dialog for openPageHelp's dispatch, and
// the forward-only Next-link chain / setPageHelpForce mechanism). This is
// page 4 of that chain (... Song Roles -> Song Contexts -> here -> Song
// Vocal Range -> ...).
templ songTagsHelp() {
	<dialog id="song-tags-help" class="tour-dialog page-help-dialog">
		<div class="tour-step">
			<h2>Song Labels</h2>
			<p>
				Tag songs with themes, scripture references, or ideas, so they're
				easier to find when planning around a sermon.
			</p>
		</div>
		<p class="muted tour-footnote">Need this again later? Look for Help at the bottom of any page.</p>
		<div class="tour-actions">
			<a class="button" href="/scheduling/song-vocal-range" onclick="setPageHelpForce()">Next: Song Vocal Range →</a>
			<button type="button" class="button primary" onclick="closeHelpDialog('song-tags-help')">Got it</button>
		</div>
	</dialog>
}

// songTagFilterChips renders the distinct tag values already in use as
// checkbox-backed toggle chips (native checkbox visually hidden, its
// <label> styled as the pill - see .tag-filter-chip, song-tags.css) so
// filtering reads as "select which tags to show" rather than free typing.
// Rendered here (page load) and refreshed via songTagFilterChipsOOB below
// on every create/edit (song_tags.go) so a newly-used tag value's chip
// shows up immediately - id="song-tag-filter-chips" is what
// songTagFilterChipsOOB's hx-swap-oob="true" targets, kept in sync with
// the same id on both. hidden?, not an `if`, so the id stays addressable
// even with zero tags yet (an OOB swap needs an existing element with a
// matching id to replace); .song-tag-filter-chips[hidden] (song-tags.css)
// makes that actually collapse despite the class's own `display: flex`.
templ songTagFilterChips(tagValues []string) {
	<div class="song-tag-filter-chips" id="song-tag-filter-chips" role="group" aria-label="Filter by tag" hidden?={ len(tagValues) == 0 }>
		@songTagFilterChipItems(tagValues)
	</div>
}

// songTagFilterChipsOOB is songTagFilterChips' out-of-band refresh -
// included in SongTagsMutationResponse below (not in SongTagsList itself,
// which the page's own initial render also calls, to avoid rendering the
// chips twice on page load). Checking existing chips isn't touched by this
// swap losing its checked state, since it's a full outerHTML replace by
// id: the JS side (song-tag-filter-chips oobBeforeSwap/oobAfterSwap
// handlers, scheduling-song-tags-contexts.js) captures which values were checked beforehand
// and re-checks the matching new checkboxes after, so a filter someone
// already applied survives a tag add/edit elsewhere on the page.
templ songTagFilterChipsOOB(tagValues []string) {
	<div class="song-tag-filter-chips" id="song-tag-filter-chips" role="group" aria-label="Filter by tag" hidden?={ len(tagValues) == 0 } hx-swap-oob="true">
		@songTagFilterChipItems(tagValues)
	</div>
}

templ songTagFilterChipItems(tagValues []string) {
	for i, v := range tagValues {
		<span class="tag-filter-item">
			<input
				type="checkbox"
				id={ fmt.Sprintf("tag-filter-%d", i) }
				class="song-tag-filter-checkbox"
				value={ strings.ToLower(v) }
				onchange="filterSongTagCards()"
			/>
			<label for={ fmt.Sprintf("tag-filter-%d", i) } class="tag-filter-chip">{ v }</label>
		</span>
	}
}

// distinctTagValues collects every unique tag value across all songs,
// sorted case-insensitively, for songTagFilterChips above.
func distinctTagValues(tagsBySong map[string][]scheduling.SongTag) []string {
	seen := make(map[string]string) // lowercased -> original casing
	for _, tags := range tagsBySong {
		for _, tag := range tags {
			key := strings.ToLower(tag.Value)
			if _, ok := seen[key]; !ok {
				seen[key] = tag.Value
			}
		}
	}
	values := make([]string, 0, len(seen))
	for _, v := range seen {
		values = append(values, v)
	}
	sort.Slice(values, func(i, j int) bool {
		return strings.ToLower(values[i]) < strings.ToLower(values[j])
	})
	return values
}

// SongTagsList is both the initial-render fragment and the htmx swap target
// (id="song-tags-list") for every create/edit/delete on this page - see
// SongTagsTable's old doc comment (song_tags.go history) for why errMsg
// lives inside the swapped fragment rather than the page around it: an
// htmx response only replaces this div, so an error from a create/delete
// has nowhere else to render. successMsg is the same idea for
// BulkCreateSongTag (song_tags.go) - a bulk add can touch songs scattered
// well below the fold, so unlike a single-song add (that song's own card
// is already right there in view) there's otherwise no confirmation the
// action actually did anything. Also carries the #song-tag-value-options
// <datalist> every card's own "Value" input points its list= attribute at
// (autocomplete for re-using an existing tag value, see SongTagCard) -
// deliberately inside the swapped fragment, unlike songTagFilterChips'
// checkboxes above, since a datalist has no user-set state that a re-swap
// could lose, so it may as well pick up a brand-new tag value on the very
// next add instead of waiting for a page reload.
templ SongTagsList(songs []pco.SongData, tagsBySong map[string][]scheduling.SongTag, categories []scheduling.SongTagCategory, categoryLabels map[string]string, successMsg, errMsg string) {
	<div id="song-tags-list" class="song-tags-list">
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		if len(songs) == 0 {
			<p class="muted">No active songs found.</p>
		}
		<datalist id="song-tag-value-options">
			for _, v := range distinctTagValues(tagsBySong) {
				<option value={ v }></option>
			}
		</datalist>
		for _, song := range songs {
			@SongTagCard(song, tagsBySong[song.ID], categories, categoryLabels)
		}
	</div>
}

// SongTagsMutationResponse is CreateSongTag/BulkCreateSongTag/DeleteSongTag's
// htmx response (song_tags.go): SongTagsList as the primary swap target,
// plus songTagFilterChipsOOB's own out-of-band refresh so a newly-used tag
// value's filter chip appears without a reload - see that function's doc
// comment - and songTagSuggestionsPanelOOB's own refresh, since any of
// these three mutations can shrink or remove a suggestion group (a tag
// just got added/edited/removed). Kept separate from SongTagsList itself
// so SongTags' initial full-page render (which calls SongTagsList
// directly) doesn't render the chips/panel twice.
templ SongTagsMutationResponse(songs []pco.SongData, tagsBySong map[string][]scheduling.SongTag, categories []scheduling.SongTagCategory, categoryLabels map[string]string, panelData SongTagSuggestionsPanelData, successMsg, errMsg string) {
	@SongTagsList(songs, tagsBySong, categories, categoryLabels, successMsg, errMsg)
	@songTagFilterChipsOOB(distinctTagValues(tagsBySong))
	@songTagSuggestionsPanelOOB(panelData)
}

// SongTagCard is one song's persistent card: its existing tags as chips
// (grouped in whatever order ListSongTags/tagsBySong already returns them -
// see songTagsBySong's own doc comment), each with inline edit/remove
// actions, plus this song's own small "add a tag" form. song_id is fixed
// (a hidden input, not a picker) since the card itself already identifies
// the song - unlike the old shared form, there's nothing to pick here.
// data-search backs the page's client-side filter (filterSongTagCards,
// scheduling-song-tags-contexts.js): the song's title plus every one of its tag values, so
// filtering also surfaces "which songs are tagged 'grace'" without a
// server round trip.
templ SongTagCard(song pco.SongData, tags []scheduling.SongTag, categories []scheduling.SongTagCategory, categoryLabels map[string]string) {
	<div class="song-tag-card" data-search={ songTagCardSearchText(song, tags) } data-tags={ songTagCardTagsAttr(tags) }>
		@components.Card(song.Attributes.Title) {
			<label class="song-tag-bulk-select">
				<input
					type="checkbox"
					class="song-tag-bulk-checkbox"
					name="song_ids"
					form="song-tag-bulk-form"
					value={ song.ID }
					onchange="updateSongTagBulkCount()"
				/>
				Select for bulk add
			</label>
			if len(tags) == 0 {
				<p class="muted song-tag-empty">No tags yet.</p>
			} else {
				<div class="song-tag-chips">
					for _, tag := range tags {
						<span class="tag-chip">
							@components.TagBadge(tag.Value, displayNameOrID(categoryLabels, tag.Category))
							<button
								class="icon-btn"
								aria-label={ fmt.Sprintf("Edit %q tag", tag.Value) }
								title="Edit tag"
								data-edit-form={ songTagFormID(song.ID) }
								data-edit-fields={ editFieldsAttr(map[string]string{
									"id":       strconv.FormatInt(tag.ID, 10),
									"song_id":  tag.SongID,
									"category": tag.Category,
									"value":    tag.Value,
								}) }
								onclick="editRow(this)"
							>
								@components.IconEdit()
							</button>
							<button
								class="danger icon-btn"
								aria-label={ fmt.Sprintf("Remove %q tag", tag.Value) }
								title="Remove tag"
								hx-delete={ fmt.Sprintf("/scheduling/song-tags/%d", tag.ID) }
								hx-target="#song-tags-list"
								hx-swap="outerHTML"
								hx-confirm="Remove this tag?"
							>
								@components.IconRemove()
							</button>
						</span>
					}
				</div>
			}
			<details class="song-tag-add-details">
				<summary class="song-tag-add-toggle">+ Add tag</summary>
				<form
					id={ songTagFormID(song.ID) }
					class="inline song-tag-add-form"
					hx-post="/scheduling/song-tags"
					hx-target="#song-tags-list"
					hx-swap="outerHTML"
					hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
				>
					<input type="hidden" name="id"/>
					<input type="hidden" name="song_id" value={ song.ID }/>
					<label>
						Category
						<select name="category">
							for _, cat := range categories {
								<option value={ cat.Code }>{ cat.Label }</option>
							}
						</select>
					</label>
					<label>
						Value
						<input type="text" name="value" list="song-tag-value-options" placeholder="e.g. Grace, Romans 8:1, New beginnings" required/>
					</label>
					<button type="submit" class="primary">Add tag</button>
					<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
				</form>
			</details>
		}
	</div>
}

// songTagFormID is the per-card add/edit form's id, shared between the
// form itself and its own chips' Edit buttons (data-edit-form) - each
// song needs its own uniquely-id'd form since every card renders one, unlike
// the old page's single shared "song-tag-form".
func songTagFormID(songID string) string {
	return "song-tag-form-" + songID
}

// songTagCardSearchText builds one song card's data-search attribute value:
// its title plus every tag value already showing on the card, lowercased so
// filterSongTagCards' own lowercased query matches case-insensitively.
func songTagCardSearchText(song pco.SongData, tags []scheduling.SongTag) string {
	parts := make([]string, 0, len(tags)+1)
	parts = append(parts, song.Attributes.Title)
	for _, tag := range tags {
		parts = append(parts, tag.Value)
	}
	return strings.ToLower(strings.Join(parts, " "))
}

// songTagCardTagsAttr builds one card's data-tags attribute: its tag
// values only (no title), lowercased and pipe-delimited with leading/
// trailing pipes so filterSongTagCards (scheduling-song-tags-contexts.js) can test exact
// membership (`"|" + tag + "|"`) against a checked filter chip's value,
// rather than songTagCardSearchText's substring match - a chip for tag
// "Grace" shouldn't also match a card merely because some other tag's
// value happens to contain "grace" as a substring.
func songTagCardTagsAttr(tags []scheduling.SongTag) string {
	if len(tags) == 0 {
		return ""
	}
	values := make([]string, 0, len(tags))
	for _, tag := range tags {
		values = append(values, strings.ToLower(tag.Value))
	}
	return "|" + strings.Join(values, "|") + "|"
}
