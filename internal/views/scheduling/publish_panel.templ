package scheduling

import "fmt"

// hasPendingPublish reports whether there's anything for Publish to
// actually do - every kind of local change PublishSet covers (sets.go):
// creates, deletes, reorders, and (as of the InfoPending work) pending
// note/key edits on already-published songs. Also gates Discard's own
// visibility below - both buttons only make sense when the same thing is
// true, "there's a real local change sitting here."
func hasPendingPublish(data SetBuilderData) bool {
	return data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 || data.ReorderPending || data.InfoPendingCount > 0
}

// publishButtonTitle explains why the Publish button is disabled - "" (no
// tooltip) the rest of the time, since a plain title on an enabled button
// would just repeat what the button's own label and the page around it
// already say.
func publishButtonTitle(data SetBuilderData) string {
	if hasPendingPublish(data) {
		return ""
	}
	return "Nothing to publish - your local set already matches Planning Center"
}

// hasPendingRosterPublish/rosterPublishButtonTitle are hasPendingPublish/
// publishButtonTitle's people equivalent - the roster side has no
// ReorderPending or InfoPending concept (positions aren't reordered, and
// there's no per-occurrence note/key field on an assignment), so this is
// just the two counts that already exist.
func hasPendingRosterPublish(data RosterBuilderData) bool {
	return data.UnpublishedCount > 0 || data.PendingDeleteCount > 0
}

func rosterPublishButtonTitle(data RosterBuilderData) string {
	if hasPendingRosterPublish(data) {
		return ""
	}
	return "Nothing to publish - your local roster already matches Planning Center"
}

// publishCardShell/publishCardShellOOB are the build-publish-card wrapper
// SongPublishPanel/RosterPublishPanel (and their OOB siblings) share -
// only the wrapper is identical between songs and team; songPublishPanelContent/
// rosterPublishPanelContent (below) stay separate since their actual
// content genuinely differs (song publish has a pending-changes list and a
// refresh-info form the roster side has no equivalent of).
templ publishCardShell(id string, hidden bool) {
	<div class="build-publish-card" id={ id } hidden?={ hidden }>
		{ children... }
	</div>
}

// hidden here (unlike publishCardShell's own required param) exists only
// for the lazy-load OOB variants below (songPublishPanelLazyOOB/
// rosterPublishPanelLazyOOB): every other caller fires while its own tab
// is already the active one (see songPublishPanelOOB's doc comment) and
// passes false, matching the pre-existing behavior of never setting
// hidden at all.
templ publishCardShellOOB(id string, hidden bool) {
	<div class="build-publish-card" id={ id } hidden?={ hidden } hx-swap-oob="true">
		{ children... }
	</div>
}

// SongPublishPanel is the Songs tab's publish/discard controls, rendered
// in the Build page's sidebar (see build.templ) instead of inline under
// the order-of-service table - the whole point of a margin once there's a
// second column to put things in. Shown only while the Songs tab is
// actually open (hidden mirrors build.templ's activeTab, same as the
// glance cards but inverted - this is the tab you're ON, not the other
// one) - toggleBuildTab (scheduling.js) flips it by id, same as it does
// the glance cards.
//
// Every add/remove/duplicate/replace/tag/relate/role/publish/discard
// action on the Songs tab still returns SetBuilderBody as its htmx
// response (hx-target="#set-builder-body"), which no longer renders this
// panel itself - instead it carries an out-of-band copy (songPublishPanelOOB
// below) that updates this same sidebar card in place via hx-swap-oob,
// regardless of where in the document it actually lives. So this card
// stays in sync with every mutation, not just an explicit Publish/Discard
// click. songPublishPanelOOB never sets hidden itself: it only ever fires
// while its own tab's now-visible forms are what triggered it, so the tab
// it belongs to is already the active one by definition.
templ SongPublishPanel(data SetBuilderData, hidden bool) {
	@publishCardShell("build-publish-songs", hidden) {
		@songPublishPanelContent(data)
	}
}

templ songPublishPanelOOB(data SetBuilderData) {
	@publishCardShellOOB("build-publish-songs", false) {
		@songPublishPanelContent(data)
	}
}

// songPublishPanelLazyOOB is songPublishPanelOOB's counterpart for
// BuildSongsTabLazy (build.go) - fired while the Songs tab is the
// *inactive*, just-fetched one (see pco-api-risks.md's mitigation #3), so
// unlike songPublishPanelOOB it must stay hidden: without this, hovering
// the Songs tab button while on Team would make the Songs publish/discard
// controls pop into view in the sidebar before the user ever switches.
// Still needed at all (not skippable) so that switching to Songs later,
// via toggleBuildTab, reveals this card with real data instead of the
// empty one rendered at initial page load.
templ songPublishPanelLazyOOB(data SetBuilderData) {
	@publishCardShellOOB("build-publish-songs", true) {
		@songPublishPanelContent(data)
	}
}

templ songPublishPanelContent(data SetBuilderData) {
	<h3>Publish Songs</h3>
	if data.ReadOnly {
		<p class="muted">This plan has already happened - shown read-only, no Publish/Discard actions.</p>
	} else if len(data.SetSongs) > 0 || data.PendingDeleteCount > 0 {
		if data.PendingDeleteCount > 0 {
			<div class="warning">
				{ fmt.Sprintf("%d song(s) removed/replaced here are still live in Planning Center - publishing will delete them there too.", data.PendingDeleteCount) }
			</div>
		}
		if len(data.PendingChanges) > 0 {
			<p><strong>Pending changes</strong>:</p>
			<ul class="pending-changes">
				for _, change := range data.PendingChanges {
					<li>{ change }</li>
				}
			</ul>
		}
		<div class="publish-actions">
			<form
				hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/publish", data.ServiceTypeID, data.PlanID) }
				hx-target="#set-builder-body"
				hx-swap="outerHTML"
				hx-confirm={ fmt.Sprintf("Sync this set to Planning Center? %d song(s) added, %d removed, any already-published songs reordered to match, and %d note/key update(s) pushed.", data.UnpublishedCount, data.PendingDeleteCount, data.InfoPendingCount) }
			>
				<button
					type="submit"
					class="primary"
					disabled?={ !hasPendingPublish(data) }
					title={ publishButtonTitle(data) }
				>Publish to Planning Center</button>
			</form>
			if hasPendingPublish(data) {
				<form
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
					hx-confirm="Discard every change you've made here and rebuild this set from what's currently live in Planning Center? This can't be undone."
				>
					<button type="submit" class="danger">Discard changes</button>
				</form>
			}
			<!--
				The non-destructive middle ground between Publish and Discard:
				pulls in anything added directly in Planning Center since this
				draft was last touched, without discarding or altering any
				local change (unpublished adds, removals, reordering, pending
				note/key edits) - see MergeSet. Doesn't require a published
				song the way Re-sync below does, so it's offered any time the
				set exists and isn't read-only - but only when
				MergeAvailableCount actually says there's something to pull
				in, so this button doesn't sit here doing nothing every week
				nothing's changed directly in Planning Center.
			-->
			if data.MergeAvailableCount > 0 {
				<form
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/merge", data.ServiceTypeID, data.PlanID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
					hx-confirm={ fmt.Sprintf("Pull in %d song(s) added directly in Planning Center since this draft was last touched? Your own local changes (adds, removals, reordering, note/key edits) are left exactly as they are - this only adds what's new.", data.MergeAvailableCount) }
				>
					<button type="submit">{ fmt.Sprintf("Pull in %d song(s) from Planning Center", data.MergeAvailableCount) }</button>
				</form>
			}
			<!--
				The low-cost alternative to Discard for when an already-
				published song's key/length/arrangement was wrong or missing
				at publish time (e.g. a bug since fixed, or a stale Song Info
				cache entry) - see RefreshSongInfo. Only shown once there's at
				least one already-published song to refresh; Discard above
				still exists for anything this doesn't cover (title, order,
				which songs are even in the set).
			-->
			if data.UnpublishedCount < len(data.SetSongs) {
				<form
					hx-post={ fmt.Sprintf("/scheduling/sets/%s/%s/refresh-info", data.ServiceTypeID, data.PlanID) }
					hx-target="#set-builder-body"
					hx-swap="outerHTML"
					hx-confirm="Re-push every already-published song's current key, length, and arrangement to Planning Center? This only updates existing items - it doesn't add, remove, or reorder anything, so your local set stays exactly as it is."
				>
					<button
						type="submit"
						title="Fixes a wrong/missing key, length, or arrangement on songs already published to Planning Center - without discarding and republishing the whole set"
					>Re-sync key, length &amp; arrangement</button>
				</form>
			}
		</div>
		<!--
			Trimmed to the gist - the full explanation (what publish/discard
			each actually do, item by item) lives in the buttons' own
			hx-confirm text above, right where it matters (before someone
			commits to the click), so it doesn't need repeating in prose that
			has to wrap through a 15rem column too.
		-->
		<p class="muted">Publishing syncs this set to Planning Center. Discarding rebuilds it from what's live there now.</p>
	} else {
		<p class="muted">Nothing to publish yet - add a song to get started.</p>
	}
}

// RosterPublishPanel is the Team tab's publish/discard controls - the
// people equivalent of SongPublishPanel, which this mirrors in full
// (including the tab-scoped hidden and the out-of-band sync via
// rosterPublishPanelOOB).
templ RosterPublishPanel(data RosterBuilderData, hidden bool) {
	@publishCardShell("build-publish-team", hidden) {
		@rosterPublishPanelContent(data)
	}
}

templ rosterPublishPanelOOB(data RosterBuilderData) {
	@publishCardShellOOB("build-publish-team", false) {
		@rosterPublishPanelContent(data)
	}
}

// rosterPublishPanelLazyOOB is songPublishPanelLazyOOB's people
// equivalent - see its doc comment, which this mirrors in full.
templ rosterPublishPanelLazyOOB(data RosterBuilderData) {
	@publishCardShellOOB("build-publish-team", true) {
		@rosterPublishPanelContent(data)
	}
}

templ rosterPublishPanelContent(data RosterBuilderData) {
	<h3>Publish Team</h3>
	if data.ReadOnly {
		<p class="muted">This plan has already happened - shown read-only, no Publish/Discard actions.</p>
	} else if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 || len(data.Positions) > 0 {
		if data.PendingDeleteCount > 0 {
			<div class="warning">
				{ fmt.Sprintf("%d assignment(s) removed here are still live in Planning Center - publishing will remove them there too.", data.PendingDeleteCount) }
			</div>
		}
		<div class="publish-actions">
			<form
				hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/publish", data.ServiceTypeID, data.PlanID) }
				hx-target="#roster-builder-body"
				hx-swap="outerHTML"
				hx-confirm={ fmt.Sprintf("Sync this roster to Planning Center? %d assignment(s) added, %d removed.", data.UnpublishedCount, data.PendingDeleteCount) }
			>
				<button
					type="submit"
					class="primary"
					disabled?={ !hasPendingRosterPublish(data) }
					title={ rosterPublishButtonTitle(data) }
				>Publish to Planning Center</button>
			</form>
			if hasPendingRosterPublish(data) {
				<form
					hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
					hx-target="#roster-builder-body"
					hx-swap="outerHTML"
					hx-confirm="Discard every change you've made here and rebuild this roster from what's currently live in Planning Center? This can't be undone."
				>
					<button type="submit" class="danger">Discard changes</button>
				</form>
			}
		</div>
		<p class="muted">Publishing syncs this roster to Planning Center. Discarding rebuilds it from what's live there now.</p>
	} else {
		<p class="muted">Nothing to publish yet - add a position to get started.</p>
	}
}
