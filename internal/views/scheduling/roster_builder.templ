package scheduling

import (
	"fmt"
	"strconv"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
)

// RosterBuilderBody is both the initial-render fragment and the htmx swap
// target (id="roster-builder-body") for every add/remove action below - see
// SetBuilderBody, which this mirrors.
templ RosterBuilderBody(data RosterBuilderData) {
	<div id="roster-builder-body">
		if data.ErrMsg != "" {
			<p class="error">{ data.ErrMsg }</p>
		}
		if data.PublishMsg != "" {
			<p class="success">{ data.PublishMsg }</p>
		}
		@RosterStatusSummary(data)
		for _, msg := range data.ExistingConflicts {
			<div class="warning">{ msg }</div>
		}
		if data.ImportableAssignmentCount > 0 {
			<div class="import-banner">
				<p>
					{ fmt.Sprintf("Looks like this service is already planned in Planning Center - it has %d position(s) filled.", data.ImportableAssignmentCount) }
					Want to import them here so you can reassign or remove people?
				</p>
				<form
					hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
					hx-target="#roster-builder-body"
					hx-swap="outerHTML"
				>
					<button type="submit" class="primary">Import from Planning Center</button>
				</form>
			</div>
		}
		<!--
			A one-shot nudge, not a permanent fixture - only ever appears
			right after AddRosterAssignment finds someone else already on
			this roster (see views.PersonPairPromptView, and
			SetBuilderData.SongPairPrompt which this mirrors), and disappears
			again the moment you do anything else. Lets "just put A and B on
			the same team, and by the way they work well together" get
			captured right where it happens, instead of re-picking both
			people from scratch in the Quick add panel below - which stays
			around for relating people who aren't both freshly added, or
			after the fact.
		-->
		if data.PersonPairPrompt != nil {
			<div class="import-banner">
				<p>
					{ fmt.Sprintf("Added %q to the team, right after %q - ", data.PersonPairPrompt.NewPersonName, data.PersonPairPrompt.PreviousPersonName) }
					want to remember how these two work together?
					<button type="button" class="icon-btn" aria-label="Dismiss" title="Dismiss" onclick="this.closest('.import-banner').remove()">
						@views.IconX()
					</button>
				</p>
				<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/person-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
					<input type="hidden" name="person_id_a" value={ data.PersonPairPrompt.PreviousPersonID }/>
					<input type="hidden" name="person_id_b" value={ data.PersonPairPrompt.NewPersonID }/>
					<label>
						Relationship
						<select name="relationship_type">
							for _, t := range data.PersonRelationshipTypes {
								<option value={ t.Code } selected?={ t.Code == scheduling.PersonRelationshipWorksWell }>{ t.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="primary">Remember this</button>
				</form>
			</div>
		}
		<!--
			Ad hoc creation of the setup-level entity this page's "Recommended
			next" suggestions are built from (works-well-with/mentorship
			relationships) - see QuickAddPersonRelationship in rosters.go. Same
			fields, same Store method as person_relationships.templ's own
			create form, just reachable without leaving this page.
		-->
		@collapsibleSection("quick-add-relationship-team", "+ Quick add a relationship", false) {
			<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/person-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
				@PersonPickerField("Person A", "person_id_a", "qa-a")
				@PersonPickerField("Person B", "person_id_b", "qa-b")
				<label>
					Relationship
					<select name="relationship_type">
						for _, t := range data.PersonRelationshipTypes {
							<option value={ t.Code }>{ t.Label }</option>
						}
					</select>
				</label>
				<button type="submit" class="primary">Relate people</button>
			</form>
		}
		<h2>Positions</h2>
		if len(data.Positions) == 0 {
			if data.ImportableAssignmentCount > 0 {
				<p class="muted">Planning Center has no open positions left on this plan - everything's filled (see above).</p>
			} else {
				<p class="muted">Nothing needed yet - Planning Center has no open positions configured for this plan.</p>
			}
		}
		for i, pos := range data.Positions {
			<!--
				Fully-staffed positions are the low-signal case - collapsed by
				default so an almost-done roster doesn't look as busy as a
				mostly-empty one; still-open positions (the ones actually
				needing a decision) stay expanded. The <h3>-wraps-<button>
				structure is the standard accessible disclosure pattern -
				see toggleCollapse in scheduling.js - built by hand here rather
				than through collapsibleSection since the heading's own text is
				per-position and its default open/closed state depends on
				pos.Assigned/pos.Quantity.
			-->
			<div
				if len(pos.Assigned) < pos.Quantity {
					class="position-group collapsible open"
				} else {
					class="position-group collapsible"
				}
				id={ fmt.Sprintf("position-group-%d", i) }
			>
				<h3>
					<button type="button" class="collapsible-toggle" onclick="toggleCollapse(this)" aria-expanded={ fmt.Sprintf("%t", len(pos.Assigned) < pos.Quantity) }>
						<span>
							{ pos.TeamName } / { pos.TeamPositionName }
							<span class="muted">({ strconv.Itoa(len(pos.Assigned)) } of { strconv.Itoa(pos.Quantity) } filled)</span>
						</span>
						@views.IconChevronDown()
					</button>
				</h3>
				<div class="collapsible-body">
					if len(pos.Assigned) > 0 {
						<ul class="assignment-list">
							for _, a := range pos.Assigned {
								<li>
									<span>{ a.Name }</span>
									<span class="badge">{ a.Status }</span>
									if a.Published {
										<span class="badge published">Published</span>
									}
									if a.FrequencyWarning != "" {
										<span class="conflict-badge">⚠ { a.FrequencyWarning }</span>
									}
									if a.BlockoutWarning != "" {
										<span class="conflict-badge">⚠ { a.BlockoutWarning }</span>
									}
									<button
										type="button"
										class="danger icon-btn"
										aria-label="Remove from position"
										title="Remove from position"
										hx-delete={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments/%d", data.ServiceTypeID, data.PlanID, a.ID) }
										hx-target="#roster-builder-body"
										hx-swap="outerHTML"
										hx-confirm="Remove this person from this position?"
									>
										@views.IconRemove()
									</button>
								</li>
							}
						</ul>
					}
					if len(pos.Candidates) > 0 {
						<ul class="candidate-list">
							for _, cand := range pos.Candidates {
								<li class="candidate-row">
									<span>{ cand.Name }</span>
									<span class="muted">{ cand.SchedulePreference }</span>
									if cand.FrequencyWarning != "" {
										<span class="conflict-badge">⚠ { cand.FrequencyWarning }</span>
									}
									if cand.BlockoutWarning != "" {
										<span class="conflict-badge">⚠ { cand.BlockoutWarning }</span>
									}
									<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
										<input type="hidden" name="person_id" value={ cand.PersonID }/>
										<input type="hidden" name="team_id" value={ pos.TeamID }/>
										<input type="hidden" name="team_position_name" value={ pos.TeamPositionName }/>
										<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
											@views.IconAdd()
										</button>
									</form>
								</li>
							}
						</ul>
					} else if len(pos.Assigned) == 0 {
						<p class="muted">No one eligible for this position yet.</p>
					}
					<!--
						Ad hoc eligibility - the most directly-motivated quick-add on
						this page (this text used to just dead-end to "add eligibility
						under Position Preferences" and send the user away). Posts
						straight at this position (team/position id already known from
						the card), same underlying operation as
						PositionPreferencesPage's own form - see
						QuickAddPositionPreference in rosters.go. Omitted when the
						position's id lookup failed (best-effort, same as the rest of
						this page - see PositionGroupView.TeamPositionID) rather than
						posting to a blank id.
					-->
					if pos.TeamPositionID != "" {
						@collapsibleSection(fmt.Sprintf("quick-add-position-%d", i), "+ Add eligible person", false) {
							<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/position-preferences", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="team_id" value={ pos.TeamID }/>
								<input type="hidden" name="team_position_id" value={ pos.TeamPositionID }/>
								@PersonPickerField("Person", "person_id", fmt.Sprintf("qapos%d", i))
								<label>
									Schedule preference
									<select name="schedule_preference">
										for _, opt := range data.SchedulePreferenceOptions {
											<option value={ opt.Value }>{ opt.Label }</option>
										}
									</select>
								</label>
								<button type="submit" class="primary">Add eligibility</button>
							</form>
						}
					}
				</div>
			</div>
		}
		if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 || len(data.Positions) > 0 {
			<div class="publish-panel">
				if data.PendingDeleteCount > 0 {
					<div class="warning">
						{ fmt.Sprintf("%d assignment(s) removed here are still live in Planning Center - publishing will remove them there too.", data.PendingDeleteCount) }
					</div>
				}
				<div class="publish-actions">
					<form
						hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/publish", data.ServiceTypeID, data.PlanID) }
						hx-target="#roster-builder-body"
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Sync this roster to Planning Center? %d assignment(s) added, %d removed.", data.UnpublishedCount, data.PendingDeleteCount) }
					>
						<button type="submit" class="primary">Publish to Planning Center</button>
					</form>
					if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 {
						<form
							hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
							hx-target="#roster-builder-body"
							hx-swap="outerHTML"
							hx-confirm="Discard every change you've made here and rebuild this roster from what's currently live in Planning Center? This can't be undone."
						>
							<button type="submit" class="danger">Discard changes</button>
						</form>
					}
				</div>
				<p class="muted">
					Publishing fully syncs this roster to the plan: adds new assignments and
					removes ones you removed here. Discarding does the opposite - it throws
					away every local change and rebuilds this roster from what's live in
					Planning Center right now.
				</p>
			</div>
		}
		if len(data.Suggestions) > 0 {
			@collapsibleSection("recommended-next-team", "Recommended next", false) {
				<p class="muted">Based on works-well-with and mentorship relationships with people already on this roster.</p>
				<ul class="suggestion-list">
					for _, sug := range data.Suggestions {
						<li>
							<span>{ sug.Name }</span>
							<span class="muted">{ sug.TeamPositionName } &middot; { sug.RelationshipLabel }</span>
							<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
								<input type="hidden" name="person_id" value={ sug.PersonID }/>
								<input type="hidden" name="team_id" value={ sug.TeamID }/>
								<input type="hidden" name="team_position_name" value={ sug.TeamPositionName }/>
								<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
									@views.IconAdd()
								</button>
							</form>
						</li>
					}
				</ul>
			}
		}
	</div>
}
