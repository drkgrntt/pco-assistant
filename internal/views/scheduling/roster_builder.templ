package scheduling

import (
	"fmt"
	"strconv"

	"pco-assistant/internal/views"
)

templ RosterBuilder(personName string, data RosterBuilderData) {
	@views.Layout("Build a Team", personName) {
		<h1>
			if data.PlanTitle != "" {
				{ data.PlanTitle }
			} else if data.PlanDates != "" {
				{ data.PlanDates }
			} else {
				Team
			}
		</h1>
		if data.PlanTitle != "" && data.PlanDates != "" {
			<p class="muted">{ data.PlanDates }</p>
		}
		<p><a href="/scheduling/rosters">&larr; Choose a different plan</a></p>
		@RosterBuilderBody(data)
	}
}

// RosterBuilderBody is both the initial-render fragment and the htmx swap
// target (id="roster-builder-body") for every add/remove action below - see
// SetBuilderBody, which this mirrors.
templ RosterBuilderBody(data RosterBuilderData) {
	<div id="roster-builder-body">
		if data.ErrMsg != "" {
			<p class="error">{ data.ErrMsg }</p>
		}
		if data.PublishMsg != "" {
			<p class="success">{ data.PublishMsg }</p>
		}

		for _, msg := range data.ExistingConflicts {
			<div class="warning">{ msg }</div>
		}

		<h2>Positions</h2>
		if len(data.Positions) == 0 {
			<p class="muted">Nothing needed yet - Planning Center has no open positions configured for this plan.</p>
		}
		for _, pos := range data.Positions {
			<div class="position-group">
				<h3>
					{ pos.TeamName } / { pos.TeamPositionName }
					<span class="muted">({ strconv.Itoa(len(pos.Assigned)) } of { strconv.Itoa(pos.Quantity) } filled)</span>
				</h3>

				if len(pos.Assigned) > 0 {
					<ul class="assignment-list">
						for _, a := range pos.Assigned {
							<li>
								<span>{ a.Name }</span>
								<span class="badge">{ a.Status }</span>
								if a.Published {
									<span class="badge published">Published</span>
								}
								if a.FrequencyWarning != "" {
									<span class="conflict-badge">⚠ { a.FrequencyWarning }</span>
								}
								if a.BlockoutWarning != "" {
									<span class="conflict-badge">⚠ { a.BlockoutWarning }</span>
								}
								<button
									type="button"
									class="danger icon-btn"
									aria-label="Remove from position"
									title="Remove from position"
									hx-delete={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments/%d", data.ServiceTypeID, data.PlanID, a.ID) }
									hx-target="#roster-builder-body"
									hx-swap="outerHTML"
									hx-confirm="Remove this person from this position?"
								>
									@views.IconRemove()
								</button>
							</li>
						}
					</ul>
				}

				if len(pos.Candidates) > 0 {
					<ul class="candidate-list">
						for _, cand := range pos.Candidates {
							<li class="candidate-row">
								<span>{ cand.Name }</span>
								<span class="muted">{ cand.SchedulePreference }</span>
								if cand.FrequencyWarning != "" {
									<span class="conflict-badge">⚠ { cand.FrequencyWarning }</span>
								}
								if cand.BlockoutWarning != "" {
									<span class="conflict-badge">⚠ { cand.BlockoutWarning }</span>
								}
								<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
									<input type="hidden" name="person_id" value={ cand.PersonID }/>
									<input type="hidden" name="team_id" value={ pos.TeamID }/>
									<input type="hidden" name="team_position_name" value={ pos.TeamPositionName }/>
									<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
										@views.IconAdd()
									</button>
								</form>
							</li>
						}
					</ul>
				} else if len(pos.Assigned) == 0 {
					<p class="muted">No one eligible for this position yet - add eligibility under Position Preferences.</p>
				}
			</div>
		}

		if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 || len(data.Positions) > 0 {
			<div class="publish-panel">
				if data.PendingDeleteCount > 0 {
					<div class="warning">
						{ fmt.Sprintf("%d assignment(s) removed here are still live in Planning Center - publishing will remove them there too.", data.PendingDeleteCount) }
					</div>
				}
				<div class="publish-actions">
					<form
						hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/publish", data.ServiceTypeID, data.PlanID) }
						hx-target="#roster-builder-body"
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Sync this roster to Planning Center? %d assignment(s) added, %d removed.", data.UnpublishedCount, data.PendingDeleteCount) }
					>
						<button type="submit" class="primary">Publish to Planning Center</button>
					</form>
					if data.UnpublishedCount > 0 || data.PendingDeleteCount > 0 {
						<form
							hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
							hx-target="#roster-builder-body"
							hx-swap="outerHTML"
							hx-confirm="Discard every change you've made here and rebuild this roster from what's currently live in Planning Center? This can't be undone."
						>
							<button type="submit" class="danger">Discard changes</button>
						</form>
					}
				</div>
				<p class="muted">
					Publishing fully syncs this roster to the plan: adds new assignments and
					removes ones you removed here. Discarding does the opposite - it throws
					away every local change and rebuilds this roster from what's live in
					Planning Center right now.
				</p>
			</div>
		}

		if len(data.Suggestions) > 0 {
			<h2>Recommended next</h2>
			<p class="muted">Based on works-well-with and mentorship relationships with people already on this roster.</p>
			<ul class="suggestion-list">
				for _, sug := range data.Suggestions {
					<li>
						<span>{ sug.Name }</span>
						<span class="muted">{ sug.TeamPositionName } &middot; { sug.RelationshipLabel }</span>
						<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", data.ServiceTypeID, data.PlanID) } hx-target="#roster-builder-body" hx-swap="outerHTML">
							<input type="hidden" name="person_id" value={ sug.PersonID }/>
							<input type="hidden" name="team_id" value={ sug.TeamID }/>
							<input type="hidden" name="team_position_name" value={ sug.TeamPositionName }/>
							<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
								@views.IconAdd()
							</button>
						</form>
					</li>
				}
			</ul>
		}
	</div>
}
