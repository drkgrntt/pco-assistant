package scheduling

import (
	"fmt"
	"hash/fnv"
	"net/url"
	"strconv"
	"strings"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views/components"
)

// PositionGroupElementID is the stable HTML id for one position group's
// card (collapsibleCard, positionGroupCard below) - derived from the
// group's own (team_id, team_position_name) rather than its index in a
// full Positions slice, so a single group's card can be targeted by a
// narrow htmx mutation (rosters_detail.go) without the server having to
// recompute the *whole* team-sorted Positions list just to learn where
// this one group would have landed in it. Exported so the controller
// layer can compute the exact same id its own hx-target attributes (baked
// into the page at render time) already point at. fnv32a, not a
// cryptographic hash - this only needs to be stable and collision-free
// across one plan's small handful of positions, not adversarially safe.
func PositionGroupElementID(teamID, teamPositionName string) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(teamID + "\x00" + teamPositionName))
	return fmt.Sprintf("position-group-%08x", h.Sum32())
}

// TeamGroupElementID is the stable HTML id for one team's whole card
// (teamGroupCard below) - hashed the same way as PositionGroupElementID,
// off TeamID alone (a team-group card holds every position for one team,
// so there's no second axis to fold in the way a position group needs its
// own team_position_name too). Exported for the same reason
// PositionGroupElementID is: nothing outside this package currently
// targets it directly (team-group cards aren't swapped by any scoped
// mutation - see teamGroupCard's own doc comment), but keeping the id
// derivation next to its sibling avoids two different hashing conventions
// for what's conceptually the same kind of id.
func TeamGroupElementID(teamID string) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(teamID))
	return fmt.Sprintf("team-group-%08x", h.Sum32())
}

// candidateWarningsElementID is the stable HTML id for one candidate row's
// on-demand warnings placeholder span (see the candidate-list rendering in
// positionGroupCard below) - hashed like PositionGroupElementID rather than
// built from the raw ids, since the same person can appear as a candidate
// on more than one position group on this same page (once per position
// they're eligible for), so personID alone wouldn't be a unique HTML id.
func candidateWarningsElementID(teamID, teamPositionName, personID string) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(teamID + "\x00" + teamPositionName + "\x00" + personID))
	return fmt.Sprintf("candidate-warnings-%08x", h.Sum32())
}

// candidateCardElementID is the stable HTML id for one candidate row's own
// sidebar detail card (candidateDetailCard, person_detail_card.templ) and,
// via data-row-id, the row itself (positionGroupCard below) - hashed the
// same way as candidateWarningsElementID, for the same reason (one person
// can be a candidate on more than one position group on this page). A
// distinct prefix keeps this id from ever colliding with
// candidateWarningsElementID's own hash of the same three inputs, since
// both ids can be present on the page for the same candidate at once (the
// warnings span lives inside this card, not in place of it).
func candidateCardElementID(teamID, teamPositionName, personID string) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(teamID + "\x00" + teamPositionName + "\x00" + personID))
	return fmt.Sprintf("candidate-card-%08x", h.Sum32())
}

// candidateGroupElementID is the stable HTML id for one position group's
// own cluster of candidate detail cards in the sidebar (candidateDetailGroup,
// person_detail_card.templ) - hashed like PositionGroupElementID, with its
// own prefix so a position-scoped mutation (rosters_detail.go, which
// already has this position's freshly-recomputed Candidates in hand) can
// refresh just this one position's candidate cards via OOB without
// touching any other position's own candidate cards - or the assigned
// side's personDetailCard entries - elsewhere in the same shared sidebar
// group. See personDetailCardsOOB's own doc comment for why the assigned
// side avoids a full-group re-render the same way, for the same reason:
// not disturbing whatever detail card is currently open elsewhere on the
// page.
func candidateGroupElementID(teamID, teamPositionName string) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(teamID + "\x00" + teamPositionName))
	return fmt.Sprintf("candidate-group-%08x", h.Sum32())
}

// candidateWarningsURL builds the CandidateWarnings (rosters_candidate_
// warnings.go) endpoint URL for one candidate row's "Check for conflicts"
// button - team_id/team_position_name/schedule_preference travel as query
// params (url.Values, not fmt.Sprintf, since team_position_name/
// schedule_preference can contain spaces and other characters that aren't
// safe to drop into a query string unescaped).
func candidateWarningsURL(serviceTypeID, planID, teamID, teamPositionName, personID, schedulePreference string) string {
	q := url.Values{}
	q.Set("team_id", teamID)
	q.Set("team_position_name", teamPositionName)
	q.Set("schedule_preference", schedulePreference)
	return fmt.Sprintf("/scheduling/rosters/%s/%s/candidates/%s/warnings?%s", serviceTypeID, planID, url.PathEscape(personID), q.Encode())
}

// assignedNamesSummary joins every assigned person's name for display right
// in a position's own collapsible header - see positionHeading below.
// Fully-staffed positions collapse by default (low-signal - see
// collapsibleCard's own doc comment), which used to hide who was actually
// on it until you opened the accordion; this puts that same "who's on it"
// answer somewhere visible whether the position is open or closed.
func assignedNamesSummary(assigned []AssignmentView) string {
	names := make([]string, 0, len(assigned))
	for _, a := range assigned {
		names = append(names, a.Name)
	}
	return strings.Join(names, ", ")
}

// assignmentConflictWarnings collects a's non-empty warning strings
// (frequency/blockout/cross-team) for the assignment row's own compact
// conflict indicator below - one badge instead of up to three, since the
// full text of each is already shown on this same person's sidebar detail
// card (personBadgeSpans, person_detail_card.templ) once the row is
// clicked.
func assignmentConflictWarnings(a AssignmentView) []string {
	var msgs []string
	if a.FrequencyWarning != "" {
		msgs = append(msgs, a.FrequencyWarning)
	}
	if a.BlockoutWarning != "" {
		msgs = append(msgs, a.BlockoutWarning)
	}
	if a.CrossTeamWarning != "" {
		msgs = append(msgs, a.CrossTeamWarning)
	}
	return msgs
}

// conflictCountLabel is the compact label for assignmentConflictWarnings'
// badge - the full messages themselves travel as that badge's title
// attribute (a hover), not in this label.
func conflictCountLabel(n int) string {
	if n == 1 {
		return "1 conflict"
	}
	return fmt.Sprintf("%d conflicts", n)
}

// assignedWarningCount is RosterStatusSummary's own "Warnings: N" input -
// how many currently-assigned people have at least one frequency/blockout/
// cross-team warning (assignmentConflictWarnings above), across every
// position group. Added per docs/issues.md ("a few potential warnings...
// don't seem to show up") - the chip previously only counted
// data.ExistingConflicts (avoid-pairing), even though these three warnings
// already render inline on the row per assignmentConflictWarnings above; the
// Songs tab got the equivalent cleanup already (see
// docs/plans/shipped/in-place-set-warnings-plan.md), the Team tab never
// did. Counts affected *people*, not total warning strings, matching
// ExistingConflicts' own "one number per thing needing attention" shape
// (someone with both a frequency and a blockout warning still only adds 1).
func assignedWarningCount(positions []PositionGroupView) int {
	n := 0
	for _, pos := range positions {
		for _, a := range pos.Assigned {
			if len(assignmentConflictWarnings(a)) > 0 {
				n++
			}
		}
	}
	return n
}

// positionHeading is one position group's collapsibleCard heading - a
// multi-span title (position name, muted fill-count, muted "who's on it"
// summary) that collapsibleSection's plain string label can't express.
// Just the position's own name, not "Team / Position" - the surrounding
// team-group heading (RosterBuilderBodyContent) already says which team,
// so repeating it on every position was both redundant and exactly the
// kind of per-position bulk groupPositionsByTeam exists to cut down on.
//
// The "who's on it" summary only renders when the card is collapsed by
// default (fully staffed - see collapsibleCard's own call site) - that's
// the one case it's the *only* place showing who's assigned. An
// understaffed position starts expanded, so its own assignment-list rows
// are already visible right below this same heading; repeating every
// name here too was pure duplication, and the biggest single contributor
// to an open position's heading reading as busy.
templ positionHeading(pos PositionGroupView) {
	{{ open := len(pos.Assigned) < pos.Quantity }}
	<span>
		{ pos.TeamPositionName }
		<span class="muted">({ strconv.Itoa(len(pos.Assigned)) } of { strconv.Itoa(pos.Quantity) } filled)</span>
		if open {
			@components.Badge("status-needed", fmt.Sprintf("%d needed", pos.Quantity-len(pos.Assigned)))
		}
		if len(pos.Assigned) > 0 && !open {
			<span class="muted">- { assignedNamesSummary(pos.Assigned) }</span>
		}
	</span>
}

// positionGroupItem pairs one PositionGroupView with its original index in
// RosterBuilderData.Positions - kept for callers/tests that care about
// original ordering (see groupPositionsByTeam's own tests). Each position's
// own card id no longer derives from this (see PositionGroupElementID
// above, which is content-derived instead - stable across a narrow
// single-group re-render that never recomputes the full, team-sorted
// Positions list this index is relative to).
type positionGroupItem struct {
	Index int
	Pos   PositionGroupView
}

// teamPositionGroup is one team's cluster of positions, in display order -
// see groupPositionsByTeam.
type teamPositionGroup struct {
	TeamID    string
	TeamName  string
	Positions []positionGroupItem
}

// groupPositionsByTeam clusters RosterBuilderData.Positions by team for
// display - buildRosterBuilderData (rosters_builder.go) already sorts
// Positions by each team's own Planning Center Sequence before this ever
// runs, so a plain consecutive-run walk is all this needs; it doesn't
// re-sort anything itself, just splits an already-grouped slice into named
// groups.
func groupPositionsByTeam(positions []PositionGroupView) []teamPositionGroup {
	var groups []teamPositionGroup
	for i, pos := range positions {
		if len(groups) == 0 || groups[len(groups)-1].TeamID != pos.TeamID {
			groups = append(groups, teamPositionGroup{TeamID: pos.TeamID, TeamName: pos.TeamName})
		}
		g := &groups[len(groups)-1]
		g.Positions = append(g.Positions, positionGroupItem{Index: i, Pos: pos})
	}
	return groups
}

// RosterBuilderBody is the htmx swap target (id="roster-builder-body") for
// every add/remove action below - see SetBuilderBody, which this mirrors,
// including bundling rosterPublishPanelOOB/personDetailCardsOOB/
// rosterGlanceOOB alongside RosterBuilderBodyContent to keep the sidebar's
// Team publish card, detail cards, and "Team, at a glance" card in sync.
templ RosterBuilderBody(data RosterBuilderData) {
	@RosterBuilderBodyContent(data)
	@rosterPublishPanelOOB(data)
	@personDetailCardsOOB(data)
	@rosterGlanceOOB(data)
}

// RosterBuilderBodyLazy is SetBuilderBodyLazy's people equivalent - see its
// doc comment, which this mirrors in full, for BuildTeamTabLazy (build.go).
templ RosterBuilderBodyLazy(data RosterBuilderData) {
	@RosterBuilderBodyContent(data)
	@rosterPublishPanelLazyOOB(data)
	@personDetailCardsLazyOOB(data)
	@rosterGlanceLazyOOB(data)
}

// rosterTop is the roster builder's shared banner block - status chips,
// existing-conflicts warnings, the "import from Planning Center" banner,
// and the one-shot pair-relate prompt - broken out into its own
// addressable fragment (id="roster-top") so a mutation that doesn't touch
// any specific position (QuickAddPersonRelationship - creating a
// relationship changes none of Positions' Assigned/Candidates data) can
// still refresh this without a full #roster-builder-body re-render, the
// same way songBadges (set_builder.templ) lets a narrower set-builder
// response still push a fresh copy of just its own slice of the page.
// This is the primary (non-OOB) response for
// QuickAddPersonRelationship and its own pair-prompt form; every
// position-scoped mutation (AddRosterAssignment, RemoveRosterAssignment,
// QuickAddPositionPreference - rosters_detail.go) instead includes it as
// an out-of-band update via rosterTopOOB below, since their own primary
// response is a single position group's card.
templ rosterTop(data RosterBuilderData) {
	<div id="roster-top">
		@rosterTopContent(data)
	</div>
}

templ rosterTopOOB(data RosterBuilderData) {
	<div id="roster-top" hx-swap-oob="true">
		@rosterTopContent(data)
	</div>
}

templ rosterTopContent(data RosterBuilderData) {
	if data.ErrMsg != "" {
		<p class="error" role="alert">{ data.ErrMsg }</p>
	}
	if data.PublishMsg != "" {
		<p class="success">{ data.PublishMsg }</p>
	}
	if data.PersonDataSyncPending {
		<p class="muted">Availability and conflict warnings are still loading for this team - check back in a couple of minutes.</p>
	}
	// Team/position data (who's on the team, what positions are open) is
	// cached for up to 20 seconds (see rosters_shared_cache.go) so a
	// change made directly in Planning Center - someone added to a team
	// mid-session, say - can lag behind by that much. This button is the
	// explicit, cheap remedy: bypasses the cache and rebuilds the whole
	// roster from a fresh live fetch. Deliberately not gated on
	// data.ReadOnly - unlike Import/Revert below, this never writes
	// anything local, so it's harmless (if not especially useful) to
	// offer on a past, read-only plan too.
	<form
		class="inline"
		hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/refresh-team-data", data.ServiceTypeID, data.PlanID) }
		hx-target="#roster-builder-body"
		hx-swap="outerHTML"
	>
		<button
			type="submit"
			title="Re-pull current team membership and open positions from Planning Center right now, instead of waiting for the cached copy (up to 20 seconds old) to expire on its own"
			aria-label="Refresh team data from Planning Center"
		>
			Refresh team data
		</button>
	</form>
	@RosterStatusSummary(data)
	for _, msg := range data.ExistingConflicts {
		<div class="warning">{ msg }</div>
	}
	if data.ReadOnly {
		<p class="muted">This plan has already happened - shown read-only for reference.</p>
	}
	if !data.ReadOnly && data.ImportableAssignmentCount > 0 {
		@components.ImportBanner(fmt.Sprintf("Looks like this service is already planned in Planning Center - it has %d position(s) filled. Want to import them here so you can reassign or remove people?", data.ImportableAssignmentCount), false) {
			<form
				hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/revert", data.ServiceTypeID, data.PlanID) }
				hx-target="#roster-builder-body"
				hx-swap="outerHTML"
			>
				<button type="submit" class="primary">Import from Planning Center</button>
			</form>
		}
	}
	// A one-shot nudge, not a permanent fixture - only ever appears
	// right after AddRosterAssignment finds someone else already on
	// this roster (see views.PersonPairPromptView, and
	// SetBuilderData.SongPairPrompt which this mirrors), and disappears
	// again the moment you do anything else. Lets "just put A and B on
	// the same team, and by the way they work well together" get
	// captured right where it happens, instead of re-picking both
	// people from scratch in the Quick add panel below - which stays
	// around for relating people who aren't both freshly added, or
	// after the fact.
	if !data.ReadOnly && data.PersonPairPrompt != nil {
		@components.ImportBanner(fmt.Sprintf("Added %q to the team, right after %q - want to remember how these two work together?", data.PersonPairPrompt.NewPersonName, data.PersonPairPrompt.PreviousPersonName), true) {
			<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/person-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#roster-top" hx-swap="outerHTML">
				<input type="hidden" name="person_id_a" value={ data.PersonPairPrompt.PreviousPersonID }/>
				<input type="hidden" name="person_id_b" value={ data.PersonPairPrompt.NewPersonID }/>
				<label>
					Relationship
					<select name="relationship_type">
						for _, t := range data.PersonRelationshipTypes {
							<option value={ t.Code } selected?={ t.Code == scheduling.PersonRelationshipWorksWell }>{ t.Label }</option>
						}
					</select>
				</label>
				<button type="submit" class="primary">Remember this</button>
			</form>
		}
	}
}

// RosterBuilderBodyContent is the actual content - see
// SetBuilderBodyContent, which this mirrors, for why it's split out from
// RosterBuilderBody.
templ RosterBuilderBodyContent(data RosterBuilderData) {
	// aria-live="polite" (4.1.3 Status Messages, Finding 2 -
	// docs/plans/shipped/wcag-aa-audit-plan.md) - the primary swap target
	// for basically every action on this page (assign/unassign a person,
	// errors), previously silent to a screen reader user.
	<div id="roster-builder-body" aria-live="polite">
		@rosterTop(data)
		// Ad hoc creation of the setup-level entity this page's "Recommended
		// next" suggestions are built from (works-well-with/mentorship
		// relationships) - see QuickAddPersonRelationship in rosters_detail.go. Same
		// fields, same Store method as person_relationships.templ's own
		// create form, just reachable without leaving this page.
		if !data.ReadOnly {
			@collapsibleSection("quick-add-relationship-team", "+ Quick add a relationship", false) {
				// Unlike this page's other quick-add forms, this one's own
				// hx-target (#roster-top) never includes the form itself - a
				// relationship touches no position, so its response is scoped to
				// the shared banner block, not this panel (see
				// RosterTopMutationResponse's doc comment, rosters_detail.go). A
				// plain outerHTML swap therefore can't reset these fields back to
				// blank the way it does for every position-scoped quick-add form
				// on this page (whose own response *is* the card containing them,
				// freshly re-rendered empty) - so this resets explicitly instead,
				// same as every setup-page create form (person_relationships.templ
				// etc.) already does for the same reason.
				<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/person-relationships", data.ServiceTypeID, data.PlanID) } hx-target="#roster-top" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)">
					@PersonPickerField("Person A", "person_id_a", "qa-a")
					@PersonPickerField("Person B", "person_id_b", "qa-b")
					<label>
						Relationship
						<select name="relationship_type">
							for _, t := range data.PersonRelationshipTypes {
								<option value={ t.Code }>{ t.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="primary">Relate people</button>
				</form>
			}
		}
		<h2>Positions</h2>
		if len(data.Positions) == 0 {
			if data.ImportableAssignmentCount > 0 {
				<p class="muted">Planning Center has no open positions left on this plan - everything's filled (see above).</p>
			} else {
				<p class="muted">Nothing needed yet - Planning Center has no open positions configured for this plan.</p>
			}
		}
		// hideTeamGroup/restoreHiddenTeamGroups (scheduling-build.js) populate
		// this with one chip per team hidden from this tab, each a "show it
		// again" button - see teamGroupCard's own doc comment for why
		// hiding is a client-only, per-browser thing with nothing server-
		// side backing it. Empty and hidden until JS has something to put
		// in it, so it never renders as a stray empty bar for someone who's
		// never hidden a team.
		<div id="hidden-teams-bar" class="hidden-teams-bar" hidden></div>
		// One card per team (see groupPositionsByTeam), laid out side by
		// side rather than stacked full-width - mirrors Planning Center's
		// own "My Teams" columns, and uses screen width better than a
		// single-column stack once a service has more than one or two
		// teams. Individual positions below are compact rows inside their
		// own team's card, not their own full cards (see
		// .team-groups-grid/.team-group/.position-group in card.css).
		<div class="team-groups-grid">
			for _, group := range groupPositionsByTeam(data.Positions) {
				@teamGroupCard(group) {
					for _, item := range group.Positions {
						@positionGroupCard(data.ServiceTypeID, data.PlanID, data.SchedulePreferenceOptions, item.Pos, data.ReadOnly)
					}
				}
			}
		</div>
		// See SetBuilderBodyContent's matching comment - the publish/discard
		// controls live in the sidebar now (RosterPublishPanel, build.templ);
		// RosterBuilderBody (not this, RosterBuilderBodyContent) is what
		// keeps that card's out-of-band copy in sync.
		if !data.ReadOnly && len(data.Suggestions) > 0 {
			@collapsibleSection("recommended-next-team", "Recommended next", false) {
				<p class="muted">Based on works-well-with and mentorship relationships with people already on this roster.</p>
				<ul class="suggestion-list">
					for _, sug := range data.Suggestions {
						@components.PersonListItem("", nil, sug.AvatarURL, sug.Name) {
							<span class="muted">{ sug.TeamPositionName } &middot; { sug.RelationshipLabel }</span>
							<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", data.ServiceTypeID, data.PlanID) } hx-target={ "#" + PositionGroupElementID(sug.TeamID, sug.TeamPositionName) } hx-swap="outerHTML">
								<input type="hidden" name="person_id" value={ sug.PersonID }/>
								<input type="hidden" name="team_id" value={ sug.TeamID }/>
								<input type="hidden" name="team_position_name" value={ sug.TeamPositionName }/>
								<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
									@components.IconAdd()
								</button>
							</form>
						}
					}
				</ul>
			}
		}
	</div>
}

// teamGroupCard is one team's whole card - collapsible and hideable, both
// purely client-side/per-browser (scheduling-collapsible.js/scheduling-build.js - toggleCollapse +
// localStorage for collapse state, the same mechanism every other
// .collapsible on the site already uses; hideTeamGroup + a separate
// localStorage list for hiding), not a new server-backed preference. A
// standing "how I like my own Team tab laid out" setting is personal
// screen tidiness, not scheduling data - it doesn't need to follow anyone
// to another device or be visible to teammates, so there's no migration/
// store method backing either behavior. Always renders open (collapsible,
// not collapsed by default the way a fully-staffed positionGroupCard is -
// a whole team disappearing by default would hide real "needs attention"
// positions inside it) and never hidden server-side - applyStoredHiddenTeamGroups
// (scheduling-build.js, run on DOMContentLoaded and after every htmx swap) is
// what actually hides a previously-hidden team's card again after this
// renders, the same "server always renders the default, JS reapplies
// whatever was last chosen" split collapsibleCard's own open param uses
// for collapse state.
//
// data-team-id/data-team-name carry what hideTeamGroup/restoreHiddenTeamGroups
// need (the id to remember and the name to show on its "show again" chip)
// without those functions having to parse rendered heading text.
templ teamGroupCard(group teamPositionGroup) {
	<div class="team-group collapsible open" id={ TeamGroupElementID(group.TeamID) } data-team-id={ group.TeamID } data-team-name={ group.TeamName }>
		<h3 class="team-group-heading">
			<button type="button" class="collapsible-toggle" onclick="toggleCollapse(this)" aria-expanded="true">
				<span>{ group.TeamName }</span>
				@components.IconChevronDown()
			</button>
			<button type="button" class="icon-btn" aria-label={ "Hide " + group.TeamName + " from this tab" } title="Hide this team's card from this tab" onclick="hideTeamGroup(this)">
				@components.IconX()
			</button>
		</h3>
		<div class="collapsible-body">
			{ children... }
		</div>
	</div>
}

// positionGroupCard is one position group's own card - the collapsibleCard
// (assigned list, candidate list, "+ Add eligible person" quick-add) every
// position on the Team tab renders. Factored out of
// RosterBuilderBodyContent's team-group loop so the exact same markup can
// also be the primary (non-OOB) response for a mutation scoped to just
// this one group (AddRosterAssignment, RemoveRosterAssignment,
// QuickAddPositionPreference - rosters_detail.go), targeted via
// PositionGroupElementID rather than a full #roster-builder-body
// re-render. serviceTypeID/planID/schedulePreferenceOptions are passed
// separately rather than folding this into RosterBuilderData, since a
// scoped mutation's own response only ever has one PositionGroupView on
// hand, not a full RosterBuilderData to pull them from. readOnly hides
// every mutating control (remove/add/quick-add-eligible-person) the same
// way RosterBuilderBodyContent's top-level ReadOnly gating does elsewhere
// on this page - a scoped mutation response only ever renders for a plan
// that's still open to editing (the forms that reach these handlers are
// themselves gated off on a read-only plan), but this stays defensive
// rather than assuming that holds.
templ positionGroupCard(serviceTypeID, planID string, schedulePreferenceOptions []SchedulePreferenceOption, pos PositionGroupView, readOnly bool) {
	// Fully-staffed positions are the low-signal case - collapsed by
	// default so an almost-done roster doesn't look as busy as a
	// mostly-empty one; still-open positions (the ones actually
	// needing a decision) stay expanded (see collapsibleCard).
	@collapsibleCard(PositionGroupElementID(pos.TeamID, pos.TeamPositionName), len(pos.Assigned) < pos.Quantity, positionHeading(pos)) {
		if len(pos.Assigned) > 0 {
			<ul class="assignment-list">
				for _, a := range pos.Assigned {
					@components.PersonListItem("", templ.Attributes{"data-row-id": fmt.Sprintf("%d", a.ID), "onclick": "selectPersonRow(this, event)"}, a.AvatarURL, a.Name) {
						@statusBadge(a.Status)
						if a.Published {
							@components.Badge("published", "Published")
						}
						if msgs := assignmentConflictWarnings(a); len(msgs) > 0 {
							@components.BadgeTitled("status-needed", conflictCountLabel(len(msgs)), strings.Join(msgs, "\n"))
						}
						if !readOnly {
							<button
								type="button"
								class="danger icon-btn"
								aria-label="Remove from position"
								title="Remove from position"
								hx-delete={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments/%d", serviceTypeID, planID, a.ID) }
								hx-target={ "#" + PositionGroupElementID(pos.TeamID, pos.TeamPositionName) }
								hx-swap="outerHTML"
								hx-confirm="Remove this person from this position?"
							>
								@components.IconRemove()
							</button>
						}
					}
				}
			</ul>
		}
		if !readOnly {
			if len(pos.Candidates) > 0 {
				<ul class="candidate-list">
					for _, cand := range pos.Candidates {
						// Clicking the row (like an assigned row -
						// selectPersonRow, scheduling-build.js) opens this
						// candidate's own sidebar detail card
						// (candidateDetailCard, person_detail_card.templ),
						// which holds the on-demand "Check for conflicts"
						// button and the warnings it fills in - kept off
						// this row itself so a fully-expanded card with
						// many candidates stays a quick scan of name +
						// preference + Add, the same shape an assigned
						// row keeps.
						@components.PersonListItem("candidate-row", templ.Attributes{"data-row-id": candidateCardElementID(pos.TeamID, pos.TeamPositionName, cand.PersonID), "onclick": "selectPersonRow(this, event)"}, cand.AvatarURL, cand.Name) {
							<span class="muted">{ cand.SchedulePreference }</span>
							<form hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments", serviceTypeID, planID) } hx-target={ "#" + PositionGroupElementID(pos.TeamID, pos.TeamPositionName) } hx-swap="outerHTML">
								<input type="hidden" name="person_id" value={ cand.PersonID }/>
								<input type="hidden" name="team_id" value={ pos.TeamID }/>
								<input type="hidden" name="team_position_name" value={ pos.TeamPositionName }/>
								<button type="submit" class="icon-btn" aria-label="Add to position" title="Add to position">
									@components.IconAdd()
								</button>
							</form>
						}
					}
				</ul>
			} else if len(pos.Assigned) == 0 {
				<p class="muted">No one eligible for this position yet.</p>
			}
		}
		// Ad hoc eligibility - the most directly-motivated quick-add on
		// this page (this text used to just dead-end to "add eligibility
		// under Position Preferences" and send the user away). Posts
		// straight at this position (team/position id already known from
		// the card), same underlying operation as
		// PositionPreferencesPage's own form - see
		// QuickAddPositionPreference in rosters_detail.go. Omitted when the
		// position's id lookup failed (best-effort, same as the rest of
		// this page - see PositionGroupView.TeamPositionID) rather than
		// posting to a blank id. team_position_name travels as its own
		// hidden field (not just team_position_id) so the handler can
		// re-resolve this exact group without an extra PCO round trip - see
		// QuickAddPositionPreference's own doc comment.
		if !readOnly && pos.TeamPositionID != "" {
			@collapsibleSection("quick-add-"+PositionGroupElementID(pos.TeamID, pos.TeamPositionName), "+ Add eligible person", false) {
				// "Eligible" was reported confusing on its own - clarified inline
				// (not a tooltip; nothing in this app renders one on a
				// collapsibleSection's own toggle) rather than renaming the
				// trigger label, and scoped explicitly to *this* position, since
				// the other reported confusion was mistaking this for a
				// general "add someone to the roster" action.
				<p class="muted">
					"Eligible" means Planning Center already has this person cleared to
					serve as { pos.TeamPositionName } - not that they're suggested or
					preferred, and not a way to add someone to the roster in general.
					This adds them to this one position only.
				</p>
				<form class="inline" hx-post={ fmt.Sprintf("/scheduling/build/%s/%s/position-preferences", serviceTypeID, planID) } hx-target={ "#" + PositionGroupElementID(pos.TeamID, pos.TeamPositionName) } hx-swap="outerHTML">
					<input type="hidden" name="team_id" value={ pos.TeamID }/>
					<input type="hidden" name="team_position_id" value={ pos.TeamPositionID }/>
					<input type="hidden" name="team_position_name" value={ pos.TeamPositionName }/>
					@PersonPickerField("Person", "person_id", "qapos-"+PositionGroupElementID(pos.TeamID, pos.TeamPositionName))
					<label>
						Schedule preference
						<select name="schedule_preference">
							for _, opt := range schedulePreferenceOptions {
								<option value={ opt.Value }>{ opt.Label }</option>
							}
						</select>
					</label>
					<button type="submit" class="primary">Add eligibility</button>
				</form>
			}
		}
	}
}

// RosterAssignmentAddedResponse is AddRosterAssignment's htmx response -
// the touched position group's own card (the primary, non-OOB swap
// target) plus the page's shared chrome (rosterTopOOB, the publish panel,
// the glance card) and the newly-assigned person's own sidebar detail
// card, all as out-of-band updates - see rosters_detail.go for why this
// is scoped to just the one group instead of the whole
// #roster-builder-body every mutation used to re-render. added is nil
// when the add itself failed (nothing new to insert a detail card for).
// candidateDetailGroupOOB refreshes this same group's own cluster of
// candidate cards - the person just added is no longer one of group's
// Candidates (see buildRosterPositionGroupData), so their now-stale
// candidate card (unreachable anyway, since its row is gone from the
// freshly-swapped candidate list above) is dropped along with it, without
// touching any other position's own candidate cards.
templ RosterAssignmentAddedResponse(serviceTypeID, planID string, group PositionGroupView, top RosterBuilderData, added *AssignmentView) {
	@positionGroupCard(serviceTypeID, planID, top.SchedulePreferenceOptions, group, top.ReadOnly)
	@rosterTopOOB(top)
	@rosterPublishPanelOOB(top)
	@rosterGlanceOOB(top)
	@candidateDetailGroupOOB(serviceTypeID, planID, group)
	if added != nil {
		@personDetailCardInsertOOB(top, *added)
	}
}

// RosterAssignmentRemovedResponse is RemoveRosterAssignment's htmx
// response - see RosterAssignmentAddedResponse's doc comment, which this
// mirrors, swapping the detail-card insert for a delete of the removed
// person's own card. candidateDetailGroupOOB here picks up the opposite
// change - the removed person re-entering group's Candidates (if still
// eligible), whose row now needs a real candidate card to open.
templ RosterAssignmentRemovedResponse(serviceTypeID, planID string, group PositionGroupView, top RosterBuilderData, removedAssignmentID int64) {
	@positionGroupCard(serviceTypeID, planID, top.SchedulePreferenceOptions, group, top.ReadOnly)
	@rosterTopOOB(top)
	@rosterPublishPanelOOB(top)
	@rosterGlanceOOB(top)
	@candidateDetailGroupOOB(serviceTypeID, planID, group)
	@personDetailCardRemoveOOB(removedAssignmentID)
}

// RosterPositionGroupMutationResponse is QuickAddPositionPreference's htmx
// response - same shape as the assignment responses above, minus any
// assigned-side detail-card change: setting a position preference doesn't
// add or remove anyone from the roster, only this one position's own
// candidate pool (a newly-eligible person becomes a new candidate row,
// each needing its own detail card to open into) - candidateDetailGroupOOB
// covers exactly that.
templ RosterPositionGroupMutationResponse(serviceTypeID, planID string, group PositionGroupView, top RosterBuilderData) {
	@positionGroupCard(serviceTypeID, planID, top.SchedulePreferenceOptions, group, top.ReadOnly)
	@rosterTopOOB(top)
	@rosterPublishPanelOOB(top)
	@rosterGlanceOOB(top)
	@candidateDetailGroupOOB(serviceTypeID, planID, group)
}

// personBadgesOOB is RefreshPersonData's (rosters_person_data_refresh.go)
// own OOB piece of its htmx response - re-renders just the refreshed
// assignment's badge set in place on its sidebar detail card
// (personDetailCard, person_detail_card.templ), matching by
// personBadgesElementID rather than replacing the whole card (see that
// id's own doc comment for why: the card shell always renders `hidden` by
// default, so an OOB replace of the whole card would silently re-hide
// whatever card the person clicking Refresh is actively looking at).
// refreshed's FrequencyWarning/BlockoutWarning/CrossTeamWarning reflect
// whatever buildRosterPositionGroupData just recomputed against the
// freshly-synced cache - see RefreshPersonData for how it's built.
templ personBadgesOOB(refreshed AssignmentView) {
	<div class="build-detail-badges" id={ personBadgesElementID(refreshed.ID) } hx-swap-oob="true">
		@personBadgeSpans(refreshed)
	</div>
}

// personRefreshStatusElementID is the stable HTML id for one assignment's
// own "Refresh availability data" confirmation line on its sidebar detail
// card (personDetailCard, person_detail_card.templ) - see
// personRefreshStatusOOB below for why this exists as its own element
// rather than folding into personBadgesOOB.
func personRefreshStatusElementID(assignmentID int64) string {
	return fmt.Sprintf("person-refresh-status-%d", assignmentID)
}

// personRefreshStatusOOB confirms a "Refresh availability data" click
// actually ran. personBadgesOOB above already shows whatever the refresh
// found, but a refresh that finds no new conflicts - the common case, since
// this button exists for the rare gap between the background sync and
// right-now, not because refreshes usually change anything - leaves
// personBadgesOOB's own output looking identical to before the click, which
// reads as the click having done nothing. This is the same "an all-clear
// result is still an answer" reasoning as CandidateWarningsFragment's own
// else branch above, just for an action whose result can be unchanged
// output rather than empty output.
templ personRefreshStatusOOB(assignmentID int64) {
	<span id={ personRefreshStatusElementID(assignmentID) } class="muted" hx-swap-oob="true">Refreshed.</span>
}

// RosterPersonDataRefreshResponse is RefreshPersonData's htmx response
// (rosters_person_data_refresh.go) - a director clicking "Refresh
// availability data" on one person's own sidebar detail card. Same primary
// swap target as RosterPositionGroupMutationResponse (the touched position
// group's own card, whose assigned-row badges already show the same
// Frequency/Blockout/CrossTeam warnings - see positionGroupCard), plus an
// OOB update to that same person's own sidebar card badges (personBadgesOOB
// above), since that card lives outside #build-detail-team's own
// mutation-response scope and wouldn't otherwise reflect the refresh
// immediately. No rosterPublishPanelOOB/rosterGlanceOOB here, unlike the
// group-only mutation above - this action never adds, removes, or
// publishes anything, only refreshes cached warning inputs, so neither
// fragment's own content could have changed.
templ RosterPersonDataRefreshResponse(serviceTypeID, planID string, group PositionGroupView, top RosterBuilderData, refreshed AssignmentView) {
	@positionGroupCard(serviceTypeID, planID, top.SchedulePreferenceOptions, group, top.ReadOnly)
	@rosterTopOOB(top)
	@personBadgesOOB(refreshed)
	@personRefreshStatusOOB(refreshed.ID)
}

// RosterTopMutationResponse is QuickAddPersonRelationship's htmx response -
// creating a relationship never touches any specific position's
// assignments or candidates, only the shared roster-top banners (existing-
// conflicts can gain/lose a pair, the import banner and pair-prompt can
// disappear) - see rosters_detail.go. rosterTop (not rosterTopOOB) here:
// this mutation's own forms target #roster-top directly as their primary
// swap, not as an out-of-band update alongside some other group's card.
templ RosterTopMutationResponse(top RosterBuilderData) {
	@rosterTop(top)
	@rosterPublishPanelOOB(top)
	@rosterGlanceOOB(top)
}

// CandidateWarningsFragment is CandidateWarnings' htmx response
// (rosters_candidate_warnings.go) - just the one candidate's own
// frequency/blockout/cross-team badges, swapped into that candidate row's
// own placeholder span (candidateWarningsElementID) via hx-swap="innerHTML"
// when a director clicks "Check for conflicts". Mirrors the exact badge
// pattern the assigned/candidate rows above already render - no wrapper
// element, since it swaps straight into a span the row already provides.
//
// The all-clear else branch matters as much as the badges themselves: this
// span starts genuinely empty (see candidateDetailCard, person_detail_card.
// templ), so a clean result - no warnings at all, the common case - would
// otherwise swap in nothing and leave the click looking like it did
// nothing. Confirming "found none" is the actual answer to "Check for
// conflicts", not a no-op.
templ CandidateWarningsFragment(view CandidatePersonView) {
	if view.FrequencyWarning != "" {
		@components.ConflictBadge(view.FrequencyWarning)
	}
	if view.BlockoutWarning != "" {
		@components.ConflictBadge(view.BlockoutWarning)
	}
	if view.CrossTeamWarning != "" {
		@components.ConflictBadge(view.CrossTeamWarning)
	}
	if view.FrequencyWarning == "" && view.BlockoutWarning == "" && view.CrossTeamWarning == "" {
		<span class="muted">No conflicts found.</span>
	}
	@personTagsLine(view.PCOPersonTags)
}
