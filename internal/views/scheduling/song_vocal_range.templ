package scheduling

import (
	"fmt"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

// SongVocalRanges is Phase 2 of docs/plans/in-progress/vocal-range-plan.md:
// a standalone song-level vocal range setup page, mirroring the Song Tags/
// Song Roles setup-page pattern (a song <select>, a small inline form, a
// SortableTableWrap of existing entries below it) - deliberately NOT on
// the Build page's song detail card, since a song's range is a fact about
// the song itself, reused across every plan it appears in, not a
// per-occurrence value (see that plan doc's own reasoning). The reference
// key is entered alongside the low/high notes so the range can be stored
// as a transposable interval (scheduling.ComputeVocalRangeOffsets) rather
// than a bare note pair that would be meaningless without knowing what key
// it was measured against.
//
// currentKeysBySong resolves a song id to its current cached PCO
// arrangement key (see SongVocalRangesTable's own doc comment) - threaded
// through from the controller (song_vocal_range.go's currentKeysBySong
// helper) so the table can show each range transposed into whatever key
// the song is actually in right now, not just the key it was measured
// against.
templ SongVocalRanges(personName, organizationName string, songs []pco.SongData, ranges []scheduling.SongVocalRange, songTitles, currentKeysBySong map[string]string, errMsg string) {
	@views.Layout("Song Vocal Range", personName, organizationName) {
		@songVocalRangeHelp()
		<h1>Song Vocal Range</h1>
		<p class="muted">Record each song's sung range - lowest and highest note, measured against the key you played it in - so the Build page can show its practical range transposed into whatever key the arrangement is actually in right now. Reused across every plan the song appears in, like Song Tags/Song Roles - not something to re-enter per plan.</p>
		<form
			id="song-vocal-range-form"
			class="inline"
			hx-post="/scheduling/song-vocal-range"
			hx-target="#song-vocal-ranges-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			<label>
				Song
				<select name="song_id" required>
					<option value="" selected disabled>Choose a song</option>
					for _, song := range songs {
						<option value={ song.ID }>{ song.Attributes.Title }</option>
					}
				</select>
			</label>
			<label>
				Measured in key
				<input type="text" name="reference_key" placeholder="e.g. G, Bb, F#m" list="key-options" required/>
			</label>
			@musicalKeyOptions()
			<!--
				Forces the two note fields (plus Save/Cancel) onto their own
				row rather than leaving the browser to wrap wherever it runs
				out of room - with a Song select, a Measured-in-key field, and
				two note-field-plus-play-button groups all fighting for space
				on one form.inline row, that produced a lopsided wrap (see
				.form-row-break's own doc comment, forms.css).
			-->
			<div class="form-row-break"></div>
			<div class="form-field-group">
				<label>
					Lowest note
					<input id="song-vocal-range-lowest-input" type="text" name="lowest_note" placeholder="e.g. G3" list="vocal-note-options" required/>
				</label>
				<button
					type="button"
					class="icon-btn"
					aria-label="Play lowest note"
					title="Play lowest note"
					onclick="playVocalNoteFromInput('song-vocal-range-lowest-input')"
				>
					@components.IconPlay()
				</button>
			</div>
			<div class="form-field-group">
				<label>
					Highest note
					<input id="song-vocal-range-highest-input" type="text" name="highest_note" placeholder="e.g. D5" list="vocal-note-options" required/>
				</label>
				<button
					type="button"
					class="icon-btn"
					aria-label="Play highest note"
					title="Play highest note"
					onclick="playVocalNoteFromInput('song-vocal-range-highest-input')"
				>
					@components.IconPlay()
				</button>
			</div>
			@vocalNoteOptions()
			<button type="submit" class="primary">Save</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@SongVocalRangesTable(ranges, songTitles, currentKeysBySong, errMsg)
	}
}

// songVocalRangeHelp is this page's Help-triggered dialog - see
// songRelationshipsHelp's own doc comment (relationships.templ) for the
// full reasoning shared by every setup-page help dialog (single step, no
// createTourController, .page-help-dialog for openPageHelp's dispatch, and
// the forward-only Next-link chain / setPageHelpForce mechanism). This is
// page 4 of that chain (... Song Tags -> here -> Song / Person
// Preferences -> ...).
templ songVocalRangeHelp() {
	<dialog id="song-vocal-range-help" class="tour-dialog page-help-dialog">
		<div class="tour-step">
			<h2>Song Vocal Range</h2>
			<p>
				Record each song's sung range, so Build can catch a range mismatch
				before it's discovered live in rehearsal.
			</p>
		</div>
		<p class="muted tour-footnote">Need this again later? Look for Help at the bottom of any page.</p>
		<div class="tour-actions">
			<a class="button" href="/scheduling/song-preferences" onclick="setPageHelpForce()">Next: Song / Person Preferences →</a>
			<button type="button" class="button primary" onclick="closeHelpDialog('song-vocal-range-help')">Got it</button>
		</div>
	</dialog>
}

// SongVocalRangesTable is both the initial-render fragment and the htmx
// swap target (id="song-vocal-ranges-table") - see SongTagsTable for why
// errMsg lives inside it rather than the page around it. songTitles
// resolves a range's raw PCO song id back to a display title (see
// songTitleMap in the scheduling controller); an id missing from the map
// falls back to showing the raw id. Each row's Edit button re-populates
// song-vocal-range-form (editRow, scheduling.js) via data-edit-fields
// (song_id - a plain <select>, editRow's generic field-fill handles it the
// same as a text input - plus reference_key and the as-measured notes) -
// no hidden "id" field needed, same reasoning as PersonVocalRangesTable: a
// resubmit for the same song upserts in place
// (scheduling.SetSongVocalRange's ON CONFLICT clause), so re-populating
// and resubmitting genuinely is the same request an edit would make. Only
// rendered when the as-measured pair parses (measured.OK) - a stored
// range's own reference_key always parsed once already at write time, so
// this is just a defensive guard, never expected to actually skip in
// practice.
//
// currentKeysBySong resolves a range's song id to its current cached PCO
// arrangement key (song_vocal_range.go's currentKeysBySong helper - a
// cache-only, enqueue-on-miss read, never a live blocking PCO call). A
// song missing from this map (never cached, or PCO has no key set) shows
// only the "as measured" line in the Range column below - the established
// "best-effort, quiet skip" convention this codebase already uses
// elsewhere (e.g. keyTransitionWarnings' unparseable-key skip).
templ SongVocalRangesTable(ranges []scheduling.SongVocalRange, songTitles, currentKeysBySong map[string]string, errMsg string) {
	<div id="song-vocal-ranges-table">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@components.SortableTableWrap() {
			<thead>
					<tr>
						<th>Song</th>
						<th>Measured in key</th>
						<th>Range</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range ranges {
						{{ measured := computeVocalRangeNotePair(r.ReferenceKey, r.LowOffsetSemitones, r.HighOffsetSemitones, r.ReferenceKey) }}
						<tr>
							<td>
								if title, ok := songTitles[r.SongID]; ok {
									{ title }
								} else {
									{ r.SongID }
								}
							</td>
							<td>{ r.ReferenceKey }</td>
							<td>
								@vocalRangeLine("As measured", r.ReferenceKey, measured)
								{{ currentKey, hasCurrentKey := currentKeysBySong[r.SongID] }}
								if hasCurrentKey && currentKey != "" && currentKey != r.ReferenceKey {
									{{ transposed := computeVocalRangeNotePair(r.ReferenceKey, r.LowOffsetSemitones, r.HighOffsetSemitones, currentKey) }}
									if transposed.OK {
										@vocalRangeLine("Current key", currentKey, transposed)
									}
								}
								if measured.OK {
									@vocalRangePreviewControls(r)
								}
							</td>
							<td>
								if measured.OK {
									<button
										class="icon-btn"
										aria-label="Edit vocal range"
										title="Edit vocal range"
										data-edit-form="song-vocal-range-form"
										data-edit-fields={ editFieldsAttr(map[string]string{
											"song_id":       r.SongID,
											"reference_key": r.ReferenceKey,
											"lowest_note":   formatVocalNoteDisplay(measured.LowPitchClass, measured.LowOctave),
											"highest_note":  formatVocalNoteDisplay(measured.HighPitchClass, measured.HighOctave),
										}) }
										onclick="editRow(this)"
									>
										@components.IconEdit()
									</button>
								}
								<button
									class="danger icon-btn"
									aria-label="Delete vocal range"
									title="Delete vocal range"
									hx-delete={ fmt.Sprintf("/scheduling/song-vocal-range/%d", r.ID) }
									hx-target="#song-vocal-ranges-table"
									hx-swap="outerHTML"
									hx-confirm="Delete this vocal range?"
								>
									@components.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(ranges) == 0 {
						<tr>
							<td colspan="4" class="muted">No song vocal ranges set yet - record one so Build can catch a range mismatch before it's discovered live in rehearsal.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}

// vocalRangeNotePair is one transposed song vocal range's low/high notes,
// already split into playable pitch-class/octave ints (for a play
// button's templ.JSFuncCall) alongside the OK flag EffectiveVocalRange
// itself returns - computeVocalRangeNotePair's return shape, so a caller
// needing both the ints and a display string (formatVocalNoteDisplay)
// only has to run EffectiveVocalRange/PitchClassAndOctave once per line,
// not once per displayed note.
type vocalRangeNotePair struct {
	LowPitchClass, LowOctave   int
	HighPitchClass, HighOctave int
	OK                         bool
}

// computeVocalRangeNotePair transposes a stored song vocal range
// (referenceKey + offsets, see scheduling.ComputeVocalRangeOffsets) into
// targetKey and splits the result into playable pitch-class/octave pairs.
// Passing targetKey == referenceKey (as SongVocalRangesTable's "as
// measured" line does) reconstructs the range as it was actually measured
// - no transposition, since the delta ends up 0. OK is false if either
// key string fails to parse (scheduling.EffectiveVocalRange) - the
// caller's job to skip rendering in that case, matching this codebase's
// established "best-effort, quiet skip" convention (e.g.
// keyTransitionWarnings' unparseable-key skip).
func computeVocalRangeNotePair(referenceKey string, lowOffset, highOffset int, targetKey string) vocalRangeNotePair {
	lowAbs, highAbs, ok := scheduling.EffectiveVocalRange(referenceKey, lowOffset, highOffset, targetKey)
	if !ok {
		return vocalRangeNotePair{}
	}
	lowPC, lowOct := scheduling.PitchClassAndOctave(lowAbs)
	highPC, highOct := scheduling.PitchClassAndOctave(highAbs)
	return vocalRangeNotePair{
		LowPitchClass: lowPC, LowOctave: lowOct,
		HighPitchClass: highPC, HighOctave: highOct,
		OK: true,
	}
}

// vocalRangeLine renders one labeled line of a song vocal range's Range
// column - "As measured (in D): E3 [play] - B4 [play]" or "Current key
// (G): F3 [play] - C5 [play]" - each note with its own tap-to-hear button
// (playVocalTone, web/static/js/scheduling.js), so the two lines
// (as-measured vs. transposed-into-current-key) are never ambiguous about
// which is which. Callers only render this when pair.OK is true (see
// SongVocalRangesTable) - no "?" placeholder here, matching this
// codebase's quiet-skip convention rather than showing a broken line.
templ vocalRangeLine(label, key string, pair vocalRangeNotePair) {
	<div class="vocal-range-line">
		<span class="muted">{ label } ({ key }):</span>
		{ formatVocalNoteDisplay(pair.LowPitchClass, pair.LowOctave) }
		<button
			type="button"
			class="icon-btn"
			aria-label={ fmt.Sprintf("Play %s lowest note", label) }
			title={ fmt.Sprintf("Play %s lowest note", label) }
			onclick={ templ.JSFuncCall("playVocalTone", pair.LowPitchClass, pair.LowOctave) }
		>
			@components.IconPlay()
		</button>
		-
		{ formatVocalNoteDisplay(pair.HighPitchClass, pair.HighOctave) }
		<button
			type="button"
			class="icon-btn"
			aria-label={ fmt.Sprintf("Play %s highest note", label) }
			title={ fmt.Sprintf("Play %s highest note", label) }
			onclick={ templ.JSFuncCall("playVocalTone", pair.HighPitchClass, pair.HighOctave) }
		>
			@components.IconPlay()
		</button>
	</div>
}

// vocalRangePreviewControls is a per-row, preview-only control (docs/
// issues.md: "change the relative key of an existing range to hear what
// the modulated range would be... bring it down an octave... male/
// female") - deliberately separate from vocalRangeLine's "As measured"/
// "Current key" lines above it: those reflect what's actually stored,
// this never does. Picking a key here or clicking the octave buttons
// never writes anything back to r's row - it only changes what plays and
// what the preview line below shows.
//
// The transposition math runs entirely client-side
// (renderVocalRangePreview, scheduling.js) rather than round-tripping
// through htmx on every keystroke/click - the data-* attributes below are
// exactly r's own stored reference_key/low_offset/high_offset, the same
// inputs scheduling.EffectiveVocalRange takes server-side, so the JS
// mirrors that function's arithmetic (see that section's own doc comment
// in scheduling.js for why duplicating it is safe here) rather than
// re-deriving new math. The key input reuses musicalKeyOptions' shared
// "key-options" datalist (rendered once, in SongVocalRanges' entry form)
// rather than a per-row copy - a <datalist> can back any number of
// inputs via list="key-options".
templ vocalRangePreviewControls(r scheduling.SongVocalRange) {
	<div
		class="vocal-range-preview"
		data-reference-key={ r.ReferenceKey }
		data-low-offset={ fmt.Sprintf("%d", r.LowOffsetSemitones) }
		data-high-offset={ fmt.Sprintf("%d", r.HighOffsetSemitones) }
		data-octave-shift="0"
	>
		<div class="vocal-range-preview-controls">
			<input
				type="text"
				class="vocal-range-preview-key-input"
				placeholder={ "Preview in " + r.ReferenceKey }
				list="key-options"
				aria-label="Preview in a different key"
				oninput="renderVocalRangePreview(this)"
			/>
			<button
				type="button"
				aria-label="Preview an octave lower"
				title="Preview an octave lower"
				onclick="shiftVocalRangePreviewOctave(this, -1)"
			>
				8ve ↓
			</button>
			<span class="vocal-range-preview-shift muted"></span>
			<button
				type="button"
				aria-label="Preview an octave higher"
				title="Preview an octave higher"
				onclick="shiftVocalRangePreviewOctave(this, 1)"
			>
				8ve ↑
			</button>
		</div>
		<div class="vocal-range-preview-line muted" hidden></div>
	</div>
}
