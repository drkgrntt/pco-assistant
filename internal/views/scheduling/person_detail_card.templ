package scheduling

import (
	"fmt"

	"pco-assistant/internal/views/components"
)

// PersonDetailCards is every assigned person's own detail card, plus every
// still-open position's own cluster of candidate detail cards
// (candidateDetailGroup below), stacked in the Build page's sidebar (see
// build.templ) right below the Team publish card - the people equivalent
// of SongDetailCards, which this mirrors in full (including the OOB/
// non-OOB split and the "one card visible at a time" idiom - see
// personDetailCard/candidateDetailCard below and selectPersonRow,
// scheduling.js, which both row types share).
templ PersonDetailCards(data RosterBuilderData, hidden bool) {
	@buildDetailGroupShell("build-detail-team", hidden) {
		for _, pos := range data.Positions {
			for _, a := range pos.Assigned {
				@personDetailCard(data, a)
			}
			@candidateDetailGroup(data.ServiceTypeID, data.PlanID, pos)
		}
	}
}

templ personDetailCardsOOB(data RosterBuilderData) {
	@buildDetailGroupShellOOB("build-detail-team", false) {
		for _, pos := range data.Positions {
			for _, a := range pos.Assigned {
				@personDetailCard(data, a)
			}
			@candidateDetailGroup(data.ServiceTypeID, data.PlanID, pos)
		}
	}
}

// personDetailCardsLazyOOB is songDetailCardsLazyOOB's people equivalent -
// see its doc comment, which this mirrors in full.
templ personDetailCardsLazyOOB(data RosterBuilderData) {
	@buildDetailGroupShellOOB("build-detail-team", true) {
		for _, pos := range data.Positions {
			for _, a := range pos.Assigned {
				@personDetailCard(data, a)
			}
			@candidateDetailGroup(data.ServiceTypeID, data.PlanID, pos)
		}
	}
}

// personDetailCardInsertOOB appends one newly-assigned person's detail card
// into the sidebar's existing #build-detail-team group via htmx's
// "beforeend" out-of-band insert - the narrow-mutation counterpart to
// personDetailCardsOOB's full-group replace (see rosters_detail.go's
// per-group handlers, which use this after AddRosterAssignment instead of
// recomputing every other already-assigned person's card just to add one
// more). #build-detail-team already exists in the DOM from the page's own
// initial render (PersonDetailCards/personDetailCardsOOB), so this never
// needs to render that shell itself - only the one new card, which starts
// hidden like every other (selectPersonRow, scheduling.js, reveals it on
// click), exactly as if it had been there since the last full render.
templ personDetailCardInsertOOB(data RosterBuilderData, a AssignmentView) {
	<div hx-swap-oob="beforeend:#build-detail-team">
		@personDetailCard(data, a)
	</div>
}

// personDetailCardRemoveOOB deletes one assignment's detail card from the
// sidebar - the narrow-mutation counterpart for a removal (see
// RemoveRosterAssignment, rosters_detail.go). personDetailCard's own root
// element (buildDetailCardShell) carries no id, only data-row-id - so
// unlike a plain "delete" OOB (which matches by an element's own id), this
// targets an explicit CSS selector instead; the div's own content and
// (lack of) id are otherwise irrelevant, since a "delete" swap never uses
// either.
templ personDetailCardRemoveOOB(assignmentID int64) {
	<div hx-swap-oob={ fmt.Sprintf("delete:[data-row-id='%d']", assignmentID) }></div>
}

// personDetailCard is one assigned person's detail card - hidden until
// selectPersonRow (scheduling.js) reveals it, in response to clicking that
// person's own row in a position's assignment list (roster_builder.templ).
// Notes is read-only here (see AssignmentView.Notes) - there's no editing
// UI for it yet, only display, same as ArrangementInfo/Notes on the song
// card's arrangement side.
templ personDetailCard(data RosterBuilderData, a AssignmentView) {
	@buildDetailCardShell(fmt.Sprintf("%d", a.ID), a.Name, "closePersonDetail()") {
		<p class="muted">{ a.TeamName } / { a.TeamPositionName }</p>
		<div class="build-detail-badges" id={ personBadgesElementID(a.ID) }>
			@personBadgeSpans(a)
		</div>
		if a.Notes != "" {
			<p class="build-detail-notes">{ a.Notes }</p>
		}
		if !data.ReadOnly {
			<div class="build-detail-actions">
				<button
					type="button"
					class="danger"
					hx-delete={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments/%d", data.ServiceTypeID, data.PlanID, a.ID) }
					hx-target={ "#" + PositionGroupElementID(a.TeamID, a.TeamPositionName) }
					hx-swap="outerHTML"
					hx-confirm="Remove this person from this position?"
				>
					@components.IconRemove()
					Remove from position
				</button>
				<button
					type="button"
					title="Re-fetch this person's blockouts and serving history from Planning Center right now, instead of waiting for the paced background sync"
					hx-post={ fmt.Sprintf("/scheduling/rosters/%s/%s/assignments/%d/refresh-data", data.ServiceTypeID, data.PlanID, a.ID) }
					hx-target={ "#" + PositionGroupElementID(a.TeamID, a.TeamPositionName) }
					hx-swap="outerHTML"
				>
					Refresh availability data
				</button>
				<span id={ personRefreshStatusElementID(a.ID) } class="muted"></span>
			</div>
		}
	}
}

// candidateDetailCard is one not-yet-assigned candidate's own detail card -
// hidden until selectPersonRow (scheduling.js, shared with the assigned-
// row side above) reveals it, in response to clicking that candidate's own
// row in a position's candidate list (positionGroupCard, roster_builder.
// templ). The row itself only shows name/schedule preference/Add - this
// card holds the on-demand conflict check ("Check for conflicts" and the
// warning badges it fills in), the candidate equivalent of personDetailCard's
// own card-only "Refresh availability data" above: neither is safe to
// compute for every row on the page without an explicit click (see
// candidateWarningsElementID's own doc comment, and pco-api-risks.md's
// cold-start addendum), so both stay behind an explicit open + click
// instead of running passively.
templ candidateDetailCard(serviceTypeID, planID string, pos PositionGroupView, cand CandidatePersonView) {
	@buildDetailCardShell(candidateCardElementID(pos.TeamID, pos.TeamPositionName, cand.PersonID), cand.Name, "closePersonDetail()") {
		<p class="muted">{ pos.TeamPositionName } &middot; { cand.SchedulePreference }</p>
		<span id={ candidateWarningsElementID(pos.TeamID, pos.TeamPositionName, cand.PersonID) } class="candidate-warnings"></span>
		<div class="build-detail-actions">
			<button
				type="button"
				aria-label="Check for scheduling conflicts"
				title="See whether adding this person would conflict with their serving-frequency preference, a blockout date they've marked in Planning Center, or another commitment they already have this same week"
				hx-get={ candidateWarningsURL(serviceTypeID, planID, pos.TeamID, pos.TeamPositionName, cand.PersonID, cand.SchedulePreference) }
				hx-target={ "#" + candidateWarningsElementID(pos.TeamID, pos.TeamPositionName, cand.PersonID) }
				hx-swap="innerHTML"
			>
				Check for conflicts
			</button>
		</div>
	}
}

// candidateDetailGroup is one position group's own cluster of candidate
// detail cards (candidateDetailCard above), addressable as a whole via
// candidateGroupElementID - see that id's own doc comment for why a
// position-scoped mutation refreshes this instead of the whole sidebar's
// worth of candidate cards. Rendered even when Candidates is empty (the
// wrapper div still needs to exist in the initial page render for that
// same OOB target to find later).
templ candidateDetailGroup(serviceTypeID, planID string, pos PositionGroupView) {
	<div id={ candidateGroupElementID(pos.TeamID, pos.TeamPositionName) }>
		for _, cand := range pos.Candidates {
			@candidateDetailCard(serviceTypeID, planID, pos, cand)
		}
	</div>
}

// candidateDetailGroupOOB is candidateDetailGroup's out-of-band sibling -
// see RosterAssignmentAddedResponse/RosterAssignmentRemovedResponse/
// RosterPositionGroupMutationResponse (roster_builder.templ), each of
// which already has this one position's freshly-recomputed Candidates in
// hand (the same group value their own primary positionGroupCard swap
// renders from) and passes it straight through here to keep this
// position's candidate cards in sync with its candidate-list rows, without
// touching any other position's own cards.
templ candidateDetailGroupOOB(serviceTypeID, planID string, pos PositionGroupView) {
	<div id={ candidateGroupElementID(pos.TeamID, pos.TeamPositionName) } hx-swap-oob="true">
		for _, cand := range pos.Candidates {
			@candidateDetailCard(serviceTypeID, planID, pos, cand)
		}
	</div>
}

// personBadgesElementID is the stable HTML id for one assignment's own
// badges block on its sidebar detail card (personDetailCard above) - the
// OOB target RefreshPersonData's response (roster_builder.templ) swaps in
// place after a manual refresh, without touching the rest of the card (in
// particular, never re-rendering buildDetailCardShell's own root element,
// which always renders `hidden` by default - see selectPersonRow in
// scheduling.js. Swapping that whole shell via OOB would silently re-hide
// whatever card the person clicking Refresh is actively looking at).
func personBadgesElementID(assignmentID int64) string {
	return fmt.Sprintf("person-badges-%d", assignmentID)
}

// personBadgeSpans is the assignment-status/warning badge set shown on the
// sidebar detail card (personDetailCard) - split out so
// RefreshPersonData's own OOB update (personBadgesOOB, roster_builder.templ)
// can re-render exactly this content after a manual cache refresh, without
// duplicating the badge list in two places.
templ personBadgeSpans(a AssignmentView) {
	@statusBadge(a.Status)
	if a.Published {
		@components.Badge("published", "Published")
	}
	if a.FrequencyWarning != "" {
		@components.ConflictBadge(a.FrequencyWarning)
	}
	if a.BlockoutWarning != "" {
		@components.ConflictBadge(a.BlockoutWarning)
	}
	if a.CrossTeamWarning != "" {
		@components.ConflictBadge(a.CrossTeamWarning)
	}
	if a.FrequencyWarning == "" && a.BlockoutWarning == "" && a.CrossTeamWarning == "" {
		<span class="muted">No known conflicts.</span>
	}
}
