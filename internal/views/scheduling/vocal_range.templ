package scheduling

import (
	"fmt"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
	"pco-assistant/internal/views/components"
)

templ PersonVocalRanges(personName, organizationName string, ranges []scheduling.PersonVocalRange, personNames map[string]string, errMsg string) {
	@views.Layout("Vocal Range", personName, organizationName) {
		@vocalRangeHelp()
		<h1>Vocal Range</h1>
		<p class="muted">Record each vocalist's comfortable range - lowest and highest note they can sing - so "can they hit this note" is answered from a lookup instead of guessed at in rehearsal. Search for the person by name and enter their notes with the octave (e.g. "G3", "C#4", "Bb2").</p>
		<form
			id="vocal-range-form"
			class="inline"
			hx-post="/scheduling/vocal-range"
			hx-target="#vocal-ranges-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			@PersonPickerField("Person", "person_id", "")
			<div class="form-field-group">
				<label>
					Lowest note
					<input id="vocal-lowest-note-input" type="text" name="lowest_note" placeholder="e.g. G3" list="vocal-note-options" required/>
				</label>
				<button
					type="button"
					class="icon-btn"
					aria-label="Play lowest note"
					title="Play lowest note"
					onclick="playVocalNoteFromInput('vocal-lowest-note-input')"
				>
					@components.IconPlay()
				</button>
			</div>
			<div class="form-field-group">
				<label>
					Highest note
					<input id="vocal-highest-note-input" type="text" name="highest_note" placeholder="e.g. D5" list="vocal-note-options" required/>
				</label>
				<button
					type="button"
					class="icon-btn"
					aria-label="Play highest note"
					title="Play highest note"
					onclick="playVocalNoteFromInput('vocal-highest-note-input')"
				>
					@components.IconPlay()
				</button>
			</div>
			@vocalNoteOptions()
			<button type="submit" class="primary">Save</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@PersonVocalRangesTable(ranges, personNames, errMsg)
	}
}

// vocalRangeHelp is this page's Help-triggered dialog - see
// songRelationshipsHelp's own doc comment (relationships.templ) for the
// full reasoning shared by every setup-page help dialog (single step, no
// createTourController, .page-help-dialog for openPageHelp's dispatch).
templ vocalRangeHelp() {
	<dialog id="vocal-range-help" class="tour-dialog page-help-dialog">
		<div class="tour-step">
			<h2>Vocal Range</h2>
			<p>
				Record each vocalist's comfortable range, so "can they hit this
				note" is a lookup instead of a guess in rehearsal.
			</p>
		</div>
		<div class="tour-actions">
			<button type="button" class="button primary" onclick="closeHelpDialog('vocal-range-help')">Got it</button>
		</div>
	</dialog>
}

// PersonVocalRangesTable is both the initial-render fragment and the htmx
// swap target (id="vocal-ranges-table") - see PreferencesTable for why
// errMsg lives inside it rather than the page around it. personNames
// resolves a range's raw PCO person id back to a display name (see
// personNameMapForIDs in the scheduling controller); an id missing from
// the map falls back to showing the raw id. Each row's Edit button
// re-populates vocal-range-form (editRow, scheduling.js) via
// data-edit-fields (the two notes) and data-edit-people (the person
// picker, suffix "" - see PersonPickerField/editPeopleAttr) - no hidden
// "id" field needed, since a resubmit for the same person upserts in
// place (scheduling.SetPersonVocalRange's ON CONFLICT clause), so
// re-populating and resubmitting is genuinely the same request an edit
// would make.
templ PersonVocalRangesTable(ranges []scheduling.PersonVocalRange, personNames map[string]string, errMsg string) {
	<div id="vocal-ranges-table">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@components.SortableTableWrap() {
			<thead>
					<tr>
						<th>Person</th>
						<th>Lowest note</th>
						<th>Highest note</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range ranges {
						<tr>
							<td>
								if name, ok := personNames[r.PersonID]; ok {
									{ name }
								} else {
									{ r.PersonID }
								}
							</td>
							<td>
								{ formatVocalNoteDisplay(r.LowestPitchClass, r.LowestOctave) }
								<button
									type="button"
									class="icon-btn"
									aria-label="Play lowest note"
									title="Play lowest note"
									onclick={ templ.JSFuncCall("playVocalTone", r.LowestPitchClass, r.LowestOctave) }
								>
									@components.IconPlay()
								</button>
							</td>
							<td>
								{ formatVocalNoteDisplay(r.HighestPitchClass, r.HighestOctave) }
								<button
									type="button"
									class="icon-btn"
									aria-label="Play highest note"
									title="Play highest note"
									onclick={ templ.JSFuncCall("playVocalTone", r.HighestPitchClass, r.HighestOctave) }
								>
									@components.IconPlay()
								</button>
							</td>
							<td>
								<button
									class="icon-btn"
									aria-label="Edit vocal range"
									title="Edit vocal range"
									data-edit-form="vocal-range-form"
									data-edit-fields={ editFieldsAttr(map[string]string{
										"lowest_note":  formatVocalNoteDisplay(r.LowestPitchClass, r.LowestOctave),
										"highest_note": formatVocalNoteDisplay(r.HighestPitchClass, r.HighestOctave),
									}) }
									data-edit-people={ editPeopleAttr(map[string]editPerson{
										"": {ID: r.PersonID, Name: displayNameOrID(personNames, r.PersonID)},
									}) }
									onclick="editRow(this)"
								>
									@components.IconEdit()
								</button>
								<button
									class="danger icon-btn"
									aria-label="Delete vocal range"
									title="Delete vocal range"
									hx-delete={ fmt.Sprintf("/scheduling/vocal-range/%d", r.ID) }
									hx-target="#vocal-ranges-table"
									hx-swap="outerHTML"
									hx-confirm="Delete this vocal range?"
								>
									@components.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(ranges) == 0 {
						<tr>
							<td colspan="4" class="muted">No vocal ranges set yet - record one so "can they hit this note" is a quick lookup instead of a guess in rehearsal.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}

// vocalNoteDisplayNames is pitch class -> display name, sharp spelling
// only - a stored range has one canonical display form, unlike
// musicalKeyOptions' datalist below which offers both sharp and flat
// spellings as separate pickable options. Kept local to this package
// rather than shared with the controller's own parsing helpers
// (internal/server/controllers/vocal_range.go's vocalNoteNames) since a
// views package importing a controllers package would be a backwards
// dependency - see CLAUDE.md's Architecture section on views/controllers
// layering. This is display formatting only, not parsing, so the small
// duplication is the correct-shaped seam, not a real DRY violation.
var vocalNoteDisplayNames = [12]string{"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"}

// formatVocalNoteDisplay renders a stored pitch class/octave pair back
// into display text (e.g. pitch class 4, octave 4 -> "E4").
func formatVocalNoteDisplay(pitchClass, octave int) string {
	return fmt.Sprintf("%s%d", vocalNoteDisplayNames[((pitchClass%12)+12)%12], octave)
}

// vocalNoteOptionNames mirrors musicalKeyOptions' chromatic list (both
// sharp and flat spellings for the five notes that have one), reused here
// per octave rather than per key - see vocalNoteOptions.
var vocalNoteOptionNames = []string{
	"C", "C#", "Db", "D", "D#", "Eb", "E", "F", "F#", "Gb", "G", "G#", "Ab", "A", "A#", "Bb", "B",
}

// vocalNoteOctaves spans a reasonable vocal register (low bass around E2 to
// high soprano around C6) as datalist suggestions - the underlying input
// stays free text (see musicalKeyOptions' own doc comment on why a
// datalist, not a strict <select>), so nothing outside this span is
// rejected.
var vocalNoteOctaves = []int{2, 3, 4, 5}

// vocalNoteOptions is the shared <datalist> of note+octave combinations
// backing PersonVocalRanges' lowest/highest note inputs.
templ vocalNoteOptions() {
	<datalist id="vocal-note-options">
		for _, octave := range vocalNoteOctaves {
			for _, note := range vocalNoteOptionNames {
				<option value={ fmt.Sprintf("%s%d", note, octave) }></option>
			}
		}
	</datalist>
}
