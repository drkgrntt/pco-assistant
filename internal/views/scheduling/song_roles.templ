package scheduling

import (
	"fmt"
	"strconv"

	pco "github.com/drkgrntt/go-pco"

	"pco-assistant/internal/scheduling"
	"pco-assistant/internal/views"
)

templ SongRoles(personName, organizationName string, songs []pco.SongData, roles []scheduling.SongRole, roleTypes []scheduling.SongRoleType, songTitles map[string]string, roleLabels map[string]string, errMsg string) {
	@views.Layout("Song Roles", personName, organizationName) {
		<h1>Song Roles</h1>
		<p class="muted">Tag songs as good openers or good response songs, for use when building a set.</p>
		<form
			id="song-role-form"
			class="inline"
			hx-post="/scheduling/song-roles"
			hx-target="#song-roles-table"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful && event.detail.elt === this) resetSetupForm(this)"
		>
			<input type="hidden" name="id"/>
			<label>
				Song
				<select name="song_id" required>
					<option value="" selected disabled>Choose a song</option>
					for _, song := range songs {
						<option value={ song.ID }>{ song.Attributes.Title }</option>
					}
				</select>
			</label>
			<label>
				Role
				<select name="role">
					for _, t := range roleTypes {
						<option value={ t.Code }>{ t.Label }</option>
					}
				</select>
			</label>
			<button type="submit" class="primary">Add</button>
			<button type="button" class="cancel-edit" onclick="cancelSetupEdit(this)" hidden>Cancel</button>
		</form>
		@SongRolesTable(roles, songTitles, roleLabels, errMsg)
	}
}

// SongRolesTable is both the initial-render fragment and the htmx swap
// target (id="song-roles-table") - see RelationshipsTable for why errMsg
// lives inside it rather than the page around it. roleLabels resolves role
// codes to their song_role_types label (see songRoleTypeLabelMap in the
// scheduling controller) - a code removed from that table since the tag
// was created falls back to showing the raw code.
templ SongRolesTable(roles []scheduling.SongRole, songTitles map[string]string, roleLabels map[string]string, errMsg string) {
	<div id="song-roles-table">
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		@views.SortableTableWrap() {
			<thead>
					<tr>
						<th>Song</th>
						<th>Role</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, role := range roles {
						<tr>
							<td>
								if title, ok := songTitles[role.SongID]; ok {
									{ title }
								} else {
									{ role.SongID }
								}
							</td>
							<td>{ displayNameOrID(roleLabels, role.Role) }</td>
							<td>
								<button
									class="icon-btn"
									aria-label="Edit tag"
									title="Edit tag"
									data-edit-form="song-role-form"
									data-edit-fields={ editFieldsAttr(map[string]string{
										"id":      strconv.FormatInt(role.ID, 10),
										"song_id": role.SongID,
										"role":    role.Role,
									}) }
									onclick="editRow(this)"
								>
									@views.IconEdit()
								</button>
								<button
									class="danger icon-btn"
									aria-label="Remove tag"
									title="Remove tag"
									hx-delete={ fmt.Sprintf("/scheduling/song-roles/%d", role.ID) }
									hx-target="#song-roles-table"
									hx-swap="outerHTML"
									hx-confirm="Remove this tag?"
								>
									@views.IconRemove()
								</button>
							</td>
						</tr>
					}
					if len(roles) == 0 {
						<tr>
							<td colspan="3" class="muted">No songs tagged yet.</td>
						</tr>
					}
				</tbody>
		}
	</div>
}
